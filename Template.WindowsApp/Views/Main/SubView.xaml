<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:local="clr-namespace:Template.WindowsApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Main.SubView"
             s:DataContextResolver.Type="{x:Type local:SubViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type local:SubViewModel}}"
             d:DesignWidth="800" d:DesignHeight="450">

    <StackPanel Margin="16">
        <TextBlock FontSize="24"
                   Text="Sub" />
        <TextBlock Margin="0,16,0,0"
                   FontSize="16"
                   Text="{Binding Result}" />
        <StackPanel Margin="0,16,0,0"
                    Orientation="Horizontal">
            <Button Width="128"
                    Command="{Binding ConfirmCommand}"
                    Content="Confirm" />
            <Button Width="128"
                    Margin="8,0,0,0"
                    Command="{Binding InputCommand}"
                    Content="Input" />
            <Button Width="128"
                    Margin="8,0,0,0"
                    Command="{Binding BackCommand}"
                    Content="Back" />
        </StackPanel>
    </StackPanel>

</UserControl>
