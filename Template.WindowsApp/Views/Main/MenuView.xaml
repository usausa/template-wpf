<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:local="clr-namespace:Template.WindowsApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Main.MenuView"
             s:DataContextResolver.Type="{x:Type local:MenuViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type local:MenuViewModel}}"
             d:DesignWidth="800" d:DesignHeight="450">

    <StackPanel Margin="16">
        <TextBlock FontSize="24"
                   Text="{Binding Message}" />
        <Button Width="128"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Command="{Binding NavigateCommand}"
                Content="Navigate" />
    </StackPanel>

</UserControl>
