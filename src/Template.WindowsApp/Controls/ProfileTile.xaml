<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Controls.ProfileTile"
             x:Name="Root"
             d:DesignWidth="240" d:DesignHeight="40">

    <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding Glyph, ElementName=Root}"
                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                       FontSize="20"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <StackPanel Margin="12,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}"
                       Text="{Binding DisplayName, ElementName=Root}" />
            <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="{Binding Role, ElementName=Root}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>

</UserControl>
