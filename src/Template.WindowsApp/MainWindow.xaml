<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:navigation="http://smart/navigation"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:application="clr-namespace:Template.WindowsApp"
                    xmlns:shell="clr-namespace:Template.WindowsApp.Shell"
                    xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:converters="clr-namespace:Template.WindowsApp.Converters"
                    xmlns:components="clr-namespace:Template.WindowsApp.Components"
                    xmlns:dialogs="clr-namespace:Template.WindowsApp.Views.Dialogs"
                    xmlns:forms="clr-namespace:Template.WindowsApp.Views.Forms"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.MainWindow"
                    s:DataContextResolver.Type="{x:Type application:MainWindowViewModel}"
                    d:DataContext="{d:DesignInstance Type={x:Type application:MainWindowViewModel}}"
                    Width="1280" Height="960" MinWidth="1024" MinHeight="768"
                    Title="Template"
                    Icon="App.ico"
                    OverlayContent="{Binding Dialogs.Current}"
                    ShowIconOnTitleBar="False">

    <controls:AppWindow.Resources>
        <converters:CountBadgeImageConverter x:Key="CountBadgeImageConverter" />

        <DataTemplate DataType="{x:Type dialogs:MessageDialogViewModel}">
            <dialogs:MessageDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogs:InputDialogViewModel}">
            <dialogs:InputDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogs:ProgressDialogViewModel}">
            <dialogs:ProgressDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type forms:BulkChangeDialogViewModel}">
            <forms:BulkChangeDialogView />
        </DataTemplate>

        <Style x:Key="SideBarBadgeStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CountBadgeBorder}"
               d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationNode}}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideBarGroupBadgeStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CountBadgeBorder}"
               d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationGroup}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}"
                             Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideBarIconBadgeStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource SmallCountBadgeBorder}"
               d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationNode}}">
            <Setter Property="Margin" Value="18,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BellBadgeStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource SmallCountBadgeBorder}"
               d:DataContext="{d:DesignInstance Type={x:Type application:MainWindowViewModel}}">
            <Setter Property="Margin" Value="0,-7,-11,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notifications.UnreadCount}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlyoutTextButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NotificationHistoryTemplate"
                      DataType="{x:Type components:Notification}">
            <Grid Margin="16,0,16,0">
                <Border Height="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          Margin="0,2,0,0"
                          VerticalAlignment="Top">
                        <TextBlock x:Name="IconBackground"
                                   Text="&#xF136;"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                        <TextBlock x:Name="IconGlyph"
                                   Text="&#xF13F;"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0">
                        <Grid>
                            <TextBlock Margin="0,0,48,0"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Title}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Time, StringFormat=HH:mm}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Message}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}"
                             Value="Success">
                    <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}"
                             Value="Warning">
                    <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13C;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}"
                             Value="Error">
                    <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13D;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SideBarButtonStyle"
               TargetType="{x:Type Button}"
               d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationNode}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Badge, StringFormat='{}{0} unread'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationItem}}"
                              Background="{TemplateBinding Background}">
                            <Border Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:EmojiIcon Grid.Column="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Glyph="{Binding Emoji}"
                                                    FontSize="16" />
                                <Border Grid.Column="0"
                                        Style="{StaticResource SideBarIconBadgeStyle}">
                                    <TextBlock Style="{StaticResource SmallCountBadgeTextBlock}"
                                               Text="{Binding Badge}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="{Binding Title}"
                                           FontSize="14" />
                                <Border Grid.Column="2"
                                        Style="{StaticResource SideBarBadgeStyle}">
                                    <TextBlock Style="{StaticResource CountBadgeTextBlock}"
                                               Text="{Binding Badge}" />
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}"
                             Value="0">
                    <Setter Property="AutomationProperties.HelpText" Value="" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideBarChildButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SideBarButtonStyle}">
            <Setter Property="Padding" Value="39,0,0,0" />
        </Style>

        <Style x:Key="SideBarGroupButtonStyle"
               TargetType="{x:Type Button}"
               d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationNode}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Badge, StringFormat='{}{0} unread'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}"
                             Value="0">
                    <Setter Property="AutomationProperties.HelpText" Value="" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommandBoxStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0.15" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        Opacity="0.7">
                                <TextBlock VerticalAlignment="Center"
                                           Text="&#xE721;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="12" />
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Selection"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Indicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:AppWindow.Resources>

    <controls:AppWindow.InputBindings>
        <KeyBinding Command="{Binding OpenPaletteCommand}"
                    Gesture="Ctrl+Shift+P" />
        <KeyBinding Command="{Binding GoBackCommand}"
                    Gesture="Alt+Left" />
        <KeyBinding Command="{Binding GoForwardCommand}"
                    Gesture="Alt+Right" />
        <KeyBinding Key="Escape"
                    Command="{Binding CloseNotificationsCommand}" />
    </controls:AppWindow.InputBindings>

    <controls:AppWindow.TaskbarItemInfo>
        <TaskbarItemInfo Overlay="{Binding Notifications.UnreadCount, Converter={StaticResource CountBadgeImageConverter}}"
                         ProgressState="{Binding Taskbar.State}"
                         ProgressValue="{Binding Taskbar.Value}" />
    </controls:AppWindow.TaskbarItemInfo>

    <i:Interaction.Behaviors>
        <behaviors:MouseBackForwardBehavior BackCommand="{Binding GoBackCommand}"
                                            ForwardCommand="{Binding GoForwardCommand}" />
    </i:Interaction.Behaviors>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <s:CancelEventAction Cancel="{Binding BusyState.IsBusy}" />
            <i:CallMethodAction IsEnabled="{Binding BusyState.IsBusy, Converter={StaticResource ReverseConverter}}"
                                MethodName="Save"
                                TargetObject="{Binding WindowManager}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <controls:AppWindow.LeftHeader>
        <ToggleButton Style="{StaticResource TitleBarButton}"
                      Width="48"
                      IsChecked="{Binding WindowManager.IsPaneOpen}"
                      Content="&#xE700;"
                      FontFamily="{DynamicResource SymbolThemeFontFamily}"
                      FontSize="16"
                      AutomationProperties.Name="Navigation" />
    </controls:AppWindow.LeftHeader>

    <controls:AppWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource TitleBarButton}"
                    Width="40"
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="14"
                    ToolTip="Back (Alt+Left)"
                    AutomationProperties.Name="Back" />
            <Button Style="{StaticResource TitleBarButton}"
                    Width="40"
                    Margin="0,0,8,0"
                    Command="{Binding GoForwardCommand}"
                    Content="&#xE72A;"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="14"
                    ToolTip="Forward (Alt+Right)"
                    AutomationProperties.Name="Forward" />
            <Button Style="{StaticResource CommandBoxStyle}"
                    Width="400" Height="32"
                    Command="{Binding OpenPaletteCommand}"
                    Content="Search commands (Ctrl+Shift+P)"
                    FontSize="12" />
            <ToggleButton Width="40"
                          Margin="8,0,0,0"
                          IsEnabled="{Binding CanFavorite}"
                          IsChecked="{Binding IsFavorite}"
                          FontFamily="{DynamicResource SymbolThemeFontFamily}"
                          FontSize="14"
                          AutomationProperties.Name="Favorite">
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}"
                           BasedOn="{StaticResource TitleBarButton}">
                        <Setter Property="Content" Value="&#xE734;" />
                        <Setter Property="ToolTip" Value="Add to favorites" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="&#xE735;" />
                                <Setter Property="ToolTip" Value="Remove from favorites" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </StackPanel>
    </controls:AppWindow.TitleBarContent>

    <controls:AppWindow.RightHeader>
        <ToggleButton x:Name="NotificationsButton"
                      Style="{StaticResource TitleBarButton}"
                      Width="48"
                      IsChecked="{Binding IsNotificationsOpen}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=NotificationsPopup, Converter={StaticResource ReverseConverter}}"
                      ToolTip="Notifications"
                      AutomationProperties.Name="Notifications">
            <Grid>
                <TextBlock Text="&#xEA8F;"
                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="16" />
                <Border Style="{StaticResource BellBadgeStyle}">
                    <TextBlock Style="{StaticResource SmallCountBadgeTextBlock}"
                               Text="{Binding Notifications.UnreadCount}" />
                </Border>
            </Grid>
        </ToggleButton>
    </controls:AppWindow.RightHeader>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="48" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowManager.IsPaneOpen}"
                                     Value="True">
                            <Setter Property="Width" Value="200" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Resources>
                <DataTemplate DataType="{x:Type shell:NavigationItem}">
                    <Button Style="{StaticResource SideBarButtonStyle}"
                            Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="{Binding Title}"
                            AutomationProperties.Name="{Binding Title}"
                            ToolTipService.IsEnabled="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ReverseConverter}}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:NavigationGroup}">
                    <StackPanel>
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChildSelected}" Value="True" />
                                                    <Condition Binding="{Binding IsExpanded}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChildSelected}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Border Width="3" Height="16"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <Button Style="{StaticResource SideBarGroupButtonStyle}"
                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}"
                                    ToolTipService.IsEnabled="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ReverseConverter}}">
                                <Grid Margin="8,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <controls:EmojiIcon Grid.Column="0"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Glyph="{Binding Emoji}"
                                                        FontSize="16" />
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SideBarIconBadgeStyle}">
                                        <TextBlock Style="{StaticResource SmallCountBadgeTextBlock}"
                                                   Text="{Binding Badge}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}"
                                               FontSize="14" />
                                    <Border Grid.Column="1"
                                            Style="{StaticResource SideBarGroupBadgeStyle}">
                                        <TextBlock Style="{StaticResource CountBadgeTextBlock}"
                                                   Text="{Binding Badge}" />
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="&#xE70D;"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="8"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}"
                                                                 Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}"
                                      Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="{x:Type ItemsControl}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                    <Button Style="{StaticResource SideBarChildButtonStyle}"
                                            Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding Id}"
                                            AutomationProperties.Name="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </Border.Resources>
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Menu.HeaderItems}"
                                      Focusable="False" />
                        <ContentControl Focusable="False"
                                        Content="{Binding Menu.Favorites}">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Menu.Favorites.Items.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <ItemsControl ItemsSource="{Binding Menu.Items}"
                                      Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Menu.FooterItems}"
                              Focusable="False" />
            </Grid>
        </Border>

        <Canvas Grid.Column="1"
                navigation:NavigationContainer.Navigator="{Binding Navigator}"
                ClipToBounds="True" />

        <ProgressBar Grid.Column="0" Grid.ColumnSpan="2"
                     VerticalAlignment="Bottom"
                     IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="{x:Type ProgressBar}"
                       BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding BusyState.IsBusy}" Value="True" />
                                <Condition Binding="{Binding IsNavigating}" Value="False" />
                                <Condition Binding="{Binding Dialogs.Current}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <ItemsControl Grid.Column="1"
                      Width="360"
                      Margin="24"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      ItemsSource="{Binding Notifications.Items}"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type components:Notification}">
                    <Border Margin="0,8,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <controls:InfoBar Title="{Binding Title}"
                                          Message="{Binding Message}"
                                          Severity="{Binding Severity}"
                                          CloseButtonCommand="{Binding DataContext.CloseNotificationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          CloseButtonCommandParameter="{Binding}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Popup x:Name="NotificationsPopup"
               Grid.Column="0"
               IsOpen="{Binding IsNotificationsOpen}"
               AllowsTransparency="True" HorizontalOffset="-312" Placement="Bottom"
               PlacementTarget="{Binding ElementName=NotificationsButton}"
               StaysOpen="False" VerticalOffset="4">
            <Border Width="360"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="16,10,8,8">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Notifications"
                                   FontSize="14" FontWeight="SemiBold" />
                        <Button Style="{StaticResource FlyoutTextButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding ClearNotificationsCommand}"
                                Content="Clear all" />
                    </Grid>
                    <ScrollViewer MaxHeight="420"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Focusable="False">
                        <ItemsControl Margin="0,0,0,4"
                                      ItemsSource="{Binding Notifications.History}"
                                      ItemTemplate="{StaticResource NotificationHistoryTemplate}"
                                      Focusable="False"
                                      AutomationProperties.Name="Notification history" />
                    </ScrollViewer>
                    <Grid Margin="16,0,16,0">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.History.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Margin="0,12,0,16"
                                   Text="No notifications"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <FrameworkElement x:Name="PaletteAnchor"
                          Grid.Column="0" Grid.ColumnSpan="2"
                          Width="600"
                          HorizontalAlignment="Center" VerticalAlignment="Top" />

        <Popup Grid.Column="0"
               IsOpen="{Binding Palette.IsOpen}"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=PaletteAnchor}"
               StaysOpen="False" VerticalOffset="-40">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Opened">
                    <s:SetFocusAction TargetObject="{Binding ElementName=CommandText}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Border Width="600"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="CommandText"
                             Height="32"
                             behaviors:TextBoxOption.PlaceholderText="Type to search"
                             Text="{Binding Palette.Text, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Command text">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Up"
                                        Command="{Binding MovePaletteCommand}"
                                        CommandParameter="{x:Static shell:CommandPaletteMove.Previous}" />
                            <KeyBinding Key="Down"
                                        Command="{Binding MovePaletteCommand}"
                                        CommandParameter="{x:Static shell:CommandPaletteMove.Next}" />
                            <KeyBinding Key="PageUp"
                                        Command="{Binding MovePaletteCommand}"
                                        CommandParameter="{x:Static shell:CommandPaletteMove.PreviousPage}" />
                            <KeyBinding Key="PageDown"
                                        Command="{Binding MovePaletteCommand}"
                                        CommandParameter="{x:Static shell:CommandPaletteMove.NextPage}" />
                            <KeyBinding Key="Enter"
                                        Command="{Binding ExecutePaletteCommand}" />
                            <KeyBinding Key="Escape"
                                        Command="{Binding ClosePaletteCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <ListBox MaxHeight="360"
                             Padding="0"
                             ItemsSource="{Binding Palette.Candidates}"
                             Focusable="False"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CommandItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedIndex="{Binding Palette.SelectedIndex}">
                        <i:Interaction.Behaviors>
                            <behaviors:ScrollIntoSelectedItemBehavior />
                        </i:Interaction.Behaviors>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type shell:CommandCandidate}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonUp">
                                            <i:InvokeCommandAction Command="{Binding DataContext.ExecutePaletteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Command.Icon}"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="16" />
                                    <TextBlock Grid.Column="1"
                                               behaviors:TextBlockOption.Runs="{Binding TitleRuns}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Command.Category}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="12,8,12,8"
                               Text="No matching commands"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Palette.Candidates.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>

</controls:AppWindow>
