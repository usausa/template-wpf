<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Settings"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Settings.AboutSettings"
             d:DataContext="{d:DesignInstance Type={x:Type module:SettingsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <!-- Content -->
    <StackPanel Style="{StaticResource SettingsSectionStack}">

        <!-- Header -->
        <TextBlock Style="{StaticResource SettingsSectionTitleTextBlock}"
                   Text="About" />

        <!-- Version -->
        <controls:SettingsCard Header="{Binding ApplicationName}"
                               Description="{Binding VersionText}"
                               HeaderIcon="&#xE946;"
                               Keywords="Version">
            <Button Command="{Binding CopyVersionCommand}"
                    Content="Copy"
                    AutomationProperties.Name="Copy version info" />
        </controls:SettingsCard>

        <!-- Logs -->
        <controls:SettingsCard Header="Logs"
                               Description="Messages that the app has written while running"
                               HeaderIcon="&#xE9A4;"
                               Keywords="Troubleshooting">
            <TextBlock>
                <Hyperlink Command="{Binding OpenLogsCommand}">View logs</Hyperlink>
            </TextBlock>
        </controls:SettingsCard>

    </StackPanel>

</UserControl>
