<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Settings"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Settings.SettingsView"
             s:DataContextResolver.Type="{x:Type module:SettingsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:SettingsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Pane -->

        <Style x:Key="SettingsPaneGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="24,24,16,24" />
        </Style>

        <Style x:Key="SettingsPageListBox"
               TargetType="{x:Type ListBox}"
               BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="SettingsPageListBoxItem"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Selection"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Indicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPageIconTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="SettingsPageTitleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Sections -->

        <Style x:Key="SettingsSectionsGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="8,24,24,24" />
        </Style>

        <Style x:Key="SettingsNoResultsTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F"
                    Command="{Binding FindCommand}"
                    Modifiers="Control" />
    </UserControl.InputBindings>

    <!-- Content -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pane -->
        <Grid Grid.Column="0"
              Style="{StaticResource SettingsPaneGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource PageTitleTextBlock}"
                       Text="Settings" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Change how the app looks and behaves." />

            <!-- Search -->
            <TextBox Grid.Row="2"
                     behaviors:TextBoxOption.PlaceholderText="Search settings (Ctrl+F)"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     AutomationProperties.Name="Search settings">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape"
                                Command="{Binding ClearSearchCommand}" />
                </TextBox.InputBindings>
                <i:Interaction.Triggers>
                    <s:EventRequestTrigger Request="{Binding FindRequest}">
                        <s:SetFocusAction />
                        <s:SelectAllTextAction />
                    </s:EventRequestTrigger>
                </i:Interaction.Triggers>
            </TextBox>

            <!-- Pages -->
            <ListBox Grid.Row="4"
                     Style="{StaticResource SettingsPageListBox}"
                     AutomationProperties.Name="Settings pages"
                     ItemContainerStyle="{StaticResource SettingsPageListBoxItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectedValue="{Binding SelectedPage}"
                     SelectedValuePath="Tag">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel LastChildFill="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem DockPanel.Dock="Top"
                             AutomationProperties.Name="General"
                             Tag="{x:Static module:SettingsPage.General}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsPageIconTextBlock}"
                                   Text="&#xE713;" />
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlock}"
                                   Text="General" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem DockPanel.Dock="Top"
                             AutomationProperties.Name="Appearance"
                             Tag="{x:Static module:SettingsPage.Appearance}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsPageIconTextBlock}"
                                   Text="&#xE790;" />
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlock}"
                                   Text="Appearance" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem DockPanel.Dock="Top"
                             AutomationProperties.Name="Notifications"
                             Tag="{x:Static module:SettingsPage.Notifications}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsPageIconTextBlock}"
                                   Text="&#xEA8F;" />
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlock}"
                                   Text="Notifications" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem DockPanel.Dock="Top"
                             AutomationProperties.Name="Privacy"
                             Tag="{x:Static module:SettingsPage.Privacy}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsPageIconTextBlock}"
                                   Text="&#xE72E;" />
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlock}"
                                   Text="Privacy" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem DockPanel.Dock="Bottom"
                             AutomationProperties.Name="About"
                             Tag="{x:Static module:SettingsPage.About}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsPageIconTextBlock}"
                                   Text="&#xE946;" />
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlock}"
                                   Text="About" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

        </Grid>

        <!-- Sections -->
        <ScrollViewer Grid.Column="1"
                      Style="{StaticResource PaneScroll}">
            <Grid Style="{StaticResource SettingsSectionsGrid}">
                <controls:SettingsPanel x:Name="Pages"
                                        Query="{Binding SearchText}"
                                        SelectedPage="{Binding SelectedPage}">
                    <module:GeneralSettings controls:SettingsPanel.Page="{x:Static module:SettingsPage.General}" />
                    <module:AppearanceSettings controls:SettingsPanel.Page="{x:Static module:SettingsPage.Appearance}" />
                    <module:NotificationSettings controls:SettingsPanel.Page="{x:Static module:SettingsPage.Notifications}" />
                    <module:PrivacySettings controls:SettingsPanel.Page="{x:Static module:SettingsPage.Privacy}" />
                    <module:AboutSettings controls:SettingsPanel.Page="{x:Static module:SettingsPage.About}" />
                </controls:SettingsPanel>
                <Grid Visibility="{Binding HasNoResults, ElementName=Pages, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Style="{StaticResource PageSubtitleTextBlock}"
                               Text="No results" />
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource SettingsNoResultsTextBlock}"
                               Text="Try different words, or clear the search to see all settings." />
                </Grid>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
