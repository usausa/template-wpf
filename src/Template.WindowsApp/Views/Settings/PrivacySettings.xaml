<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Settings"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Settings.PrivacySettings"
             d:DataContext="{d:DesignInstance Type={x:Type module:SettingsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <StackPanel Margin="0,0,0,16">
        <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,16"
                   Text="Privacy" />
        <controls:SettingsCard Description="Recently and frequently used commands are listed first in the command palette" Header="Recent commands" HeaderIcon="&#xE81C;">
            <Button Command="{Binding ClearRecentCommand}"
                    Content="Clear"
                    AutomationProperties.Name="Clear recent commands" />
        </controls:SettingsCard>
        <controls:SettingsCard Description="Recently opened pages are listed in the jump list" Header="Recent pages" HeaderIcon="&#xE823;">
            <Button Command="{Binding ClearRecentPagesCommand}"
                    Content="Clear"
                    AutomationProperties.Name="Clear recent pages" />
        </controls:SettingsCard>
    </StackPanel>

</UserControl>
