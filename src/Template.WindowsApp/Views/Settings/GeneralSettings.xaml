<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:settings="clr-namespace:Template.WindowsApp.Settings"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Settings"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Settings.GeneralSettings"
             d:DataContext="{d:DesignInstance Type={x:Type module:SettingsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <Style x:Key="GeneralSettingsComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="200" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <StackPanel Style="{StaticResource SettingsSectionStack}">

        <!-- Header -->
        <TextBlock Style="{StaticResource SettingsSectionTitleTextBlock}"
                   Text="General" />

        <!-- Navigation pane -->
        <controls:SettingsCard Header="Navigation pane"
                               Description="Show the pane with labels"
                               HeaderIcon="&#xE700;">
            <controls:ToggleSwitch IsChecked="{Binding WindowManager.IsPaneOpen}"
                                   AutomationProperties.Name="Navigation pane" />
        </controls:SettingsCard>

        <!-- Start page -->
        <controls:SettingsCard Header="Start page"
                               Description="Page to show when the app starts"
                               HeaderIcon="&#xE80F;">
            <ComboBox Style="{StaticResource GeneralSettingsComboBox}"
                      AutomationProperties.Name="Start page"
                      SelectedValue="{Binding WindowManager.StartPage}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Home"
                              Tag="{x:Static settings:StartPage.Home}" />
                <ComboBoxItem Content="Last opened page"
                              Tag="{x:Static settings:StartPage.LastPage}" />
            </ComboBox>
        </controls:SettingsCard>

    </StackPanel>

</UserControl>
