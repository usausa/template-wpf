<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Graphics"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Graphics.ChartsView"
             s:DataContextResolver.Type="{x:Type module:ChartsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ChartsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <x:Array x:Key="ShareFills"
                 Type="{x:Type Brush}">
            <StaticResource ResourceKey="ChartBlueSemiDarkBrush" />
            <StaticResource ResourceKey="ChartBlueBrush" />
            <StaticResource ResourceKey="ChartBlueLightBrush" />
            <StaticResource ResourceKey="ChartBlueSuperLightBrush" />
        </x:Array>
        <Style x:Key="LegendSwatchStyle"
               TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="8,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource BodyTextBlockFontSize}" />
        </Style>
        <Style x:Key="LegendValueTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource BodyTextBlockFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource RootScroll}">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource PageTitleTextBlock}"
                           Text="Charts" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource PageDescriptionTextBlock}"
                           Text="Line, bar and donut charts drawn in code." />

                <Button Grid.Row="2"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Command="{Binding RandomizeCommand}"
                        Content="Randomize" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource CardTitleTextBlock}"
                                       Text="Line" />
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Monthly values over a year." />
                            <controls:LineChart Grid.Row="2"
                                                MinHeight="160"
                                                Margin="0,16,0,0"
                                                Fill="{StaticResource ChartBlueSuperLightBrush}"
                                                Stroke="{StaticResource ChartBlueBrush}"
                                                GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                Labels="{Binding MonthLabels}"
                                                Values="{Binding MonthValues}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource CardTitleTextBlock}"
                                       Text="Bar" />
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Values by category." />
                            <controls:BarChart Grid.Row="2"
                                               MinHeight="160"
                                               Margin="0,16,0,0"
                                               Fill="{StaticResource ChartBlueBrush}"
                                               LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                               Labels="{Binding CategoryLabels}"
                                               Values="{Binding CategoryValues}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource CardTitleTextBlock}"
                                       Text="Donut" />
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Shares of the total, with a legend." />
                            <Grid Grid.Row="2"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:DonutChart Grid.Column="0"
                                                     MinHeight="160"
                                                     Fills="{StaticResource ShareFills}"
                                                     Values="{Binding ShareValues}" />
                                <Grid Grid.Column="1"
                                      Margin="24,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <Rectangle Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource LegendSwatchStyle}"
                                               Fill="{StaticResource ChartBlueSemiDarkBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource LegendTextStyle}"
                                               Text="{Binding ShareLabels[0]}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Style="{StaticResource LegendValueTextStyle}"
                                               Text="{Binding ShareRatios[0], StringFormat={}{0:P0}}" />

                                    <Rectangle Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource LegendSwatchStyle}"
                                               Fill="{StaticResource ChartBlueBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource LegendTextStyle}"
                                               Text="{Binding ShareLabels[1]}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource LegendValueTextStyle}"
                                               Text="{Binding ShareRatios[1], StringFormat={}{0:P0}}" />

                                    <Rectangle Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource LegendSwatchStyle}"
                                               Fill="{StaticResource ChartBlueLightBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource LegendTextStyle}"
                                               Text="{Binding ShareLabels[2]}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               Style="{StaticResource LegendValueTextStyle}"
                                               Text="{Binding ShareRatios[2], StringFormat={}{0:P0}}" />

                                    <Rectangle Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource LegendSwatchStyle}"
                                               Fill="{StaticResource ChartBlueSuperLightBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Style="{StaticResource LegendTextStyle}"
                                               Text="{Binding ShareLabels[3]}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               Style="{StaticResource LegendValueTextStyle}"
                                               Text="{Binding ShareRatios[3], StringFormat={}{0:P0}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
