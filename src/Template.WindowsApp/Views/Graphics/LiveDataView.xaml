<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Graphics"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Graphics.LiveDataView"
             s:DataContextResolver.Type="{x:Type module:LiveDataViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:LiveDataViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Options -->

        <Style x:Key="LiveDataOptionGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LiveDataLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LiveDataRateComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="96" />
        </Style>

        <Style x:Key="LiveDataToggleSwitch"
               TargetType="{x:Type controls:ToggleSwitch}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LiveDataCountTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="LiveDataPauseButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="96" />
        </Style>

        <!-- Sensors -->

        <Style x:Key="LiveDataSensorItemsControl"
               TargetType="{x:Type ItemsControl}"
               BasedOn="{StaticResource {x:Type ItemsControl}}">
            <Setter Property="Margin" Value="0,0,-8,0" />
        </Style>

        <Style x:Key="LiveDataSensorBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="LiveDataLiveTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="LiveDataStaleBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </Style>

        <Style x:Key="LiveDataStaleIconTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>

        <Style x:Key="LiveDataStaleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="LiveDataUnitTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="LiveDataMovementGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="LiveDataCaretTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="LiveDataDeltaTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="LiveDataLineChart"
               TargetType="{x:Type controls:LineChart}">
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Fill" Value="{StaticResource ChartBlueSuperLightBrush}" />
            <Setter Property="Stroke" Value="{StaticResource ChartBlueBrush}" />
            <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Style="{StaticResource PageTitleTextBlock}"
                           Text="Live data" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource PageDescriptionTextBlock}"
                           Text="Values that keep streaming in, drawn at a limited rate, with streams that stop marked." />

                <!-- Options -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"
                              Style="{StaticResource LiveDataOptionGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LiveDataLabelTextBlock}"
                                       Text="Updates per second" />
                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource LiveDataRateComboBox}"
                                      ItemsSource="{Binding Rates}"
                                      SelectedItem="{Binding SelectedRate}"
                                      AutomationProperties.Name="Updates per second" ItemStringFormat="N0" />
                        </Grid>
                        <Grid Grid.Column="2"
                              Style="{StaticResource LiveDataOptionGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LiveDataLabelTextBlock}"
                                       Text="Draw 4 times per second" />
                            <controls:ToggleSwitch Grid.Column="2"
                                                   Style="{StaticResource LiveDataToggleSwitch}"
                                                   IsChecked="{Binding IsLimited}"
                                                   AutomationProperties.Name="Draw 4 times per second" />
                        </Grid>
                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource LiveDataCountTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Received {0:N0} · Drawn {1:N0}">
                                    <Binding Path="ReceivedCount" />
                                    <Binding Path="DrawnCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Grid Grid.Column="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource LiveDataPauseButton}"
                                    Command="{Binding PauseCommand}"
                                    Content="{Binding IsPaused, Converter={s:BoolToText True=Resume, False=Pause}}" />
                            <Button Grid.Column="2"
                                    Command="{Binding DropCommand}"
                                    Content="Stop Humidity for 5 s" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sensors -->
                <ItemsControl Grid.Row="4"
                              Style="{StaticResource LiveDataSensorItemsControl}"
                              ItemsSource="{Binding Sensors}"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type sample:LiveSensor}">
                            <Border Style="{StaticResource LiveDataSensorBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource CardStrongTextBlock}"
                                                   Text="{Binding Name}" />
                                        <TextBlock x:Name="LiveText"
                                                   Grid.Column="1"
                                                   Style="{StaticResource LiveDataLiveTextBlock}"
                                                   Text="Live" />
                                        <Border x:Name="StaleBadge"
                                                Grid.Column="1"
                                                Style="{StaticResource LiveDataStaleBorder}"
                                                Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource LiveDataStaleIconTextBlock}"
                                                           Text="&#xE7BA;" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource LiveDataStaleTextBlock}"
                                                           Text="No data for 3 s" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Reading"
                                                   Grid.Column="0"
                                                   Style="{StaticResource MetricValueTextBlock}"
                                                   Text="{Binding ValueText}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource LiveDataUnitTextBlock}"
                                                   Text="{Binding Unit}" />
                                        <Grid x:Name="Movement"
                                              Grid.Column="3"
                                              Style="{StaticResource LiveDataMovementGrid}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Caret"
                                                       Grid.Column="0"
                                                       Style="{StaticResource LiveDataCaretTextBlock}"
                                                       Text="&#xF08E;" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource LiveDataDeltaTextBlock}"
                                                       Text="{Binding DeltaText}" />
                                        </Grid>
                                    </Grid>
                                    <controls:LineChart Grid.Row="4"
                                                        Style="{StaticResource LiveDataLineChart}"
                                                        Minimum="{Binding Minimum}"
                                                        Maximum="{Binding Maximum}"
                                                        Capacity="{x:Static sample:LiveSensor.Capacity}"
                                                        Values="{Binding Values}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRising}"
                                             Value="True">
                                    <Setter TargetName="Caret" Property="Text" Value="&#xF090;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DeltaText}"
                                             Value="">
                                    <Setter TargetName="Movement" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStale}"
                                             Value="True">
                                    <Setter TargetName="LiveText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="StaleBadge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Reading" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    <Setter TargetName="Movement" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
