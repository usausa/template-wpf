<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:views="clr-namespace:Template.WindowsApp.Views"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.ValidationView"
             s:DataContextResolver.Type="{x:Type module:ValidationViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ValidationViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <s:BoolToVisibilityConverter x:Key="ErrorVisibilityConverter"
                                     TrueValue="Visible"
                                     FalseValue="Collapsed" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource RootScroll}">
        <AdornerDecorator>
            <StackPanel Style="{StaticResource PageStack}">
                <i:Interaction.Triggers>
                    <s:EventRequestTrigger Request="{Binding FocusRequest}">
                        <s:ValidationErrorFocusAction />
                    </s:EventRequestTrigger>
                </i:Interaction.Triggers>

                <TextBlock Style="{StaticResource PageTitleTextBlock}"
                           Text="Validation" />
                <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                           Text="Validation timing, manual errors, focus, comparisons, rules and a form." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Validate on lost focus" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Validates when the field loses focus." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                           Text="Text1" />
                                <TextBox Width="320"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Text1, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Text1">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="GotFocus">
                                            <s:CallMethodAction MethodName="ClearErrors" MethodParameter="Text1"
                                                                TargetObject="{Binding Errors}" />
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="LostFocus">
                                            <s:CallMethodAction MethodName="Validate" MethodParameter="Text1"
                                                                TargetObject="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                           Visibility="{Binding Errors[Text1], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                           Text="{Binding Errors[Text1]}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Manual validation" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Adds and clears an error from code." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                           Text="Text2" />
                                <TextBox Width="320"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Text2" />
                                <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                           Visibility="{Binding Errors[Text2], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                           Text="{Binding Errors[Text2]}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,16,0,0">
                                    <Button Command="{Binding ErrorCommand}"
                                            Content="Error" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding ClearCommand}"
                                            Content="Clear" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Focus request" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Moves focus to the first field with an error." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <Button Command="{Binding FocusCommand}"
                                        Content="Focus" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Correlation (compare)" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Checks that two fields match." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Email" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Email" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Confirm email" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding ConfirmEmail, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Confirm email" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[ConfirmEmail], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[ConfirmEmail]}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Validation rules" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Checks the input in the binding." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Email" />
                                    <TextBox x:Name="RuleEmailInput"
                                             Width="320"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.Name="Email">
                                        <TextBox.Text>
                                            <Binding Path="RuleEmail"
                                                     UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <views:EmailValidationRule ErrorMessage="Invalid email format" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <s:EventRequestTrigger Request="{Binding ClearRulesRequest}">
                                                <i:CallMethodAction MethodName="Clear" />
                                            </s:EventRequestTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding (Validation.HasError), ElementName=RuleEmailInput, Converter={StaticResource ErrorVisibilityConverter}}"
                                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=RuleEmailInput}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Quantity" />
                                    <TextBox x:Name="QuantityInput"
                                             Width="320"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.Name="Quantity">
                                        <TextBox.Text>
                                            <Binding Path="Quantity"
                                                     UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <views:RangeValidationRule Minimum="1" Maximum="100"
                                                                               ErrorMessage="Must be from 1 to 100" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <s:EventRequestTrigger Request="{Binding ClearRulesRequest}">
                                                <i:CallMethodAction MethodName="Clear" />
                                            </s:EventRequestTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding (Validation.HasError), ElementName=QuantityInput, Converter={StaticResource ErrorVisibilityConverter}}"
                                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=QuantityInput}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Form" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Submit is enabled when every field is valid." />
                            <StackPanel Style="{StaticResource SampleStack}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Name" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Name" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[Name], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Name]}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Email" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Email" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[FormEmail], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[FormEmail]}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Age" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Age" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[Age], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Age]}" />
                                </StackPanel>
                                <Button Style="{DynamicResource AccentButtonStyle}"
                                        Margin="0,16,0,0"
                                        Command="{Binding SubmitCommand}"
                                        Content="Submit" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                       Text="{Binding LastSubmitted, StringFormat='Last submitted: {0}', TargetNullValue='Last submitted: -'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </AdornerDecorator>
    </ScrollViewer>

</UserControl>
