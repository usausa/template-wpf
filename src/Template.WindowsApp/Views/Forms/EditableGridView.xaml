<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:converters="clr-namespace:Template.WindowsApp.Converters"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:views="clr-namespace:Template.WindowsApp.Views"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.EditableGridView"
             s:DataContextResolver.Type="{x:Type module:EditableGridViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:EditableGridViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <converters:ShortDateConverter x:Key="ShortDateConverter" />
        <converters:OrderLineCellConverter x:Key="CellConverter" />

        <!-- Toolbar -->

        <Style x:Key="EditableGridGlyphTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="EditableGridButtonTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="IconTextTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource EditableGridGlyphTextBlock}"
                           Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource EditableGridButtonTextBlock}"
                           Text="{Binding}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="EditableGridToolWrapPanel"
               TargetType="{x:Type WrapPanel}">
            <Setter Property="Margin" Value="0,0,0,-8" />
        </Style>

        <Style x:Key="EditableGridToolGroupGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,0,24,8" />
        </Style>

        <Style x:Key="EditableGridExportButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="EditableGridSummaryTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Lines -->

        <Style x:Key="EditableGridCellTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        </Style>
        <Style x:Key="EditableGridNumberTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource EditableGridCellTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="EditableGridCodeEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DataGridEditingTextBox}">
            <Setter Property="MaxLength" Value="10" />
            <Setter Property="CharacterCasing" Value="Upper" />
            <Setter Property="behaviors:TextBoxOption.AllowedCharacters" Value="[A-Za-z0-9-]" />
        </Style>
        <Style x:Key="EditableGridDescriptionEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DataGridEditingTextBox}">
            <Setter Property="MaxLength" Value="40" />
        </Style>
        <Style x:Key="EditableGridNumberEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DataGridNumberEditingTextBox}">
            <Setter Property="behaviors:TextBoxOption.AllowedCharacters" Value="[0-9]" />
        </Style>
        <Style x:Key="EditableGridQuantityEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource EditableGridNumberEditingTextBox}">
            <Setter Property="MaxLength" Value="3" />
        </Style>
        <Style x:Key="EditableGridPriceEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource EditableGridNumberEditingTextBox}">
            <Setter Property="MaxLength" Value="8" />
            <Setter Property="behaviors:TextBoxOption.AllowedCharacters" Value="[0-9.]" />
        </Style>
        <Style x:Key="EditableGridDiscountEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource EditableGridNumberEditingTextBox}">
            <Setter Property="MaxLength" Value="2" />
        </Style>
        <Style x:Key="EditableGridNoteEditingTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DataGridEditingTextBox}">
            <Setter Property="MaxLength" Value="100" />
        </Style>
        <Style x:Key="EditableGridLineCell"
               TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource DataGridCell}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:OrderLine}}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="ToolTip">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource CellConverter}"
                                  ConverterParameter="Error">
                        <Binding />
                        <Binding Path="Column.SortMemberPath"
                                 RelativeSource="{RelativeSource Self}" />
                        <Binding Path="Revision" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <Polygon x:Name="ChangedMark"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False"
                                     Points="0,0 8,0 0,8"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="ErrorBorder"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                    BorderThickness="1" />
                            <Border x:Name="FocusBorder"
                                    IsHitTestVisible="False"
                                    BorderBrush="Transparent" BorderThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource DataGridRowSelectedBackgroundThemeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static DataGrid.FocusBorderBrushKey}}" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource CellConverter}"
                                                  ConverterParameter="Changed">
                                        <Binding />
                                        <Binding Path="Column.SortMemberPath"
                                                 RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="Revision" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="ChangedMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource CellConverter}"
                                                  ConverterParameter="HasError">
                                        <Binding />
                                        <Binding Path="Column.SortMemberPath"
                                                 RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="Revision" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="ErrorBorder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditableGridImeOffCell"
               TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource EditableGridLineCell}">
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>
        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
        <Style x:Key="EditableGridLineRow"
               TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource DefaultDataGridRowStyle}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:OrderLine}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="behaviors:EditableGridBehavior.IsReadOnly" Value="{Binding IsLocked}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditableGridLineRowHeader"
               TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                        <Border Width="{TemplateBinding Width}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="LineRowHeaderTemplate"
                      DataType="{x:Type sample:OrderLine}">
            <TextBlock x:Name="Mark"
                       Width="16"
                       TextAlignment="Center"
                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                       FontSize="12" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}"
                             Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="&#xEA3B;" />
                    <Setter TargetName="Mark" Property="FontSize" Value="8" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Mark" Property="ToolTip" Value="Changed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}"
                             Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="&#xE710;" />
                    <Setter TargetName="Mark" Property="FontSize" Value="12" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Mark" Property="ToolTip" Value="Added" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasErrors}"
                             Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="Mark" Property="FontSize" Value="12" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Mark" Property="ToolTip" Value="{Binding ErrorText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Hint -->

        <Style x:Key="EditableGridHintTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}"
                  Focusable="False">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Editable grid" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Edit rows with checks on each cell and row, undo and save the changes, and copy and paste with Excel." />

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0"
                                   Style="{StaticResource EditableGridToolWrapPanel}">
                            <Grid Style="{StaticResource EditableGridToolGroupGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding AddCommand}"
                                        Content="Add row"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE710;" />
                                <Button Grid.Column="2"
                                        Command="{Binding DuplicateCommand}"
                                        Content="Duplicate"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE8C8;" />
                                <Button Grid.Column="4"
                                        Command="{Binding DeleteCommand}"
                                        Content="Delete"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE74D;" />
                                <Button Grid.Column="6"
                                        Command="{Binding ChangeCommand}"
                                        Content="Change"
                                        ToolTip="Change selected rows"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE70F;" />
                            </Grid>
                            <Grid Style="{StaticResource EditableGridToolGroupGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding RevertCommand}"
                                        Content="Revert"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE7A7;" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding SaveCommand}"
                                        Content="Save"
                                        ContentTemplate="{StaticResource IconTextTemplate}"
                                        Tag="&#xE74E;" />
                            </Grid>
                            <Button Style="{StaticResource EditableGridExportButton}"
                                    Command="{Binding ExportCommand}"
                                    Content="Export"
                                    ToolTip="Export to CSV"
                                    ContentTemplate="{StaticResource IconTextTemplate}"
                                    Tag="&#xEDE1;" />
                        </WrapPanel>
                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource EditableGridSummaryTextBlock}"
                                   Text="{Binding Summary}" />
                    </Grid>

                    <!-- Lines -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Lines}"
                              SelectionMode="Extended"
                              AutoGenerateColumns="False" AutomationProperties.Name="Order lines" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              CellStyle="{StaticResource EditableGridLineCell}"
                              ClipboardCopyMode="ExcludeHeader"
                              CurrentItem="{Binding CurrentItem, Mode=OneWayToSource}"
                              HeadersVisibility="All"
                              RowHeaderStyle="{StaticResource EditableGridLineRowHeader}"
                              RowHeaderTemplate="{StaticResource LineRowHeaderTemplate}"
                              RowHeaderWidth="28"
                              RowStyle="{StaticResource EditableGridLineRow}"
                              SelectionUnit="CellOrRowHeader">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Insert"
                                        Command="{Binding AddCommand}" />
                            <KeyBinding Key="D"
                                        Command="{Binding DuplicateCommand}"
                                        Modifiers="Control" />
                            <KeyBinding Key="Delete"
                                        Command="{Binding DeleteCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.RowValidationRules>
                            <views:OrderLineValidationRule ValidationStep="UpdatedValue" />
                        </DataGrid.RowValidationRules>
                        <i:Interaction.Behaviors>
                            <behaviors:EditableGridBehavior CancelRequest="{Binding CancelRequest}"
                                                            CommitRequest="{Binding CommitRequest}"
                                                            EditRequest="{Binding EditRequest}"
                                                            PasteCommand="{Binding PasteCommand}"
                                                            SelectedRows="{Binding SelectedRows, Mode=OneWayToSource}" />
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="96" MinWidth="96"
                                                Binding="{Binding Code}"
                                                Header="Item code"
                                                CellStyle="{StaticResource EditableGridImeOffCell}"
                                                EditingElementStyle="{StaticResource EditableGridCodeEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridCellTextBlock}" />
                            <DataGridTextColumn Width="2*" MinWidth="120"
                                                Binding="{Binding Description}"
                                                Header="Description"
                                                EditingElementStyle="{StaticResource EditableGridDescriptionEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridCellTextBlock}" />
                            <DataGridTextColumn Width="88" MinWidth="88"
                                                Binding="{Binding Quantity}"
                                                Header="Quantity"
                                                CellStyle="{StaticResource EditableGridImeOffCell}"
                                                EditingElementStyle="{StaticResource EditableGridQuantityEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridNumberTextBlock}" />
                            <DataGridTextColumn Width="96" MinWidth="96"
                                                Binding="{Binding UnitPrice, StringFormat=0.00}"
                                                Header="Unit price"
                                                CellStyle="{StaticResource EditableGridImeOffCell}"
                                                EditingElementStyle="{StaticResource EditableGridPriceEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridNumberTextBlock}" />
                            <DataGridTextColumn Width="112" MinWidth="112"
                                                Binding="{Binding Discount}"
                                                Header="Discount (%)"
                                                CellStyle="{StaticResource EditableGridImeOffCell}"
                                                EditingElementStyle="{StaticResource EditableGridDiscountEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridNumberTextBlock}" />
                            <DataGridTextColumn Width="104" MinWidth="104"
                                                Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}"
                                                Header="Amount"
                                                ElementStyle="{StaticResource EditableGridNumberTextBlock}"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Width="128" MinWidth="128"
                                                    Header="Delivery"
                                                    ClipboardContentBinding="{Binding Delivery, Converter={StaticResource ShortDateConverter}}"
                                                    SortMemberPath="Delivery">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:OrderLine}">
                                        <TextBlock Style="{StaticResource EditableGridCellTextBlock}"
                                                   Text="{Binding Delivery, Converter={StaticResource ShortDateConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="{x:Type sample:OrderLine}">
                                        <DatePicker AutomationProperties.Name="Delivery"
                                                    SelectedDate="{Binding Delivery, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Width="112" MinWidth="112"
                                                    ItemsSource="{x:Static module:EditableGridViewModel.Statuses}"
                                                    Header="Status"
                                                    EditingElementStyle="{StaticResource DataGridEditingComboBox}"
                                                    SelectedItemBinding="{Binding Status}"
                                                    SortMemberPath="Status" />
                            <DataGridTextColumn Width="*" MinWidth="100"
                                                Binding="{Binding Note}"
                                                Header="Note"
                                                EditingElementStyle="{StaticResource EditableGridNoteEditingTextBox}"
                                                ElementStyle="{StaticResource EditableGridCellTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Hint -->
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource EditableGridHintTextBlock}"
                               Text="Esc undoes the cell, Esc again the whole row. Ctrl+C and Ctrl+V work with Excel." />

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
