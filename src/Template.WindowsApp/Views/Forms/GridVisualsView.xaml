<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:converters="clr-namespace:Template.WindowsApp.Converters"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.GridVisualsView"
             s:DataContextResolver.Type="{x:Type module:GridVisualsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:GridVisualsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <converters:ServerGroupSummaryConverter x:Key="GroupSummaryConverter" />
        <s:MapToTextConverter x:Key="GroupByToPropertyConverter"
                              DefaultValue="">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static module:ServerGrouping.Role}"
                                  Value="Role" />
                <s:MapToTextEntry Key="{x:Static module:ServerGrouping.Status}"
                                  Value="Status" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>

        <!-- Toolbar -->

        <Style x:Key="GridVisualsGroupByTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Groups -->

        <Style x:Key="GridVisualsGroupItem"
               TargetType="{x:Type GroupItem}"
               d:DataContext="{d:DesignInstance Type={x:Type CollectionViewGroup}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander Padding="0"
                                  IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="16,0,0,0"
                                               Text="{Binding Items, Converter={StaticResource GroupSummaryConverter}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Details -->

        <Style x:Key="GridVisualsDetailsGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,8,16,16" />
        </Style>

        <Style x:Key="GridVisualsDetailLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="GridVisualsDetailValueTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="GridVisualsLatencyChart"
               TargetType="{x:Type controls:LineChart}">
            <Setter Property="Height" Value="120" />
            <Setter Property="Fill" Value="{StaticResource ChartBlueSuperLightBrush}" />
            <Setter Property="Stroke" Value="{StaticResource ChartBlueBrush}" />
            <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="GridVisualsDetailsNoDataTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Cells -->

        <Style x:Key="GridVisualsServerCell"
               TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource DataGridCell}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="GridVisualsCellGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="GridVisualsHitGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="GridVisualsCellTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridVisualsNumberTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GridVisualsCellTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="GridVisualsNoDataTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GridVisualsCellTextBlock}">
            <Setter Property="Text" Value="No data" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="GridVisualsServerNameTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GridVisualsCellTextBlock}">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        </Style>

        <Style x:Key="GridVisualsStatusBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Padding" Value="6,2,8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>

        <Style x:Key="GridVisualsStatusIconGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridVisualsStatusIconBackgroundTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>

        <Style x:Key="GridVisualsStatusIconGlyphTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="GridVisualsStatusLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="GridVisualsCpuDataBar"
               TargetType="{x:Type controls:DataBar}">
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource ChartBlueBrush}" />
        </Style>

        <Style x:Key="GridVisualsMemoryProgressBar"
               TargetType="{x:Type ProgressBar}"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridVisualsErrorsGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="GridVisualsErrorArrowTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="GridVisualsErrorChangeTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GridVisualsCellTextBlock}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="GridVisualsLatencySparkline"
               TargetType="{x:Type controls:Sparkline}">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource ChartBlueBrush}" />
        </Style>

        <Style x:Key="GridVisualsUptimeBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="GridVisualsUptimeTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource GridVisualsNumberTextBlock}">
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <!-- Hint -->

        <Style x:Key="GridVisualsHintTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}"
                  Focusable="False">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Grid visuals" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Show the state of each server in the cells with badges, bars, progress, colors and small trend lines, group the servers and open a row for details." />

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource GridVisualsGroupByTextBlock}"
                                   Text="Group by" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource SampleNarrowComboBox}"
                                  AutomationProperties.Name="Group by"
                                  SelectedValue="{Binding GroupBy}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="None"
                                          Tag="{x:Static module:ServerGrouping.None}" />
                            <ComboBoxItem Content="Role"
                                          Tag="{x:Static module:ServerGrouping.Role}" />
                            <ComboBoxItem Content="Status"
                                          Tag="{x:Static module:ServerGrouping.Status}" />
                        </ComboBox>
                    </Grid>

                    <!-- Servers -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Items}"
                              SelectionMode="Single"
                              AutoGenerateColumns="False" AutomationProperties.Name="Servers" CanUserAddRows="False" CanUserDeleteRows="False"
                              CellStyle="{StaticResource GridVisualsServerCell}"
                              HeadersVisibility="Column" IsReadOnly="True" MinRowHeight="40" RowDetailsVisibilityMode="VisibleWhenSelected"
                              SelectionUnit="FullRow">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridSortBehavior Sort="{Binding Sort}" />
                            <behaviors:DataGridGroupBehavior PropertyName="{Binding GroupBy, Converter={StaticResource GroupByToPropertyConverter}}" />
                        </i:Interaction.Behaviors>
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GridVisualsGroupItem}" />
                        </DataGrid.GroupStyle>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type sample:ServerRow}">
                                <Grid Style="{StaticResource GridVisualsDetailsGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="Chart"
                                                Grid.Column="0">
                                        <TextBlock Style="{StaticResource GridVisualsDetailLabelTextBlock}"
                                                   Text="Latency in the last 24 hours" />
                                        <controls:LineChart Style="{StaticResource GridVisualsLatencyChart}"
                                                            Labels="{x:Static module:GridVisualsViewModel.HourLabels}"
                                                            Values="{Binding Latency}" />
                                    </StackPanel>
                                    <TextBlock x:Name="NoData"
                                               Grid.Column="0"
                                               Style="{StaticResource GridVisualsDetailsNoDataTextBlock}"
                                               Visibility="Collapsed"
                                               Text="No data in the last 24 hours." />
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Style="{StaticResource GridVisualsDetailLabelTextBlock}"
                                                   Text="Latency" />
                                        <TextBlock x:Name="LatencyText"
                                                   Grid.Row="0" Grid.Column="1"
                                                   Style="{StaticResource GridVisualsDetailValueTextBlock}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}min {0:0} ms · max {1:0} ms · now {2:0} ms">
                                                    <Binding Path="LatencyMin" />
                                                    <Binding Path="LatencyMax" />
                                                    <Binding Path="LatencyNow" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Style="{StaticResource GridVisualsDetailLabelTextBlock}"
                                                   Text="Memory" />
                                        <TextBlock x:Name="MemoryText"
                                                   Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource GridVisualsDetailValueTextBlock}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:0.0} of {1:0} GB">
                                                    <Binding Path="MemoryUsed" />
                                                    <Binding Path="MemoryTotal" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Style="{StaticResource GridVisualsDetailLabelTextBlock}"
                                                   Text="Uptime (30 days)" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Style="{StaticResource GridVisualsDetailValueTextBlock}"
                                                   Text="{Binding Uptime, StringFormat={}{0:0.00}%}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Style="{StaticResource GridVisualsDetailLabelTextBlock}"
                                                   Text="Errors" />
                                        <TextBlock x:Name="ErrorsText"
                                                   Grid.Row="3" Grid.Column="1"
                                                   Style="{StaticResource GridVisualsDetailValueTextBlock}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} today · {1} yesterday">
                                                    <Binding Path="Errors" />
                                                    <Binding Path="ErrorsYesterday" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Down">
                                        <Setter TargetName="Chart" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="LatencyText" Property="Text" Value="No data" />
                                        <Setter TargetName="MemoryText" Property="Text" Value="No data" />
                                        <Setter TargetName="ErrorsText" Property="Text" Value="No data" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="112" MinWidth="112"
                                                    Header="Server"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <TextBlock Style="{StaticResource GridVisualsServerNameTextBlock}"
                                                   Text="{Binding Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="120" MinWidth="120"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="Status"
                                                    SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Border x:Name="Badge"
                                                Style="{StaticResource GridVisualsStatusBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0"
                                                      Style="{StaticResource GridVisualsStatusIconGrid}">
                                                    <TextBlock x:Name="IconBackground"
                                                               Style="{StaticResource GridVisualsStatusIconBackgroundTextBlock}"
                                                               Text="&#xF136;" />
                                                    <TextBlock x:Name="IconGlyph"
                                                               Style="{StaticResource GridVisualsStatusIconGlyphTextBlock}"
                                                               Text="&#xF13E;" />
                                                </Grid>
                                                <TextBlock x:Name="Label"
                                                           Grid.Column="2"
                                                           Style="{StaticResource GridVisualsStatusLabelTextBlock}"
                                                           Text="Healthy" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Warning">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13C;" />
                                                <Setter TargetName="Label" Property="Text" Value="Warning" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Down">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13D;" />
                                                <Setter TargetName="Label" Property="Text" Value="Down" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="160" MinWidth="160"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="CPU"
                                                    SortMemberPath="Cpu">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Grid Style="{StaticResource GridVisualsCellGrid}">
                                            <Grid x:Name="Content">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <controls:DataBar x:Name="Bar"
                                                                  Style="{StaticResource GridVisualsCpuDataBar}"
                                                                  Value="{Binding Cpu, TargetNullValue=0}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource GridVisualsNumberTextBlock}"
                                                           Text="{Binding Cpu, StringFormat={}{0:0}%}" />
                                            </Grid>
                                            <TextBlock x:Name="NoData"
                                                       Style="{StaticResource GridVisualsNoDataTextBlock}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CpuLevel}"
                                                         Value="Caution">
                                                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CpuLevel}"
                                                         Value="Critical">
                                                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Down">
                                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                         Value="True">
                                                <Setter TargetName="NoData" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="200" MinWidth="200"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="Memory"
                                                    SortMemberPath="MemoryPercent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Grid Style="{StaticResource GridVisualsCellGrid}">
                                            <Grid x:Name="Content"
                                                  Style="{StaticResource GridVisualsHitGrid}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:0.0} GB of {1:0} GB used ({2:0}%)">
                                                                <Binding Path="MemoryUsed" />
                                                                <Binding Path="MemoryTotal" />
                                                                <Binding Path="MemoryPercent" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid.ToolTip>
                                                <ProgressBar x:Name="Bar"
                                                             Style="{StaticResource GridVisualsMemoryProgressBar}"
                                                             Value="{Binding MemoryPercent, TargetNullValue=0, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource GridVisualsNumberTextBlock}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:0.0} / {1:0} GB">
                                                            <Binding Path="MemoryUsed" />
                                                            <Binding Path="MemoryTotal" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock x:Name="NoData"
                                                       Style="{StaticResource GridVisualsNoDataTextBlock}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding MemoryLevel}"
                                                         Value="Caution">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MemoryLevel}"
                                                         Value="Critical">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Down">
                                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                         Value="True">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                                <Setter TargetName="NoData" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="112" MinWidth="112"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="Errors"
                                                    SortMemberPath="Errors">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Grid Style="{StaticResource GridVisualsCellGrid}">
                                            <Grid x:Name="Content"
                                                  Style="{StaticResource GridVisualsErrorsGrid}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource GridVisualsCellTextBlock}"
                                                           Text="{Binding Errors}" />
                                                <TextBlock x:Name="Arrow"
                                                           Grid.Column="2"
                                                           Style="{StaticResource GridVisualsErrorArrowTextBlock}"
                                                           Text="&#xF090;" />
                                                <TextBlock x:Name="Change"
                                                           Grid.Column="4"
                                                           Style="{StaticResource GridVisualsErrorChangeTextBlock}"
                                                           Text="{Binding ErrorChangeAmount}" />
                                            </Grid>
                                            <TextBlock x:Name="NoData"
                                                       Style="{StaticResource GridVisualsNoDataTextBlock}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ErrorDirection}"
                                                         Value="Down">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xF08E;" />
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Setter TargetName="Change" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ErrorDirection}"
                                                         Value="Same">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xE738;" />
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Setter TargetName="Change" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Down">
                                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                         Value="True">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                                <Setter TargetName="Change" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                                <Setter TargetName="NoData" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" MinWidth="160"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="Latency"
                                                    SortMemberPath="LatencyNow">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Grid Style="{StaticResource GridVisualsCellGrid}">
                                            <Grid x:Name="Content"
                                                  Style="{StaticResource GridVisualsHitGrid}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}Last 24 hours: min {0:0} ms, max {1:0} ms, now {2:0} ms">
                                                                <Binding Path="LatencyMin" />
                                                                <Binding Path="LatencyMax" />
                                                                <Binding Path="LatencyNow" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid.ToolTip>
                                                <controls:Sparkline x:Name="Line"
                                                                    Style="{StaticResource GridVisualsLatencySparkline}"
                                                                    Values="{Binding Latency}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource GridVisualsNumberTextBlock}"
                                                           Text="{Binding LatencyNow, StringFormat={}{0:0} ms}" />
                                            </Grid>
                                            <TextBlock x:Name="NoData"
                                                       Style="{StaticResource GridVisualsNoDataTextBlock}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="Down">
                                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                         Value="True">
                                                <Setter TargetName="Line" Property="Stroke" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                                <Setter TargetName="NoData" Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="104" MinWidth="104"
                                                    behaviors:DataGridSortBehavior.FirstDirection="Descending"
                                                    Header="Uptime"
                                                    SortMemberPath="Uptime">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sample:ServerRow}">
                                        <Border x:Name="Cell"
                                                Style="{StaticResource GridVisualsUptimeBorder}">
                                            <TextBlock x:Name="Value"
                                                       Style="{StaticResource GridVisualsUptimeTextBlock}"
                                                       Text="{Binding Uptime, StringFormat={}{0:0.00}%}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding UptimeLevel}"
                                                         Value="Caution">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UptimeLevel}"
                                                         Value="Critical">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary -->
                    <TextBlock Grid.Row="4">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}Servers {0} · Warning {1} · Down {2} · CPU average {3:0}% · Errors {4}">
                                <Binding Path="ServerCount" />
                                <Binding Path="WarningCount" />
                                <Binding Path="DownCount" />
                                <Binding Path="AverageCpu" />
                                <Binding Path="ErrorTotal" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Hint -->
                    <TextBlock Grid.Row="6"
                               Style="{StaticResource GridVisualsHintTextBlock}"
                               Text="CPU and memory turn yellow at 80% and red at 90%. Uptime over 30 days turns yellow below 99.9% and red below 99%. Errors compare today with yesterday. Latency covers the last 24 hours." />

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
