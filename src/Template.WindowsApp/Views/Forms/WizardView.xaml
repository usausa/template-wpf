<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.WizardView"
             s:DataContextResolver.Type="{x:Type module:WizardViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:WizardViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <s:ParameterEqualsConverter x:Key="ParameterEqualsConverter" />

        <Style x:Key="StepPanelStyle"
               TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="SummaryValueTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextStyle}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <AdornerDecorator>
            <StackPanel Margin="24">
                <TextBlock Style="{StaticResource PageTitleTextStyle}"
                           Text="Wizard" />
                <TextBlock Style="{StaticResource PageDescriptionTextStyle}"
                           Text="Step-by-step input with back, next and finish." />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Steps}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type module:WizardStepItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Connector"
                                                Width="40" Height="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                        <Grid Width="24" Height="24">
                                            <Ellipse x:Name="Circle"
                                                     Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                                     StrokeThickness="1" />
                                            <TextBlock x:Name="Number"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Number}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="Check"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed"
                                                       Text="&#xE73E;"
                                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock x:Name="Title"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Step}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Number}"
                                                     Value="1">
                                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static module:WizardStepState.Current}">
                                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static module:WizardStepState.Done}">
                                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,24,0,0">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}"
                                           BasedOn="{StaticResource StepPanelStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}"
                                                         Value="{x:Static module:WizardStep.Plan}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <RadioButton IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Basic}}"
                                             AutomationProperties.Name="Basic">
                                    <StackPanel>
                                        <TextBlock Text="Basic" />
                                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                   Text="For one user."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Margin="0,8,0,0"
                                             IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Standard}}"
                                             AutomationProperties.Name="Standard">
                                    <StackPanel>
                                        <TextBlock Text="Standard" />
                                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                   Text="For small teams."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Margin="0,8,0,0"
                                             IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Premium}}"
                                             AutomationProperties.Name="Premium">
                                    <StackPanel>
                                        <TextBlock Text="Premium" />
                                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                   Text="For the whole organization."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}"
                                           BasedOn="{StaticResource StepPanelStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}"
                                                         Value="{x:Static module:WizardStep.Details}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Name" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Name" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               Visibility="{Binding Errors[Name], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Name]}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Email" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Email" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               Visibility="{Binding Errors[Email], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Email]}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                               Text="Company (optional)" />
                                    <TextBox Width="320"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Company" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}"
                                           BasedOn="{StaticResource StepPanelStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}"
                                                         Value="{x:Static module:WizardStep.Confirm}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                           Text="Plan"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource SummaryValueTextStyle}"
                                           Text="{Binding Plan}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                           Text="Name"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource SummaryValueTextStyle}"
                                           Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                           Text="Email"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource SummaryValueTextStyle}"
                                           Text="{Binding Email}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                           Text="Company"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource SummaryValueTextStyle}">
                                            <Setter Property="Text" Value="{Binding Company}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Company}"
                                                             Value="">
                                                    <Setter Property="Text" Value="-" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding BackCommand}"
                                    Content="Back" />
                            <Border Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}"
                                                         Value="{x:Static module:WizardStep.Confirm}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{DynamicResource AccentButtonStyle}"
                                        Command="{Binding NextCommand}"
                                        Content="Next" />
                            </Border>
                            <Border Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}"
                                                         Value="{x:Static module:WizardStep.Confirm}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{DynamicResource AccentButtonStyle}"
                                        Command="{Binding FinishCommand}"
                                        Content="Finish" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource SampleResultTextStyle}">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="Last submitted: {0} ({1})">
                                        <Binding Path="SubmittedName" />
                                        <Binding Path="SubmittedPlan" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubmittedName}"
                                             Value="{x:Null}">
                                    <Setter Property="Text" Value="Last submitted: -" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </AdornerDecorator>
    </ScrollViewer>

</UserControl>
