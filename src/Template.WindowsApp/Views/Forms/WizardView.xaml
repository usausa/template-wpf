<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.WizardView"
             s:DataContextResolver.Type="{x:Type module:WizardViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:WizardViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <s:ParameterEqualsConverter x:Key="ParameterEqualsConverter" />

        <!-- Steps -->

        <Style x:Key="WizardConnectorBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="WizardCircleGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style x:Key="WizardCircleEllipse"
               TargetType="{x:Type Ellipse}">
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style x:Key="WizardNumberTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="WizardCheckTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="WizardTitleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Common -->

        <Style x:Key="WizardStepPanel"
               TargetType="{x:Type Panel}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- Plan -->

        <Style x:Key="WizardPlanPanel"
               TargetType="{x:Type Panel}"
               BasedOn="{StaticResource WizardStepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}"
                             Value="{x:Static module:WizardStep.Plan}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Details -->

        <Style x:Key="WizardDetailsPanel"
               TargetType="{x:Type Panel}"
               BasedOn="{StaticResource WizardStepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}"
                             Value="{x:Static module:WizardStep.Details}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Confirm -->

        <Style x:Key="WizardConfirmPanel"
               TargetType="{x:Type Panel}"
               BasedOn="{StaticResource WizardStepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}"
                             Value="{x:Static module:WizardStep.Confirm}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardSummaryLabelTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FieldLabelTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="WizardSummaryValueTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="WizardCompanyValueTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource WizardSummaryValueTextBlock}">
            <Setter Property="Text" Value="{Binding Company}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Company}"
                             Value="">
                    <Setter Property="Text" Value="-" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Navigation -->

        <Style x:Key="WizardNavigationStack"
               TargetType="{x:Type StackPanel}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="WizardNextBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}"
                             Value="{x:Static module:WizardStep.Confirm}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardFinishBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}"
                             Value="{x:Static module:WizardStep.Confirm}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Result -->

        <Style x:Key="WizardResultTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Text">
                <Setter.Value>
                    <MultiBinding StringFormat="Last submitted: {0} ({1})">
                        <Binding Path="SubmittedName" />
                        <Binding Path="SubmittedPlan" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubmittedName}"
                             Value="{x:Null}">
                    <Setter Property="Text" Value="Last submitted: -" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <AdornerDecorator>
            <StackPanel Style="{StaticResource PageStack}">

                <!-- Header -->
                <TextBlock Style="{StaticResource PageTitleTextBlock}"
                           Text="Wizard" />
                <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                           Text="Step-by-step input with back, next and finish." />

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Steps -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding Steps}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type module:WizardStepItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Connector"
                                                Grid.Column="0"
                                                Style="{StaticResource WizardConnectorBorder}" />
                                        <Grid Grid.Column="1"
                                              Style="{StaticResource WizardCircleGrid}">
                                            <Ellipse x:Name="Circle"
                                                     Style="{StaticResource WizardCircleEllipse}" />
                                            <TextBlock x:Name="Number"
                                                       Style="{StaticResource WizardNumberTextBlock}"
                                                       Text="{Binding Number}" />
                                            <TextBlock x:Name="Check"
                                                       Style="{StaticResource WizardCheckTextBlock}"
                                                       Visibility="Collapsed"
                                                       Text="&#xE73E;" />
                                        </Grid>
                                        <TextBlock x:Name="Title"
                                                   Grid.Column="3"
                                                   Style="{StaticResource WizardTitleTextBlock}"
                                                   Text="{Binding Step}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Number}"
                                                     Value="1">
                                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static module:WizardStepState.Current}">
                                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static module:WizardStepState.Done}">
                                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="2">

                            <!-- Plan -->
                            <Grid Style="{StaticResource WizardPlanPanel}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButton Grid.Row="0"
                                             IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Basic}}"
                                             AutomationProperties.Name="Basic">
                                    <StackPanel>
                                        <TextBlock Text="Basic" />
                                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                                   Text="For one user." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Row="2"
                                             IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Standard}}"
                                             AutomationProperties.Name="Standard">
                                    <StackPanel>
                                        <TextBlock Text="Standard" />
                                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                                   Text="For small teams." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Row="4"
                                             IsChecked="{Binding Plan, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter={x:Static module:WizardPlan.Premium}}"
                                             AutomationProperties.Name="Premium">
                                    <StackPanel>
                                        <TextBlock Text="Premium" />
                                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                                   Text="For the whole organization." />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <!-- Details -->
                            <Grid Style="{StaticResource WizardDetailsPanel}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Name" />
                                    <TextBox Style="{StaticResource SampleWideTextBox}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Name" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[Name], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Name]}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Email" />
                                    <TextBox Style="{StaticResource SampleWideTextBox}"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Email" />
                                    <TextBlock Style="{StaticResource FieldErrorTextBlock}"
                                               Visibility="{Binding Errors[Email], Converter={s:NullToVisibility Null=Collapsed, NonNull=Visible}}"
                                               Text="{Binding Errors[Email]}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4">
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                               Text="Company (optional)" />
                                    <TextBox Style="{StaticResource SampleWideTextBox}"
                                             Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Company" />
                                </StackPanel>
                            </Grid>

                            <!-- Confirm -->
                            <StackPanel Style="{StaticResource WizardConfirmPanel}">
                                <TextBlock Style="{StaticResource WizardSummaryLabelTextBlock}"
                                           Text="Plan" />
                                <TextBlock Style="{StaticResource WizardSummaryValueTextBlock}"
                                           Text="{Binding Plan}" />
                                <TextBlock Style="{StaticResource WizardSummaryLabelTextBlock}"
                                           Text="Name" />
                                <TextBlock Style="{StaticResource WizardSummaryValueTextBlock}"
                                           Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource WizardSummaryLabelTextBlock}"
                                           Text="Email" />
                                <TextBlock Style="{StaticResource WizardSummaryValueTextBlock}"
                                           Text="{Binding Email}" />
                                <TextBlock Style="{StaticResource WizardSummaryLabelTextBlock}"
                                           Text="Company" />
                                <TextBlock Style="{StaticResource WizardCompanyValueTextBlock}" />
                            </StackPanel>

                        </Grid>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="4"
                                    Style="{StaticResource WizardNavigationStack}"
                                    Orientation="Horizontal">
                            <Button Command="{Binding BackCommand}"
                                    Content="Back" />
                            <Border Style="{StaticResource WizardNextBorder}">
                                <Button Style="{StaticResource AccentButton}"
                                        Command="{Binding NextCommand}"
                                        Content="Next" />
                            </Border>
                            <Border Style="{StaticResource WizardFinishBorder}">
                                <Button Style="{StaticResource AccentButton}"
                                        Command="{Binding FinishCommand}"
                                        Content="Finish" />
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Result -->
                <TextBlock Style="{StaticResource WizardResultTextBlock}" />

            </StackPanel>
        </AdornerDecorator>
    </ScrollViewer>

</UserControl>
