<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.BulkChangeDialogView"
             d:DataContext="{d:DesignInstance Type={x:Type module:BulkChangeDialogViewModel}}">

    <UserControl.Resources>

        <Style x:Key="BulkChangeDescriptionTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="BulkChangeLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BulkChangeComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="BulkChangeDatePicker"
               TargetType="{x:Type DatePicker}"
               BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="BulkChangeNumberBox"
               TargetType="{x:Type controls:NumberBox}">
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <controls:ContentDialog Title="{Binding Title}"
                            CloseButtonCommand="{Binding CloseCommand}"
                            CloseButtonText="Cancel"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            PrimaryButtonText="Change">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Description -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource BulkChangeDescriptionTextBlock}"
                       Text="Leave a field empty to keep its value. Shipped rows are not changed." />

            <!-- Fields -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource BulkChangeLabelTextBlock}"
                           Text="Status" />
                <ComboBox x:Name="StatusBox"
                          Grid.Row="0" Grid.Column="1"
                          Style="{StaticResource BulkChangeComboBox}"
                          ItemsSource="{x:Static module:EditableGridViewModel.Statuses}"
                          SelectedItem="{Binding Status}"
                          AutomationProperties.Name="Status">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Loaded">
                            <s:SetFocusAction />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource BulkChangeLabelTextBlock}"
                           Text="Delivery" />
                <DatePicker Grid.Row="2" Grid.Column="1"
                            Style="{StaticResource BulkChangeDatePicker}"
                            AutomationProperties.Name="Delivery"
                            SelectedDate="{Binding Delivery}" />
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Style="{StaticResource BulkChangeLabelTextBlock}"
                           Text="Discount (%)" />
                <controls:NumberBox Grid.Row="4" Grid.Column="1"
                                    Style="{StaticResource BulkChangeNumberBox}"
                                    Value="{Binding Discount}"
                                    Minimum="0" Maximum="50"
                                    AutomationProperties.Name="Discount" />
            </Grid>

        </Grid>
    </controls:ContentDialog>

</UserControl>
