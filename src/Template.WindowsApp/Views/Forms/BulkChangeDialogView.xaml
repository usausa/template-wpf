<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Forms"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Forms.BulkChangeDialogView"
             d:DataContext="{d:DesignInstance Type={x:Type module:BulkChangeDialogViewModel}}">

    <controls:ContentDialog Title="{Binding Title}"
                            CloseButtonCommand="{Binding CloseCommand}"
                            CloseButtonText="Cancel"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            PrimaryButtonText="Change">
        <StackPanel>
            <TextBlock Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       Text="Leave a field empty to keep its value. Shipped rows are not changed."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Status" />
                <ComboBox x:Name="StatusBox"
                          Grid.Row="0" Grid.Column="1"
                          Width="200"
                          HorizontalAlignment="Left"
                          ItemsSource="{x:Static module:EditableGridViewModel.Statuses}"
                          SelectedItem="{Binding Status}"
                          AutomationProperties.Name="Status">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Loaded">
                            <s:SetFocusAction />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Delivery" />
                <DatePicker Grid.Row="2" Grid.Column="1"
                            Width="200"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Delivery"
                            SelectedDate="{Binding Delivery}" />
                <TextBlock Grid.Row="4" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Discount (%)" />
                <controls:NumberBox Grid.Row="4" Grid.Column="1"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Value="{Binding Discount}"
                                    Minimum="0" Maximum="50"
                                    AutomationProperties.Name="Discount" />
            </Grid>
        </StackPanel>
    </controls:ContentDialog>

</UserControl>
