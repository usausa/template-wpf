<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Dialogs"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Dialogs.InputDialogView"
             d:DataContext="{d:DesignInstance Type={x:Type module:InputDialogViewModel}}">

    <controls:ContentDialog Title="{Binding Title}"
                            CloseButtonCommand="{Binding CloseCommand}"
                            CloseButtonText="Cancel"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            PrimaryButtonText="OK">
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Value">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Loaded">
                    <s:SetFocusAction />
                    <s:SelectAllTextAction />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
    </controls:ContentDialog>

</UserControl>
