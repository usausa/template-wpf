<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:module="clr-namespace:Template.WindowsApp.Views.Dialogs"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.Views.Dialogs.ErrorDialog"
                    d:DataContext="{d:DesignInstance Type={x:Type module:ErrorDialogViewModel}}"
                    Width="560"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False"
                    Title="Unexpected error">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Text="Something went wrong. The details are saved in the log." />
        <Expander Margin="0,16,0,0"
                  Header="Details">
            <TextBox Height="240"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Text="{Binding Details, Mode=OneWay}"
                     FontFamily="{StaticResource CodeFontFamily}"
                     IsReadOnly="True" />
        </Expander>
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button MinWidth="96"
                    Command="{Binding CopyCommand}"
                    Content="Copy details" />
            <Button MinWidth="96"
                    Margin="8,0,0,0"
                    Command="{Binding OpenLogFolderCommand}"
                    Content="Open log folder" />
            <Button MinWidth="96"
                    Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"
                    Content="Close" />
        </StackPanel>
    </StackPanel>

</controls:AppWindow>
