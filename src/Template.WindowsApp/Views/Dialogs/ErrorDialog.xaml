<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    x:Class="Template.WindowsApp.Views.Dialogs.ErrorDialog"
                    Width="560"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False"
                    Title="Unexpected error">

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Text="Something went wrong. The details are saved in the log." />
        <Expander Margin="0,16,0,0"
                  Header="Details">
            <TextBox x:Name="DetailsText"
                     Height="240"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource CodeFontFamily}"
                     IsReadOnly="True" />
        </Expander>
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button MinWidth="96"
                    Content="Copy details"
                    Click="OnCopyClick" />
            <Button x:Name="OpenLogFolderButton"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Content="Open log folder"
                    Click="OnOpenLogFolderClick" />
            <Button MinWidth="96"
                    Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"
                    Content="Close" />
        </StackPanel>
    </StackPanel>

</controls:AppWindow>
