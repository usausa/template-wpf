<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Dialogs"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Dialogs.MessageDialogView"
             d:DataContext="{d:DesignInstance Type={x:Type module:MessageDialogViewModel}}">

    <controls:ContentDialog Title="{Binding Title}"
                            CloseButtonCommand="{Binding CloseCommand}"
                            CloseButtonText="{Binding CloseButtonText}"
                            PrimaryButtonCommand="{Binding PrimaryCommand}"
                            PrimaryButtonText="{Binding PrimaryButtonText}">
        <TextBlock TextWrapping="Wrap"
                   Text="{Binding Message}" />
    </controls:ContentDialog>

</UserControl>
