<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:module="clr-namespace:Template.WindowsApp.Views.Dialogs"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.Views.Dialogs.InputDialog"
                    d:DataContext="{d:DesignInstance Type={x:Type module:InputDialogViewModel}}"
                    Width="384"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False"
                    Title="{Binding Title}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <StackPanel Margin="16">
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Loaded">
                    <s:SetFocusAction />
                    <s:SelectAllTextAction />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    IsDefault="True"
                    Content="OK">
                <i:Interaction.Behaviors>
                    <s:DialogResultBehavior />
                </i:Interaction.Behaviors>
            </Button>
            <Button Width="96"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Content="Cancel" />
        </StackPanel>
    </StackPanel>

</controls:AppWindow>
