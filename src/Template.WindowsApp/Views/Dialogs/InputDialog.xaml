<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 x:Class="Template.WindowsApp.Views.Dialogs.InputDialog"
                 Width="384"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False"
                 Title="Input">

    <StackPanel Margin="16">
        <TextBox x:Name="ValueText" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    IsDefault="True"
                    Content="OK"
                    Click="OnOkClick" />
            <Button Width="96"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Content="Cancel" />
        </StackPanel>
    </StackPanel>

</mah:MetroWindow>
