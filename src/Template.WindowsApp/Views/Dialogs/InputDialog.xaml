<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 x:Class="Template.WindowsApp.Views.Dialogs.InputDialog"
                 Width="384"
                 Title="Input"
                 ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBox x:Name="ValueText" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    Content="OK"
                    Click="OnOkClick" IsDefault="True" />
            <Button Width="96"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>

</mah:MetroWindow>
