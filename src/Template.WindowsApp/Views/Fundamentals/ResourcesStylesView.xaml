<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.ResourcesStylesView"
             s:DataContextResolver.Type="{x:Type module:ResourcesStylesViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ResourcesStylesViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <s:MapToTextConverter x:Key="OnOffConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{s:Bool True}"
                                  Value="On" />
                <s:MapToTextEntry Key="{s:Bool False}"
                                  Value="Off" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>

        <!-- Common -->

        <Style x:Key="ResourcesSwatchBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ResourcesKeyTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Triggers -->

        <Style x:Key="ResourcesTriggerBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="240" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsHighlighted}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResourcesTriggerTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Resources &amp; styles" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Resources, styles and triggers that keep the look consistent." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Resources -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Resources" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Define brushes once and use them with StaticResource." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="SampleDarkBrush"
                                                 Color="{StaticResource ChartBlueDarkColor}" />
                                <SolidColorBrush x:Key="SampleBrush"
                                                 Color="{StaticResource ChartBlueColor}" />
                                <SolidColorBrush x:Key="SampleLightBrush"
                                                 Color="{StaticResource ChartBlueLightColor}" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource ResourcesSwatchBorder}"
                                    Background="{StaticResource SampleDarkBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource ResourcesKeyTextBlock}"
                                       Text="SampleDarkBrush" />
                            <Border Grid.Row="2" Grid.Column="0"
                                    Style="{StaticResource ResourcesSwatchBorder}"
                                    Background="{StaticResource SampleBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource ResourcesKeyTextBlock}"
                                       Text="SampleBrush" />
                            <Border Grid.Row="4" Grid.Column="0"
                                    Style="{StaticResource ResourcesSwatchBorder}"
                                    Background="{StaticResource SampleLightBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="2"
                                       Style="{StaticResource ResourcesKeyTextBlock}"
                                       Text="SampleLightBrush" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Theme resources -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Theme resources" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="DynamicResource follows the light and dark themes." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0"
                                        Style="{StaticResource ResourcesSwatchBorder}"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource ResourcesKeyTextBlock}"
                                           Text="AccentFillColorDefaultBrush" />
                                <Border Grid.Row="2" Grid.Column="0"
                                        Style="{StaticResource ResourcesSwatchBorder}"
                                        Background="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Style="{StaticResource ResourcesKeyTextBlock}"
                                           Text="TextFillColorPrimaryBrush" />
                                <Border Grid.Row="4" Grid.Column="0"
                                        Style="{StaticResource ResourcesSwatchBorder}"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Style="{StaticResource ResourcesKeyTextBlock}"
                                           Text="SolidBackgroundFillColorBaseBrush" />
                            </Grid>
                            <Button Grid.Row="2"
                                    Command="{Binding SwitchThemeCommand}"
                                    Content="Switch theme" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding WindowManager.Theme, StringFormat='Theme: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Style with a key -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Style with a key" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="A named style based on the default button style." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.Resources>
                                <Style x:Key="StyledButton"
                                       TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="20,6" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding PressCommand}"
                                    CommandParameter="Default"
                                    Content="Default" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource StyledButton}"
                                    Command="{Binding PressCommand}"
                                    CommandParameter="Styled"
                                    Content="Styled" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Pressed, StringFormat='Pressed: {0}', TargetNullValue='Pressed: -'}" />
                    </StackPanel>
                </Border>

                <!-- Implicit style -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Implicit style" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="A style without a key applies to every TextBlock in the panel." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Every TextBlock" />
                            <TextBlock Text="in this panel" />
                            <TextBlock Text="uses the same style" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Triggers -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Triggers" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Change the look when a property or a value changes." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0"
                                      IsChecked="{Binding IsHighlighted}"
                                      Content="Highlight" />
                            <Border Grid.Row="2"
                                    Style="{StaticResource ResourcesTriggerBorder}">
                                <TextBlock Style="{StaticResource ResourcesTriggerTextBlock}"
                                           Text="Point at me or check Highlight" />
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding IsHighlighted, Converter={StaticResource OnOffConverter}, StringFormat='Highlight: {0}'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
