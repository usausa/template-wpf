<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.CustomControlsView"
             s:DataContextResolver.Type="{x:Type module:CustomControlsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:CustomControlsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Templated control -->

        <Style x:Key="CustomControlsRemovableTag"
               TargetType="{x:Type controls:RemovableTag}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- Behavior -->

        <Style x:Key="CustomControlsPointBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="56" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CustomControlsPointTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Custom controls" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Build reusable parts as user controls and templated controls." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- UserControl -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="UserControl" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Put controls together into one part with its own properties." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:ProfileTile Grid.Row="0"
                                                  Glyph="&#xE790;"
                                                  DisplayName="Aiko Tanaka"
                                                  Role="Designer" />
                            <controls:ProfileTile Grid.Row="2"
                                                  Glyph="&#xE943;"
                                                  DisplayName="Ben Carter"
                                                  Role="Developer" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Templated control -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Templated control" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="A control whose look comes from its style in Themes/Generic.xaml." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl Grid.Row="0"
                                          ItemsSource="{Binding Tags}"
                                          Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:RemovableTag Style="{StaticResource CustomControlsRemovableTag}"
                                                               Text="{Binding}"
                                                               RemoveCommand="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               RemoveCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Row="2"
                                    Command="{Binding ResetTagsCommand}"
                                    Content="Reset tags" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Tags.Count, StringFormat='Tags: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Attached property -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Attached property" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Add a property to a control from outside, like the placeholder of this box." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Style="{StaticResource SampleTextBox}"
                                     behaviors:TextBoxOption.AllowedCharacters="[0-9-]" behaviors:TextBoxOption.PlaceholderText="Postal code"
                                     Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Postal code" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding PostalCode, StringFormat='Postal code: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Behavior" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Run a command from any event with an EventTrigger and InvokeCommandAction." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Border Style="{StaticResource CustomControlsPointBorder}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseEnter">
                                        <i:InvokeCommandAction Command="{Binding EnterCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBlock Style="{StaticResource CustomControlsPointTextBlock}"
                                           Text="Point at this box" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding EnterCount, StringFormat='Pointed: {0} times'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
