<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.CustomControlsView"
             s:DataContextResolver.Type="{x:Type module:CustomControlsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:CustomControlsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Custom controls" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Build reusable parts as user controls and templated controls." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="UserControl" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Put controls together into one part with its own properties." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:ProfileTile Glyph="&#xE790;"
                                                  DisplayName="Aiko Tanaka"
                                                  Role="Designer" />
                            <controls:ProfileTile Margin="0,8,0,0"
                                                  Glyph="&#xE943;"
                                                  DisplayName="Ben Carter"
                                                  Role="Developer" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Templated control" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="A control whose look comes from its style in Themes/Generic.xaml." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ItemsControl ItemsSource="{Binding Tags}"
                                          Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:RemovableTag Margin="0,0,8,8"
                                                               Text="{Binding}"
                                                               RemoveCommand="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               RemoveCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,4,0,0"
                                    Command="{Binding ResetTagsCommand}"
                                    Content="Reset tags" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Tags.Count, StringFormat='Tags: {0}'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Attached property" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Add a property to a control from outside, like the placeholder of this box." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Width="240"
                                     behaviors:TextBoxOption.AllowedCharacters="[0-9-]" behaviors:TextBoxOption.PlaceholderText="Postal code"
                                     HorizontalAlignment="Left"
                                     Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Postal code" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding PostalCode, StringFormat='Postal code: {0}'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Behavior" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Run a command from any event with an EventTrigger and InvokeCommandAction." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Border Width="240" Height="56"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseEnter">
                                        <i:InvokeCommandAction Command="{Binding EnterCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="Point at this box" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding EnterCount, StringFormat='Pointed: {0} times'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
