<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.BindingView"
             s:DataContextResolver.Type="{x:Type module:BindingViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:BindingViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Element to element -->

        <Style x:Key="BindingProgressBar"
               TargetType="{x:Type ProgressBar}"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Format and convert -->

        <Style x:Key="BindingWeekdayTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Null value -->

        <Style x:Key="BindingNicknameTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="FontSize" Value="{DynamicResource SubtitleTextBlockFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- MultiBinding -->

        <Style x:Key="BindingNameTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="116" />
        </Style>

        <!-- Collection -->

        <Style x:Key="BindingPeopleListBox"
               TargetType="{x:Type ListBox}"
               BasedOn="{StaticResource SampleListBox}">
            <Setter Property="Height" Value="132" />
        </Style>

        <Style x:Key="BindingPersonNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="120" />
        </Style>

        <Style x:Key="BindingPersonRoleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Binding" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Connect controls to each other and to the view model." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Element to element -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Element to element" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Bind one control to another with ElementName." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider x:Name="SourceSlider"
                                    Grid.Row="0"
                                    Style="{StaticResource SampleSlider}"
                                    Value="40"
                                    Minimum="0" Maximum="100"
                                    AutomationProperties.Name="Source value" IsSnapToTickEnabled="True" TickFrequency="1" />
                            <ProgressBar Grid.Row="2"
                                         Style="{StaticResource BindingProgressBar}"
                                         Value="{Binding Value, ElementName=SourceSlider}"
                                         Minimum="0" Maximum="100" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Value, ElementName=SourceSlider, StringFormat='Value: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Two-way binding -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Two-way binding" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Typing updates the view model, and the view model updates the text." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Style="{StaticResource SampleTextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Name" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Name, StringFormat='Name: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Format and convert -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Format and convert" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Format a value with StringFormat and change it with a converter." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DatePicker Grid.Row="0"
                                        Style="{StaticResource SampleDatePicker}"
                                        AutomationProperties.Name="Date"
                                        SelectedDate="{Binding Date}" />
                            <CheckBox Grid.Row="2"
                                      IsChecked="{Binding ShowsWeekday}"
                                      Content="Show the day of the week" />
                            <TextBlock Grid.Row="3"
                                       Style="{StaticResource BindingWeekdayTextBlock}"
                                       Visibility="{Binding ShowsWeekday, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding Date, StringFormat='{}{0:dddd}'}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Date, StringFormat='Date: {0:yyyy-MM-dd}', TargetNullValue='Date: -'}" />
                    </StackPanel>
                </Border>

                <!-- Null value -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Null value" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="TargetNullValue shows a text while the value is null." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource BindingNicknameTextBlock}"
                                       Text="{Binding Nickname, TargetNullValue='(no nickname)'}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding SetNicknameCommand}"
                                        Content="Set nickname" />
                                <Button Grid.Column="2"
                                        Command="{Binding ClearNicknameCommand}"
                                        Content="Clear" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Nickname, StringFormat='Nickname: {0}', TargetNullValue='Nickname: null'}" />
                    </StackPanel>
                </Border>

                <!-- MultiBinding -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="MultiBinding" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Combine several values into one text." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource BindingNameTextBox}"
                                     behaviors:TextBoxOption.PlaceholderText="First name"
                                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="First name" />
                            <TextBox Grid.Column="2"
                                     Style="{StaticResource BindingNameTextBox}"
                                     behaviors:TextBoxOption.PlaceholderText="Last name"
                                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Last name" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Full name: {0} {1}">
                                    <Binding Path="FirstName" />
                                    <Binding Path="LastName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Collection -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Collection" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Bind a list and show each item with a DataTemplate." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ListBox Style="{StaticResource BindingPeopleListBox}"
                                     ItemsSource="{Binding People}"
                                     SelectedItem="{Binding SelectedPerson}"
                                     AutomationProperties.Name="People">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type module:PersonEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource BindingPersonNameTextBlock}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource BindingPersonRoleTextBlock}"
                                                       Text="{Binding Role}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SelectedPerson.Name, StringFormat='Selected: {0}', FallbackValue='Selected: -'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
