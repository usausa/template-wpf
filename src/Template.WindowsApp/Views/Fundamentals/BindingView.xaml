<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.BindingView"
             s:DataContextResolver.Type="{x:Type module:BindingViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:BindingViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                       Text="Binding" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Connect controls to each other and to the view model." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Element to element" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Bind one control to another with ElementName."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <Slider x:Name="SourceSlider"
                                    Width="240"
                                    HorizontalAlignment="Left"
                                    Value="40"
                                    Minimum="0" Maximum="100"
                                    AutomationProperties.Name="Source value" IsSnapToTickEnabled="True" TickFrequency="1" />
                            <ProgressBar Width="240"
                                         Margin="0,12,0,0"
                                         HorizontalAlignment="Left"
                                         Value="{Binding Value, ElementName=SourceSlider}"
                                         Minimum="0" Maximum="100" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding Value, ElementName=SourceSlider, StringFormat='Value: {0}'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Two-way binding" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Typing updates the view model, and the view model updates the text."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <TextBox Width="240"
                                     HorizontalAlignment="Left"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Name" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding Name, StringFormat='Name: {0}'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Format and convert" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Format a value with StringFormat and change it with a converter."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <DatePicker Width="240"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Date"
                                        SelectedDate="{Binding Date}" />
                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding ShowsWeekday}"
                                      Content="Show the day of the week" />
                            <TextBlock Margin="0,4,0,0"
                                       Visibility="{Binding ShowsWeekday, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding Date, StringFormat='{}{0:dddd}'}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding Date, StringFormat='Date: {0:yyyy-MM-dd}', TargetNullValue='Date: -'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Null value" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="TargetNullValue shows a text while the value is null."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                                       Text="{Binding Nickname, TargetNullValue='(no nickname)'}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <Button Command="{Binding SetNicknameCommand}"
                                        Content="Set nickname" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding ClearNicknameCommand}"
                                        Content="Clear" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding Nickname, StringFormat='Nickname: {0}', TargetNullValue='Nickname: null'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="MultiBinding" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Combine several values into one text."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}"
                                    Orientation="Horizontal">
                            <TextBox Width="116"
                                     controls:TextBoxHelper.PlaceholderText="First name"
                                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="First name" />
                            <TextBox Width="116"
                                     controls:TextBoxHelper.PlaceholderText="Last name"
                                     Margin="8,0,0,0"
                                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Last name" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Full name: {0} {1}">
                                    <Binding Path="FirstName" />
                                    <Binding Path="LastName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Collection" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Bind a list and show each item with a DataTemplate."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <ListBox Width="320" Height="132"
                                     HorizontalAlignment="Left"
                                     ItemsSource="{Binding People}"
                                     SelectedItem="{Binding SelectedPerson}"
                                     AutomationProperties.Name="People">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type module:PersonEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="120"
                                                       Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Role}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding SelectedPerson.Name, StringFormat='Selected: {0}', FallbackValue='Selected: -'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
