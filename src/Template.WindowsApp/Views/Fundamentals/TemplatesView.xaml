<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Fundamentals"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Fundamentals.TemplatesView"
             s:DataContextResolver.Type="{x:Type module:TemplatesViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:TemplatesViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- ItemTemplate -->

        <Style x:Key="TemplatesSwatchRectangle"
               TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TemplatesSwatchNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ControlTemplate -->

        <Style x:Key="TemplatesNewLookButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- Templates by data type -->

        <Style x:Key="TemplatesItemGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="TemplatesGlyphTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="TemplatesItemTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TemplatesLinkTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TemplatesItemTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="TemplatesAddressTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TemplatesItemTextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="TemplatesTaskCheckBox"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- DataTemplateSelector -->

        <Style x:Key="TemplatesNormalBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="TemplatesHotBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource TemplatesNormalBorder}">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="TemplatesHotTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Templates" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Change how items and controls look with templates." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ItemTemplate -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ItemTemplate" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Show each item of a list with a DataTemplate." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ComboBox Style="{StaticResource SampleComboBox}"
                                      ItemsSource="{Binding Swatches}"
                                      SelectedItem="{Binding SelectedSwatch}"
                                      AutomationProperties.Name="Color">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type module:SwatchEntry}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0"
                                                       Style="{StaticResource TemplatesSwatchRectangle}">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding Color}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource TemplatesSwatchNameTextBlock}"
                                                       Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SelectedSwatch.Name, StringFormat='Selected: {0}', FallbackValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <!-- ItemsPanelTemplate -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ItemsPanelTemplate" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Lay out the items of a list with another panel." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ListBox Style="{StaticResource SampleListBox}"
                                     ItemsSource="{Binding Tags}"
                                     SelectedItem="{Binding SelectedTag}"
                                     AutomationProperties.Name="Tags" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SelectedTag, StringFormat='Selected: {0}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <!-- ControlTemplate -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ControlTemplate" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Give a control a whole new look and keep how it works." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Button Style="{StaticResource TemplatesNewLookButton}"
                                    Command="{Binding PressCommand}"
                                    Content="Press the new look">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Root"
                                                Padding="12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="&#xE7C3;"
                                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <ContentPresenter Margin="12,0,0,0"
                                                                  VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding PressCount, StringFormat='Pressed: {0} times'}" />
                    </StackPanel>
                </Border>

                <!-- Templates by data type -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Templates by data type" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Each kind of item gets its own DataTemplate from its type." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ItemsControl ItemsSource="{Binding Items}"
                                          Focusable="False">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type module:NoteItem}">
                                        <Grid Style="{StaticResource TemplatesItemGrid}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource TemplatesGlyphTextBlock}"
                                                       Text="&#xE70B;" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource TemplatesItemTextBlock}"
                                                       Text="{Binding Text}" />
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type module:TaskItem}">
                                        <CheckBox Style="{StaticResource TemplatesTaskCheckBox}"
                                                  IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  IsHitTestVisible="False"
                                                  Content="{Binding Text}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type module:LinkItem}">
                                        <Grid Style="{StaticResource TemplatesItemGrid}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource TemplatesGlyphTextBlock}"
                                                       Text="&#xE71B;" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource TemplatesLinkTextBlock}"
                                                       Text="{Binding Text}" />
                                            <TextBlock Grid.Column="4"
                                                       Style="{StaticResource TemplatesAddressTextBlock}"
                                                       Text="{Binding Address}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DataTemplateSelector -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="DataTemplateSelector" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick a template for each item with your own rule." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ItemsControl ItemsSource="{Binding Temperatures}"
                                          Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplateSelector>
                                    <controls:TemperatureTemplateSelector HotThreshold="30">
                                        <controls:TemperatureTemplateSelector.NormalTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TemplatesNormalBorder}">
                                                    <TextBlock Text="{Binding StringFormat='{}{0} °C'}" />
                                                </Border>
                                            </DataTemplate>
                                        </controls:TemperatureTemplateSelector.NormalTemplate>
                                        <controls:TemperatureTemplateSelector.HotTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TemplatesHotBorder}">
                                                    <TextBlock Style="{StaticResource TemplatesHotTextBlock}"
                                                               Text="{Binding StringFormat='{}{0} °C'}" />
                                                </Border>
                                            </DataTemplate>
                                        </controls:TemperatureTemplateSelector.HotTemplate>
                                    </controls:TemperatureTemplateSelector>
                                </ItemsControl.ItemTemplateSelector>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="30 °C and above use the hot template" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
