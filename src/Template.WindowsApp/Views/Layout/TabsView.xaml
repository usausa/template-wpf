<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:models="clr-namespace:Template.WindowsApp.Models"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Layout"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Layout.TabsView"
             s:DataContextResolver.Type="{x:Type module:TabsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:TabsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Options -->

        <Style x:Key="TabsOptionLabelTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Documents -->

        <Style x:Key="TabsTabViewItem"
               TargetType="{x:Type controls:TabViewItem}">
            <Setter Property="Glyph" Value="&#xE8A5;" />
        </Style>

        <Style x:Key="TabsTitleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TabsDocumentTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TabsEmptyTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Documents.Count}"
                             Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding AddCommand}"
                    Gesture="Ctrl+T" />
        <KeyBinding Command="{Binding CloseSelectedCommand}"
                    Gesture="Ctrl+W" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 1}"
                    Gesture="Ctrl+D1" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 2}"
                    Gesture="Ctrl+D2" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 3}"
                    Gesture="Ctrl+D3" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 4}"
                    Gesture="Ctrl+D4" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 5}"
                    Gesture="Ctrl+D5" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 6}"
                    Gesture="Ctrl+D6" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 7}"
                    Gesture="Ctrl+D7" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 8}"
                    Gesture="Ctrl+D8" />
        <KeyBinding Command="{Binding SelectNumberCommand}"
                    CommandParameter="{s:Int32 9}"
                    Gesture="Ctrl+D9" />
    </UserControl.InputBindings>

    <!-- Content -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleTextBlock}"
                   Text="Tabs" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageDescriptionTextBlock}"
                   Text="Add, close and move tabs like a document app." />

        <!-- Options -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TabsOptionLabelTextBlock}"
                           Text="Tab width" />
                <ComboBox Style="{StaticResource SampleComboBox}"
                          AutomationProperties.Name="Tab width"
                          SelectedValue="{Binding WidthMode}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="Equal"
                                  Tag="{x:Static models:TabViewWidthMode.Equal}" />
                    <ComboBoxItem Content="Size to content"
                                  Tag="{x:Static models:TabViewWidthMode.SizeToContent}" />
                    <ComboBoxItem Content="Compact"
                                  Tag="{x:Static models:TabViewWidthMode.Compact}" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource TabsOptionLabelTextBlock}"
                           Text="Close button" />
                <ComboBox Style="{StaticResource SampleComboBox}"
                          AutomationProperties.Name="Close button"
                          SelectedValue="{Binding CloseButtonMode}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="Always"
                                  Tag="{x:Static controls:TabViewCloseButtonOverlayMode.Always}" />
                    <ComboBoxItem Content="On hover"
                                  Tag="{x:Static controls:TabViewCloseButtonOverlayMode.OnPointerOver}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Documents -->
        <controls:TabView Grid.Row="4"
                          ItemsSource="{Binding Documents}"
                          SelectedItem="{Binding SelectedDocument}"
                          TabWidthMode="{Binding WidthMode}"
                          CloseButtonOverlayMode="{Binding CloseButtonMode}"
                          AddTabButtonCommand="{Binding AddCommand}"
                          CloseTabCommand="{Binding CloseCommand}"
                          AutomationProperties.Name="Documents"
                          ItemContainerStyle="{StaticResource TabsTabViewItem}">
            <i:Interaction.Behaviors>
                <behaviors:TabReorderBehavior MoveCommand="{Binding MoveCommand}" />
            </i:Interaction.Behaviors>
            <controls:TabView.ItemTemplate>
                <DataTemplate DataType="{x:Type module:DocumentTab}">
                    <TextBlock Style="{StaticResource TabsTitleTextBlock}"
                               Text="{Binding Title}" />
                </DataTemplate>
            </controls:TabView.ItemTemplate>
            <controls:TabView.ContentTemplate>
                <DataTemplate DataType="{x:Type module:DocumentTab}">
                    <TextBox Style="{StaticResource TabsDocumentTextBox}"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AutomationProperties.Name="Document text" />
                </DataTemplate>
            </controls:TabView.ContentTemplate>
        </controls:TabView>
        <TextBlock Grid.Row="4"
                   Style="{StaticResource TabsEmptyTextBlock}"
                   Text="No open tabs. Select + or press Ctrl+T." />

        <!-- Result -->
        <TextBlock Grid.Row="5"
                   Style="{StaticResource SampleResultTextBlock}">
            <TextBlock.Text>
                <MultiBinding StringFormat="Tabs: {0} · Selected: {1}">
                    <Binding Path="Documents.Count" />
                    <Binding Path="SelectedDocument.Title"
                             FallbackValue="-" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

    </Grid>

</UserControl>
