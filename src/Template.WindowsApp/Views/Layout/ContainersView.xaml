<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Layout"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Layout.ContainersView"
             s:DataContextResolver.Type="{x:Type module:ContainersViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ContainersViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- TabControl -->

        <Style x:Key="ContainersTabControl"
               TargetType="{x:Type TabControl}"
               BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Height" Value="120" />
        </Style>

        <Style x:Key="ContainersTabTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- GridSplitter -->

        <Style x:Key="ContainersSplitterGrid"
               TargetType="{x:Type Grid}"
               BasedOn="{StaticResource SampleGrid}">
            <Setter Property="Height" Value="160" />
        </Style>

        <Style x:Key="ContainersPaneBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ContainersPaneTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Containers" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Expander, GroupBox, TabControl and GridSplitter." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Expander -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Expander" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Shows or hides content under a header." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Expander Grid.Row="0"
                                      Header="Expanded"
                                      IsExpanded="{Binding IsFirstExpanded}">
                                <TextBlock Text="This expander starts open." />
                            </Expander>
                            <Expander Grid.Row="2"
                                      Header="Collapsed"
                                      IsExpanded="{Binding IsSecondExpanded}">
                                <TextBlock Text="This expander starts closed." />
                            </Expander>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding ExpandedCount, StringFormat='Expanded: {0} of 2'}" />
                    </StackPanel>
                </Border>

                <!-- GroupBox -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="GroupBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Groups related controls under a header." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <GroupBox Header="User information">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                                   Text="Name" />
                                        <TextBox Style="{StaticResource SampleTextBox}"
                                                 AutomationProperties.Name="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                                   Text="Email" />
                                        <TextBox Style="{StaticResource SampleTextBox}"
                                                 AutomationProperties.Name="Email" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TabControl -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="TabControl" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Switches between pages of content." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TabControl x:Name="Tabs"
                                        Style="{StaticResource ContainersTabControl}"
                                        AutomationProperties.Name="Tabs"
                                        SelectedIndex="{Binding TabIndex}">
                                <TabItem Header="General">
                                    <TextBlock Style="{StaticResource ContainersTabTextBlock}"
                                               Text="Name, language and region." />
                                </TabItem>
                                <TabItem Header="Details">
                                    <TextBlock Style="{StaticResource ContainersTabTextBlock}"
                                               Text="Version, size and location." />
                                </TabItem>
                                <TabItem Header="History">
                                    <TextBlock Style="{StaticResource ContainersTabTextBlock}"
                                               Text="Changes in the last 30 days." />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SelectedItem.(HeaderedContentControl.Header), ElementName=Tabs, StringFormat='Selected: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- GridSplitter -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="GridSplitter" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Drag the bar to resize the two areas." />
                        <Grid Style="{StaticResource ContainersSplitterGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding LeftWidth, Mode=TwoWay}"
                                                  MinWidth="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{Binding RightWidth, Mode=TwoWay}"
                                                  MinWidth="80" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource ContainersPaneBorder}">
                                <TextBlock Style="{StaticResource ContainersPaneTextBlock}"
                                           Text="Left" />
                            </Border>
                            <GridSplitter Grid.Column="1"
                                          AutomationProperties.Name="Splitter" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource ContainersPaneBorder}">
                                <TextBlock Style="{StaticResource ContainersPaneTextBlock}"
                                           Text="Right" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
