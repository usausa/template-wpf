<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Layout"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Layout.MenusToolbarsView"
             s:DataContextResolver.Type="{x:Type module:MenusToolbarsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:MenusToolbarsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <s:ParameterEqualsConverter x:Key="ParameterEqualsConverter" />
        <Style x:Key="GlyphTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ContextAreaStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Height" Value="120" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                       Text="Menus &amp; toolbars" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Menu bars, context menus, toolbars and status bars." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Menu" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Menu bar with icons, submenus, checks and shortcuts."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <Menu HorizontalAlignment="Left">
                                <MenuItem Header="File">
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="New"
                                              Header="New"
                                              InputGestureText="Ctrl+N">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE8A5;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Open"
                                              Header="Open"
                                              InputGestureText="Ctrl+O">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE8E5;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Save"
                                              Header="Save"
                                              InputGestureText="Ctrl+S">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE74E;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Recent files">
                                        <MenuItem Command="{Binding MenuItemCommand}"
                                                  CommandParameter="Open report.txt"
                                                  Header="report.txt" />
                                        <MenuItem Command="{Binding MenuItemCommand}"
                                                  CommandParameter="Open notes.txt"
                                                  Header="notes.txt" />
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="Edit">
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Undo"
                                              Header="Undo"
                                              InputGestureText="Ctrl+Z">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE7A7;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Cut"
                                              Header="Cut"
                                              InputGestureText="Ctrl+X">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE8C6;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Copy"
                                              Header="Copy"
                                              InputGestureText="Ctrl+C">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding MenuItemCommand}"
                                              CommandParameter="Paste"
                                              Header="Paste"
                                              InputGestureText="Ctrl+V">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                       Text="&#xE77F;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="View">
                                    <MenuItem IsChecked="{Binding ShowStatusBar}"
                                              Header="Status bar"
                                              IsCheckable="True" />
                                    <MenuItem IsChecked="{Binding WordWrap}"
                                              Header="Word wrap"
                                              IsCheckable="True" />
                                    <Separator />
                                    <MenuItem Header="Zoom">
                                        <MenuItem Command="{Binding ZoomCommand}"
                                                  CommandParameter="100"
                                                  IsChecked="{Binding Zoom, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=100}"
                                                  Header="100 %"
                                                  IsCheckable="True" />
                                        <MenuItem Command="{Binding ZoomCommand}"
                                                  CommandParameter="125"
                                                  IsChecked="{Binding Zoom, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=125}"
                                                  Header="125 %"
                                                  IsCheckable="True" />
                                        <MenuItem Command="{Binding ZoomCommand}"
                                                  CommandParameter="150"
                                                  IsChecked="{Binding Zoom, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=150}"
                                                  Header="150 %"
                                                  IsCheckable="True" />
                                    </MenuItem>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding LastMenuCommand, StringFormat='Last command: {0}', TargetNullValue='Last command: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="ContextMenu" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Right-click the area to open a menu."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <Border Style="{StaticResource ContextAreaStyle}"
                                    AutomationProperties.Name="Context area">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ContextItemCommand}"
                                                  CommandParameter="Cut"
                                                  Header="Cut" />
                                        <MenuItem Command="{Binding ContextItemCommand}"
                                                  CommandParameter="Copy"
                                                  Header="Copy" />
                                        <MenuItem Command="{Binding ContextItemCommand}"
                                                  CommandParameter="Paste"
                                                  Header="Paste" />
                                        <Separator />
                                        <MenuItem Header="Sort by">
                                            <MenuItem Command="{Binding SortByCommand}"
                                                      CommandParameter="Name"
                                                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Name}"
                                                      Header="Name"
                                                      IsCheckable="True" />
                                            <MenuItem Command="{Binding SortByCommand}"
                                                      CommandParameter="Date"
                                                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Date}"
                                                      Header="Date"
                                                      IsCheckable="True" />
                                            <MenuItem Command="{Binding SortByCommand}"
                                                      CommandParameter="Size"
                                                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Size}"
                                                      Header="Size"
                                                      IsCheckable="True" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem IsChecked="{Binding ShowHiddenItems}"
                                                  Header="Show hidden items"
                                                  IsCheckable="True" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="Right-click here"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding LastContextCommand, StringFormat='Last command: {0}', TargetNullValue='Last command: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="ToolBar" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Toolbar buttons, toggles and a combo box."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <ToolBarTray>
                                <ToolBar>
                                    <Button Command="{Binding ToolBarItemCommand}"
                                            CommandParameter="New"
                                            ToolTip="New"
                                            AutomationProperties.Name="New">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE8A5;" />
                                    </Button>
                                    <Button Command="{Binding ToolBarItemCommand}"
                                            CommandParameter="Open"
                                            ToolTip="Open"
                                            AutomationProperties.Name="Open">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE8E5;" />
                                    </Button>
                                    <Button Command="{Binding ToolBarItemCommand}"
                                            CommandParameter="Save"
                                            ToolTip="Save"
                                            AutomationProperties.Name="Save">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE74E;" />
                                    </Button>
                                </ToolBar>
                                <ToolBar>
                                    <ToggleButton IsChecked="{Binding IsBold}"
                                                  ToolTip="Bold"
                                                  AutomationProperties.Name="Bold">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE8DD;" />
                                    </ToggleButton>
                                    <ToggleButton IsChecked="{Binding IsItalic}"
                                                  ToolTip="Italic"
                                                  AutomationProperties.Name="Italic">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE8DB;" />
                                    </ToggleButton>
                                    <ToggleButton IsChecked="{Binding IsUnderline}"
                                                  ToolTip="Underline"
                                                  AutomationProperties.Name="Underline">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}"
                                                   Text="&#xE8DC;" />
                                    </ToggleButton>
                                    <ComboBox Width="72"
                                              ItemsSource="{Binding TextSizes}"
                                              SelectedItem="{Binding TextSize}"
                                              AutomationProperties.Name="Text size" />
                                </ToolBar>
                            </ToolBarTray>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding LastToolBarCommand, StringFormat='Last command: {0}', TargetNullValue='Last command: -'}" />
                        <TextBlock Style="{StaticResource SampleResultTextStyle}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Bold: {0} · Italic: {1} · Underline: {2} · Size: {3}">
                                    <Binding Path="IsBold"
                                             Converter="{s:BoolToText True=On, False=Off}" />
                                    <Binding Path="IsItalic"
                                             Converter="{s:BoolToText True=On, False=Off}" />
                                    <Binding Path="IsUnderline"
                                             Converter="{s:BoolToText True=On, False=Off}" />
                                    <Binding Path="TextSize" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="StatusBar" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Status bar items updated every second."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <StatusBar>
                                <StatusBarItem Content="Ready" />
                                <Separator />
                                <StatusBarItem>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='CPU {0:0} %'}" />
                                </StatusBarItem>
                                <Separator />
                                <StatusBarItem>
                                    <TextBlock Text="{Binding MemoryUsage, StringFormat='Memory {0:0} MB'}" />
                                </StatusBarItem>
                                <Separator />
                                <StatusBarItem>
                                    <TextBlock Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" />
                                </StatusBarItem>
                            </StatusBar>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
