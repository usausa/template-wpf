<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Features"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Features.WebApiView"
             s:DataContextResolver.Type="{x:Type module:WebApiViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:WebApiViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Layout -->

        <Style x:Key="WebApiRootGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="MinHeight" Value="840" />
        </Style>

        <!-- Posts -->

        <Style x:Key="WebApiPostsDataGrid"
               TargetType="{x:Type DataGrid}"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="MinHeight" Value="354" />
        </Style>

        <Style x:Key="WebApiTitleTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Post -->

        <Style x:Key="WebApiPostButtonsGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="WebApiIdNumberBox"
               TargetType="{x:Type controls:NumberBox}">
            <Setter Property="Width" Value="120" />
        </Style>

        <Style x:Key="WebApiBodyTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Requests -->

        <Style x:Key="WebApiRequestsDataGrid"
               TargetType="{x:Type DataGrid}"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="WebApiRequestTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}"
               d:DataContext="{d:DesignInstance Type={x:Type module:RequestEntry}}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsError}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WebApiRequestPathTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource WebApiRequestTextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WebApiRequestNumberTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource WebApiRequestTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <Grid Style="{StaticResource WebApiRootGrid}"
              Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Style="{StaticResource PageTitleTextBlock}"
                           Text="Web API" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           Style="{StaticResource PageDescriptionTextBlock}"
                           Text="Call a public REST API with Rester: page through posts, read one, and send create, update and delete requests." />

                <!-- Posts -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Posts" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="GET /posts, 10 at a time. The total comes from the X-Total-Count header." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      Style="{StaticResource WebApiPostsDataGrid}"
                                      ItemsSource="{Binding Posts}"
                                      SelectedItem="{Binding SelectedPost}"
                                      SelectionMode="Single"
                                      AutoGenerateColumns="False" AutomationProperties.Name="Posts" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      CellStyle="{StaticResource DataGridCell}"
                                      HeadersVisibility="Column" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="64"
                                                        Binding="{Binding Id}"
                                                        Header="Id"
                                                        ElementStyle="{StaticResource DataGridNumberTextBlock}" />
                                    <DataGridTextColumn Width="*"
                                                        Binding="{Binding Title}"
                                                        Header="Title"
                                                        ElementStyle="{StaticResource WebApiTitleTextBlock}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource PagerRangeTextBlock}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1} of {2}">
                                            <Binding Path="RangeStart" />
                                            <Binding Path="RangeEnd" />
                                            <Binding Path="TotalCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        Command="{Binding PreviousCommand}"
                                        Content="&#xE76B;"
                                        ToolTip="Previous page"
                                        AutomationProperties.Name="Previous page" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource IconButton}"
                                        Command="{Binding NextCommand}"
                                        Content="&#xE76C;"
                                        ToolTip="Next page"
                                        AutomationProperties.Name="Next page" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding ListResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                    </StackPanel>
                </Border>

                <!-- Post -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource CardTitleTextBlock}"
                                   Text="Post" />
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource CardCaptionTextBlock}"
                                   Text="GET, POST, PUT, PATCH and DELETE /posts/{id}." />
                        <TextBlock DockPanel.Dock="Bottom"
                                   Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding PostResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                        <Grid DockPanel.Dock="Bottom"
                              Style="{StaticResource WebApiPostButtonsGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding CreateCommand}"
                                    Content="Create" />
                            <Button Grid.Column="2"
                                    Command="{Binding UpdateCommand}"
                                    Content="Update" />
                            <Button Grid.Column="4"
                                    Command="{Binding PatchCommand}"
                                    Content="Patch" />
                            <Button Grid.Column="6"
                                    Command="{Binding DeleteCommand}"
                                    Content="Delete" />
                        </Grid>
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                           Text="Id" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:NumberBox Grid.Column="0"
                                                        Style="{StaticResource WebApiIdNumberBox}"
                                                        Value="{Binding Id}"
                                                        Minimum="0" Maximum="999"
                                                        AutomationProperties.Name="Id" />
                                    <Button Grid.Column="2"
                                            Command="{Binding GetCommand}"
                                            Content="Get" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                           Text="Title" />
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Title" />
                            </StackPanel>
                            <TextBlock Grid.Row="4"
                                       Style="{StaticResource FieldLabelTextBlock}"
                                       Text="Body" />
                            <TextBox Grid.Row="5"
                                     Style="{StaticResource WebApiBodyTextBox}"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AutomationProperties.Name="Body" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Requests -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                           Text="Requests" />
                                <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                           Text="{Binding BaseAddress, StringFormat='Requests to {0}. The server answers with fake results and saves nothing.'}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearCommand}"
                                    Content="Clear" />
                        </Grid>
                        <DataGrid Style="{StaticResource WebApiRequestsDataGrid}"
                                  ItemsSource="{Binding Requests}"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False" AutomationProperties.Name="Requests" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  CellStyle="{StaticResource DataGridCell}"
                                  HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="96"
                                                    Binding="{Binding Time, StringFormat=HH:mm:ss}"
                                                    Header="Time"
                                                    ElementStyle="{StaticResource WebApiRequestTextBlock}" />
                                <DataGridTextColumn Width="96"
                                                    Binding="{Binding Method}"
                                                    Header="Method"
                                                    ElementStyle="{StaticResource WebApiRequestTextBlock}" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Path}"
                                                    Header="Path"
                                                    ElementStyle="{StaticResource WebApiRequestPathTextBlock}" />
                                <DataGridTextColumn Width="200"
                                                    Binding="{Binding Status}"
                                                    Header="Status"
                                                    ElementStyle="{StaticResource WebApiRequestTextBlock}" />
                                <DataGridTextColumn Width="96"
                                                    Binding="{Binding Milliseconds, StringFormat=N0}"
                                                    Header="ms"
                                                    ElementStyle="{StaticResource WebApiRequestNumberTextBlock}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
