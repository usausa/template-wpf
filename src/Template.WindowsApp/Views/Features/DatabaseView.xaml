<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Features"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Features.DatabaseView"
             s:DataContextResolver.Type="{x:Type module:DatabaseViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:DatabaseViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Common -->

        <Style x:Key="DatabaseLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,16,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="DatabaseValueTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- File -->

        <Style x:Key="DatabasePathTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DatabaseValueTextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        </Style>

        <!-- Tables -->

        <Style x:Key="DatabaseTablesGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="DatabaseCountTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DatabaseValueTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Database" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Create, inspect and rebuild the SQLite database, and time single-row and bulk operations." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- File -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="File" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Where the database file is and how large it is. Rebuild creates it again with the sample data." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="Path" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource DatabasePathTextBlock}"
                                           Text="{Binding DatabasePath}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="Size" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource DatabaseValueTextBlock}"
                                           Text="{Binding DatabaseSize}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding OpenFolderCommand}"
                                        Content="Open folder" />
                                <Button Grid.Column="2"
                                        Command="{Binding RebuildCommand}"
                                        Content="Rebuild" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding FileResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                    </StackPanel>
                </Border>

                <!-- Tables -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Tables" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Rows in each table. Data grid, Editable grid and List &amp; detail read and write these tables." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  Style="{StaticResource DatabaseTablesGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="Product" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource DatabaseCountTextBlock}"
                                           Text="{Binding ProductCount, StringFormat=N0}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="Customer" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource DatabaseCountTextBlock}"
                                           Text="{Binding CustomerCount, StringFormat=N0}" />
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="OrderLine" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource DatabaseCountTextBlock}"
                                           Text="{Binding OrderLineCount, StringFormat=N0}" />
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="Data" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Style="{StaticResource DatabaseCountTextBlock}"
                                           Text="{Binding DataCount, StringFormat=N0}" />
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource DatabaseLabelTextBlock}"
                                           Text="BulkData" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Style="{StaticResource DatabaseCountTextBlock}"
                                           Text="{Binding BulkDataCount, StringFormat=N0}" />
                            </Grid>
                            <Button Grid.Row="2"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding TotalCount, StringFormat='Total: {0:N0} rows'}" />
                    </StackPanel>
                </Border>

                <!-- Single row -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Single row" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Insert, update, delete and read the row with Id 1 in the Data table." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding InsertCommand}"
                                    Content="Insert" />
                            <Button Grid.Column="2"
                                    Command="{Binding UpdateCommand}"
                                    Content="Update" />
                            <Button Grid.Column="4"
                                    Command="{Binding DeleteCommand}"
                                    Content="Delete" />
                            <Button Grid.Column="6"
                                    Command="{Binding QueryCommand}"
                                    Content="Query" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding RowResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                    </StackPanel>
                </Border>

                <!-- Bulk -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Bulk" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Insert 10,000 rows in one transaction, read them all and delete them." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding BulkInsertCommand}"
                                    Content="Insert 10,000 rows" />
                            <Button Grid.Column="2"
                                    Command="{Binding ReadAllCommand}"
                                    Content="Read all" />
                            <Button Grid.Column="4"
                                    Command="{Binding DeleteAllCommand}"
                                    Content="Delete all" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding BulkResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
