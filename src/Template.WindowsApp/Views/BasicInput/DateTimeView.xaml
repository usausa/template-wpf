<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:converters="clr-namespace:Template.WindowsApp.Converters"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.BasicInput"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.BasicInput.DateTimeView"
             s:DataContextResolver.Type="{x:Type module:DateTimeViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:DateTimeViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <converters:ShortDateConverter x:Key="ShortDateConverter" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Date &amp; time" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Date and time pickers and calendars." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="DatePicker" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick a date from a drop-down calendar." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <DatePicker Width="240"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Date"
                                        SelectedDate="{Binding Date}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Date, Converter={StaticResource ShortDateConverter}, StringFormat='Selected: {0}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Limits" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Only the next 30 days can be picked." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <DatePicker Width="240"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Limited date"
                                        DisplayDateEnd="{Binding LastDate, Mode=OneWay}"
                                        DisplayDateStart="{Binding FirstDate, Mode=OneWay}"
                                        SelectedDate="{Binding LimitedDate}">
                                <i:Interaction.Behaviors>
                                    <behaviors:DatePickerRangeBehavior Minimum="{Binding FirstDate}"
                                                                       Maximum="{Binding LastDate}" />
                                </i:Interaction.Behaviors>
                            </DatePicker>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding LimitedDate, Converter={StaticResource ShortDateConverter}, StringFormat='Selected: {0}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Calendar" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Select a day on a calendar." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Calendar HorizontalAlignment="Left"
                                      AutomationProperties.Name="Calendar"
                                      SelectedDate="{Binding CalendarDate}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding CalendarDate, Converter={StaticResource ShortDateConverter}, StringFormat='Selected: {0}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Date range" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Select a range of days." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Calendar x:Name="RangeCalendar"
                                      HorizontalAlignment="Left"
                                      SelectionMode="SingleRange"
                                      AutomationProperties.Name="Date range">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedDatesChanged">
                                        <i:InvokeCommandAction Command="{Binding RangeCommand}"
                                                               CommandParameter="{Binding SelectedDates, ElementName=RangeCalendar}" />
                                    </i:EventTrigger>
                                    <s:EventRequestTrigger Request="{Binding ClearRangeRequest}">
                                        <i:CallMethodAction MethodName="Clear"
                                                            TargetObject="{Binding SelectedDates, ElementName=RangeCalendar}" />
                                    </s:EventRequestTrigger>
                                </i:Interaction.Triggers>
                            </Calendar>
                        </StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource SampleResultTextBlock}">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="Selected: {0} – {1} ({2} days)">
                                                <Binding Path="RangeStart"
                                                         Converter="{StaticResource ShortDateConverter}" />
                                                <Binding Path="RangeEnd"
                                                         Converter="{StaticResource ShortDateConverter}" />
                                                <Binding Path="RangeDays" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RangeDays}"
                                                     Value="1">
                                            <Setter Property="Text" Value="{Binding RangeStart, Converter={StaticResource ShortDateConverter}, StringFormat='Selected: {0} (1 day)'}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RangeDays}"
                                                     Value="0">
                                            <Setter Property="Text" Value="Selected: -" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="TimePicker" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick a time from a drop-down list." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:TimePicker Width="240"
                                                 AutomationProperties.Name="Time"
                                                 SelectedTime="{Binding Time}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Time, StringFormat='Selected: {0:hh\\:mm}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Minute increment" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Minutes go up in steps of 15." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:TimePicker Width="240"
                                                 AutomationProperties.Name="Step time" MinuteIncrement="15"
                                                 SelectedTime="{Binding StepTime}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding StepTime, StringFormat='Selected: {0:hh\\:mm}', TargetNullValue='Selected: -'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
