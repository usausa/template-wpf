<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.BasicInput"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.BasicInput.ButtonsView"
             s:DataContextResolver.Type="{x:Type module:ButtonsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ButtonsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="IconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                       Text="Buttons" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Buttons, repeat buttons, toggle buttons and icon buttons." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                               Text="Button" />
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Text="Standard, accent and disabled buttons."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Style="{StaticResource SamplePanelStyle}"
                                Orientation="Horizontal">
                        <Button Command="{Binding ClickCommand}"
                                Content="Standard" />
                        <Button Style="{DynamicResource AccentButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding ClickCommand}"
                                Content="Accent" />
                        <Button Margin="8,0,0,0"
                                IsEnabled="False"
                                Content="Disabled" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SampleResultTextStyle}"
                               Text="{Binding ClickCount, StringFormat='Clicked {0} times'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                               Text="RepeatButton" />
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Text="Repeats the command while pressed."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Style="{StaticResource SamplePanelStyle}">
                        <RepeatButton Command="{Binding RepeatCommand}"
                                      Content="Hold to repeat" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SampleResultTextStyle}"
                               Text="{Binding RepeatCount, StringFormat='Count: {0}'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                               Text="ToggleButton" />
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Text="Switches between on and off."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Style="{StaticResource SamplePanelStyle}">
                        <ToggleButton IsChecked="{Binding IsToggled}"
                                      Content="Toggle" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SampleResultTextStyle}"
                               Text="{Binding IsToggled, Converter={s:BoolToText True=On, False=Off}, StringFormat='State: {0}'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                               Text="Icon buttons" />
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Text="Buttons with a glyph and a tooltip."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Style="{StaticResource SamplePanelStyle}"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding PressCommand}"
                                CommandParameter="Add"
                                Content="&#xE710;"
                                ToolTip="Add"
                                AutomationProperties.Name="Add" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding PressCommand}"
                                CommandParameter="Edit"
                                Content="&#xE70F;"
                                ToolTip="Edit"
                                AutomationProperties.Name="Edit" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding PressCommand}"
                                CommandParameter="Delete"
                                Content="&#xE74D;"
                                ToolTip="Delete"
                                AutomationProperties.Name="Delete" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SampleResultTextStyle}"
                               Text="{Binding LastPressed, StringFormat='Last pressed: {0}', TargetNullValue='Last pressed: -'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
