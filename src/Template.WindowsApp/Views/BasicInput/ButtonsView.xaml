<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.BasicInput"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.BasicInput.ButtonsView"
             s:DataContextResolver.Type="{x:Type module:ButtonsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ButtonsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <s:ParameterEqualsConverter x:Key="ParameterEqualsConverter" />

        <!-- DropDownButton -->

        <Style x:Key="ButtonsDropDownButton"
               TargetType="{x:Type controls:DropDownButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- SplitButton -->

        <Style x:Key="ButtonsSplitButton"
               TargetType="{x:Type controls:SplitButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Buttons" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Buttons, repeat buttons, toggle buttons, icon buttons, drop-down buttons and split buttons." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Button -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Button" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Standard, accent and disabled buttons." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ClickCommand}"
                                    Content="Standard" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding ClickCommand}"
                                    Content="Accent" />
                            <Button Grid.Column="4"
                                    IsEnabled="False"
                                    Content="Disabled" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding ClickCount, StringFormat='Clicked {0} times'}" />
                    </StackPanel>
                </Border>

                <!-- RepeatButton -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="RepeatButton" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Repeats the command while pressed." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <RepeatButton Command="{Binding RepeatCommand}"
                                          Content="Hold to repeat" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding RepeatCount, StringFormat='Count: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- ToggleButton -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ToggleButton" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Switches between on and off." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ToggleButton IsChecked="{Binding IsToggled}"
                                          Content="Toggle" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding IsToggled, Converter={s:BoolToText True=On, False=Off}, StringFormat='State: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Icon buttons -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Icon buttons" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Buttons with a glyph and a tooltip." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding PressCommand}"
                                    CommandParameter="Add"
                                    Content="&#xE710;"
                                    ToolTip="Add"
                                    AutomationProperties.Name="Add" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding PressCommand}"
                                    CommandParameter="Edit"
                                    Content="&#xE70F;"
                                    ToolTip="Edit"
                                    AutomationProperties.Name="Edit" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding PressCommand}"
                                    CommandParameter="Delete"
                                    Content="&#xE74D;"
                                    ToolTip="Delete"
                                    AutomationProperties.Name="Delete" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding LastPressed, StringFormat='Last pressed: {0}', TargetNullValue='Last pressed: -'}" />
                    </StackPanel>
                </Border>

                <!-- DropDownButton -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="DropDownButton" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Opens a menu of options." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:DropDownButton Style="{StaticResource ButtonsDropDownButton}"
                                                     Content="Sort by"
                                                     AutomationProperties.Name="Sort by">
                                <controls:DropDownButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding SortByCommand}"
                                                  CommandParameter="Name"
                                                  IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Name}"
                                                  Header="Name"
                                                  IsCheckable="True" />
                                        <MenuItem Command="{Binding SortByCommand}"
                                                  CommandParameter="Date"
                                                  IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Date}"
                                                  Header="Date"
                                                  IsCheckable="True" />
                                        <MenuItem Command="{Binding SortByCommand}"
                                                  CommandParameter="Size"
                                                  IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Size}"
                                                  Header="Size"
                                                  IsCheckable="True" />
                                    </ContextMenu>
                                </controls:DropDownButton.ContextMenu>
                            </controls:DropDownButton>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SortBy, StringFormat='Sort by: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- SplitButton -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="SplitButton" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Runs the main action or picks another one." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:SplitButton Style="{StaticResource ButtonsSplitButton}"
                                                  Command="{Binding SaveCommand}"
                                                  CommandParameter="Save"
                                                  Content="Save"
                                                  AutomationProperties.Name="Save">
                                <controls:SplitButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding SaveCommand}"
                                                  CommandParameter="Save"
                                                  Header="Save" />
                                        <MenuItem Command="{Binding SaveCommand}"
                                                  CommandParameter="Save as"
                                                  Header="Save as" />
                                        <MenuItem Command="{Binding SaveCommand}"
                                                  CommandParameter="Save all"
                                                  Header="Save all" />
                                    </ContextMenu>
                                </controls:SplitButton.ContextMenu>
                            </controls:SplitButton>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding LastAction, StringFormat='Last action: {0}', TargetNullValue='Last action: -'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
