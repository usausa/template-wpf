<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.BasicInput"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.BasicInput.ChoicesView"
             s:DataContextResolver.Type="{x:Type module:ChoicesViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ChoicesViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <s:ParameterEqualsConverter x:Key="ParameterEqualsConverter" />
        <s:MapToTextConverter x:Key="CheckStateToTextConverter"
                              DefaultValue="Indeterminate">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{s:Bool True}"
                                  Value="On" />
                <s:MapToTextEntry Key="{s:Bool False}"
                                  Value="Off" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Choices" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Check boxes, toggle switches, radio buttons, combo boxes and sliders." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CheckBox -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="CheckBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Two-state and three-state check boxes." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <CheckBox IsChecked="{Binding TwoState}"
                                      Content="Two-state" />
                            <CheckBox IsChecked="{Binding ThreeState}"
                                      Content="Three-state"
                                      IsThreeState="True" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Two-state: {0} · Three-state: {1}">
                                    <Binding Path="TwoState"
                                             Converter="{StaticResource CheckStateToTextConverter}" />
                                    <Binding Path="ThreeState"
                                             Converter="{StaticResource CheckStateToTextConverter}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- RadioButton -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="RadioButton" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick one of the options." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <RadioButton IsChecked="{Binding Size, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Small}"
                                         Content="Small" />
                            <RadioButton IsChecked="{Binding Size, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Medium}"
                                         Content="Medium" />
                            <RadioButton IsChecked="{Binding Size, Converter={StaticResource ParameterEqualsConverter}, ConverterParameter=Large}"
                                         Content="Large" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Size, StringFormat='Selected: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- ComboBox -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ComboBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick an item from a list." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <ComboBox Style="{StaticResource SampleComboBox}"
                                      ItemsSource="{Binding Fruits}"
                                      SelectedItem="{Binding Fruit}"
                                      AutomationProperties.Name="Fruit" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Fruit, StringFormat='Selected: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Slider -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Slider" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Pick a value from a range." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Slider Style="{StaticResource SampleSlider}"
                                    Value="{Binding Value}"
                                    Minimum="0" Maximum="100"
                                    AutomationProperties.Name="Value" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Value, StringFormat='Value: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- ToggleSwitch -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ToggleSwitch" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Turn an option on or off." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:ToggleSwitch IsChecked="{Binding IsSwitchOn}"
                                                   AutomationProperties.Name="Toggle switch" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding IsSwitchOn, Converter={s:BoolToText True=On, False=Off}, StringFormat='State: {0}'}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
