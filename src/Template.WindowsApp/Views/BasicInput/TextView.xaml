<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.BasicInput"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.BasicInput.TextView"
             s:DataContextResolver.Type="{x:Type module:TextViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:TextViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- PasswordBox -->

        <Style x:Key="TextPasswordBox"
               TargetType="{x:Type PasswordBox}"
               BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Multi-line -->

        <Style x:Key="TextMultiLineTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="96" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- RichTextBox -->

        <Style x:Key="TextRichTextBox"
               TargetType="{x:Type RichTextBox}"
               BasedOn="{StaticResource {x:Type RichTextBox}}">
            <Setter Property="Height" Value="96" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- NumberBox -->

        <Style x:Key="TextNumberBox"
               TargetType="{x:Type controls:NumberBox}">
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- AutoSuggestBox -->

        <Style x:Key="TextAutoSuggestBox"
               TargetType="{x:Type controls:AutoSuggestBox}">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="TextCityNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Search box -->

        <Style x:Key="TextCustomerNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TextCustomerCompanyTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="TextCustomerResultTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Text">
                <Setter.Value>
                    <MultiBinding StringFormat="Customer: {0} · {1} · {2}">
                        <Binding Path="SelectedCustomer.Name"
                                 FallbackValue="-" />
                        <Binding Path="SelectedCustomer.Company"
                                 FallbackValue="-" />
                        <Binding Path="SelectedCustomer.City"
                                 FallbackValue="-" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCustomer}"
                             Value="{x:Null}">
                    <Setter Property="Text" Value="{Binding CustomerQuery, StringFormat='No customer matches \'{0}\'', TargetNullValue='Customer: none'}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Text" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Text boxes, password boxes, number boxes, auto-suggest boxes and rich text." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TextBox -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="TextBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Single-line input with a hint." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Style="{StaticResource SampleWideTextBox}"
                                     behaviors:TextBoxOption.PlaceholderText="Type here"
                                     Text="{Binding SingleLineText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Single-line text" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SingleLineText.Length, StringFormat='Length: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- PasswordBox -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="PasswordBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Hidden input." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource TextPasswordBox}"
                                         behaviors:PasswordBoxOption.IsCapsLockWarningEnabled="True" behaviors:PasswordBoxOption.IsRevealButtonEnabled="True"
                                         AutomationProperties.Name="Password">
                                <i:Interaction.Triggers>
                                    <s:EventRequestTrigger Request="{Binding ClearPasswordRequest}">
                                        <i:CallMethodAction MethodName="Clear" />
                                    </s:EventRequestTrigger>
                                </i:Interaction.Triggers>
                            </PasswordBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Password.Length, ElementName=PasswordInput, StringFormat='Length: {0}'}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PasswordChanged"
                                                SourceObject="{Binding ElementName=PasswordInput}">
                                    <s:UpdateTargetAction PropertyName="Text" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Multi-line -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Multi-line" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Multiple lines of text." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Style="{StaticResource TextMultiLineTextBox}"
                                     Text="{Binding MultiLineText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AutomationProperties.Name="Multi-line text" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding LineCount, StringFormat='Lines: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- RichTextBox -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="RichTextBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Formatted text." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <RichTextBox Style="{StaticResource TextRichTextBox}"
                                         AutomationProperties.Name="Rich text">
                                <FlowDocument>
                                    <Paragraph xml:space="preserve">Rich text with <Bold>bold</Bold>, <Italic>italic</Italic> and <Underline>underline</Underline>.</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Read-only -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Read-only" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Text that cannot be changed." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <TextBox Style="{StaticResource SampleWideTextBox}"
                                     Text="This text is read-only."
                                     AutomationProperties.Name="Read-only text" IsReadOnly="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- NumberBox -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="NumberBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Number input with spin buttons." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:NumberBox Style="{StaticResource TextNumberBox}"
                                                Value="{Binding Number}"
                                                Minimum="0" Maximum="100"
                                                AutomationProperties.Name="Number" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Number, StringFormat='Value: {0}', TargetNullValue='Value: none'}" />
                    </StackPanel>
                </Border>

                <!-- AutoSuggestBox -->
                <Border Grid.Row="3" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="AutoSuggestBox" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Suggestions while you type." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:AutoSuggestBox Style="{StaticResource TextAutoSuggestBox}"
                                                     ItemsSource="{Binding CitySuggestions}"
                                                     Text="{Binding CityText}"
                                                     PlaceholderText="Type a city"
                                                     NoResultsText="No results found"
                                                     QuerySubmittedCommand="{Binding SubmitCityCommand}"
                                                     AutomationProperties.Name="City">
                                <controls:AutoSuggestBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type module:CitySuggestion}">
                                        <TextBlock Style="{StaticResource TextCityNameTextBlock}"
                                                   behaviors:TextBlockOption.Runs="{Binding NameRuns}" />
                                    </DataTemplate>
                                </controls:AutoSuggestBox.ItemTemplate>
                            </controls:AutoSuggestBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding SelectedCity, StringFormat='Selected: {0}', TargetNullValue='Selected: none'}" />
                    </StackPanel>
                </Border>

                <!-- Search box -->
                <Border Grid.Row="3" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Search box" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Press Enter or the search button to find a customer." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:AutoSuggestBox Style="{StaticResource TextAutoSuggestBox}"
                                                     ItemsSource="{Binding CustomerSuggestions}"
                                                     Text="{Binding CustomerText}"
                                                     PlaceholderText="Search customers"
                                                     QueryIcon="&#xE721;"
                                                     NoResultsText="No results found"
                                                     QuerySubmittedCommand="{Binding SubmitCustomerCommand}"
                                                     AutomationProperties.Name="Customer">
                                <controls:AutoSuggestBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type module:CustomerSuggestion}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource TextCustomerNameTextBlock}"
                                                       behaviors:TextBlockOption.Runs="{Binding NameRuns}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource TextCustomerCompanyTextBlock}"
                                                       behaviors:TextBlockOption.Runs="{Binding CompanyRuns}" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:AutoSuggestBox.ItemTemplate>
                            </controls:AutoSuggestBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource TextCustomerResultTextBlock}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
