<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Platform"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Platform.ClipboardDragView"
             s:DataContextResolver.Type="{x:Type module:ClipboardDragViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ClipboardDragViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="ImageFrameStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Height" Value="120" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="FormatNameTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FormatValueTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DragChipStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DropAreaStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Height" Value="120" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="behaviors:DropBehavior.IsDragOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                       Text="Clipboard &amp; drag" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Copy and paste text and images, and drag and drop files." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Text" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Copy text to the clipboard and paste it back."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <TextBox Width="320"
                                     HorizontalAlignment="Left"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Clipboard text" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Button Command="{Binding CopyTextCommand}"
                                        Content="Copy" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding PasteTextCommand}"
                                        Content="Paste" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding TextResult, StringFormat='Last: {0}', TargetNullValue='Last: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Image" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Copy a generated image and paste an image."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource ImageFrameStyle}">
                                    <Image Source="{Binding SampleImage}"
                                           Stretch="Uniform"
                                           StretchDirection="DownOnly" />
                                </Border>
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding CopyImageCommand}"
                                        Content="Copy image" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource ImageFrameStyle}">
                                    <Image Source="{Binding PastedImage}"
                                           Stretch="Uniform"
                                           StretchDirection="DownOnly" />
                                </Border>
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding PasteImageCommand}"
                                        Content="Paste image" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding PastedSize, StringFormat='Pasted: {0}', TargetNullValue='Pasted: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Formats" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="What the clipboard holds now."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FormatNameTextStyle}"
                                       Text="Text" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource FormatValueTextStyle}"
                                       Text="{Binding HasText, Converter={s:BoolToText True=Yes, False=No}}" />
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FormatNameTextStyle}"
                                       Text="Image" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource FormatValueTextStyle}"
                                       Text="{Binding HasImage, Converter={s:BoolToText True=Yes, False=No}}" />
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FormatNameTextStyle}"
                                       Text="Files" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Style="{StaticResource FormatValueTextStyle}"
                                       Text="{Binding HasFiles, Converter={s:BoolToText True=Yes, False=No}}" />
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource FormatNameTextStyle}"
                                       Text="Audio" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Style="{StaticResource FormatValueTextStyle}"
                                       Text="{Binding HasAudio, Converter={s:BoolToText True=Yes, False=No}}" />
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource FormatNameTextStyle}"
                                       Text="Formats" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Style="{StaticResource FormatValueTextStyle}"
                                       Text="{Binding Formats}"
                                       FontFamily="{StaticResource CodeFontFamily}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Command="{Binding RefreshCommand}"
                                    Content="Refresh" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding ClearCommand}"
                                    Content="Clear" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                   Text="Drag &amp; drop" />
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Drop files or text, or drag text out."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Style="{StaticResource SamplePanelStyle}">
                            <Border Style="{StaticResource DragChipStyle}">
                                <i:Interaction.Behaviors>
                                    <behaviors:DragSourceBehavior Text="{Binding DragText}" />
                                </i:Interaction.Behaviors>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="&#xE7C2;"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="16" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Drag me" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DropAreaStyle}"
                                    Margin="0,8,0,0">
                                <i:Interaction.Behaviors>
                                    <behaviors:DropBehavior FilesCommand="{Binding DropFilesCommand}"
                                                            TextCommand="{Binding DropTextCommand}" />
                                </i:Interaction.Behaviors>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="Drop files or text here"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <ScrollViewer MaxHeight="120"
                                          Margin="0,8,0,0"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DroppedItems}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type module:DroppedItem}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="16,0,0,0"
                                                           Text="{Binding Detail}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextStyle}"
                                   Text="{Binding DropResult, StringFormat='Dropped: {0}', TargetNullValue='Dropped: -'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
