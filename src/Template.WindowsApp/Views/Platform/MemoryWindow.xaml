<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:components="clr-namespace:Template.WindowsApp.Components"
                    xmlns:module="clr-namespace:Template.WindowsApp.Views.Platform"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.Views.Platform.MemoryWindow"
                    d:DataContext="{d:DesignInstance Type={x:Type module:MemoryWindowViewModel}}"
                    Width="360" Height="260"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    Title="Memory"
                    Icon="../../App.ico"
                    ShowIconOnTitleBar="False" Topmost="True">

    <controls:AppWindow.Resources>

        <Style x:Key="MemoryWindowRootGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,0,16,16" />
        </Style>

        <Style x:Key="MemoryWindowPeakTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MemoryWindowLineChart"
               TargetType="{x:Type controls:LineChart}">
            <Setter Property="Fill" Value="{StaticResource ChartBlueSuperLightBrush}" />
            <Setter Property="Stroke" Value="{StaticResource ChartBlueBrush}" />
            <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </controls:AppWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- Content -->
    <Grid Style="{StaticResource MemoryWindowRootGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Memory -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource MetricValueTextBlock}"
                       Text="{Binding Memory}" />
            <TextBlock Grid.Column="2"
                       Style="{StaticResource MemoryWindowPeakTextBlock}"
                       Text="{Binding PeakMemory}" />
        </Grid>

        <!-- Chart -->
        <controls:LineChart Grid.Row="2"
                            Style="{StaticResource MemoryWindowLineChart}"
                            Capacity="{x:Static components:ProcessMonitor.Capacity}"
                            Labels="{Binding MemoryLabels}"
                            Values="{Binding MemoryValues}" />

    </Grid>

</controls:AppWindow>
