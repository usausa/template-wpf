<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:services="clr-namespace:Template.WindowsApp.Services"
                    xmlns:module="clr-namespace:Template.WindowsApp.Views.Platform"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.Views.Platform.MemoryWindow"
                    d:DataContext="{d:DesignInstance Type={x:Type module:MemoryWindowViewModel}}"
                    Width="360" Height="260"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    Title="Memory"
                    Icon="../../App.ico"
                    ShowIconOnTitleBar="False" Topmost="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <TextBlock Text="{Binding Memory}"
                       FontSize="{DynamicResource TitleTextBlockFontSize}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="8,0,0,6"
                       VerticalAlignment="Bottom"
                       Text="{Binding PeakMemory}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <controls:LineChart Grid.Row="1"
                            Margin="0,8,0,0"
                            Fill="{StaticResource ChartBlueSuperLightBrush}"
                            Stroke="{StaticResource ChartBlueBrush}"
                            Capacity="{x:Static services:ProcessMonitorService.Capacity}"
                            GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            Labels="{Binding MemoryLabels}"
                            Values="{Binding MemoryValues}" />
    </Grid>

</controls:AppWindow>
