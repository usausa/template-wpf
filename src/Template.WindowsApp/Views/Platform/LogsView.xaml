<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Platform"
             xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Platform.LogsView"
             s:DataContextResolver.Type="{x:Type module:LogsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:LogsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Toolbar -->

        <Style x:Key="LogsLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LogsToggleSwitch"
               TargetType="{x:Type controls:ToggleSwitch}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Entries -->

        <Style x:Key="LogsCell"
               TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource DataGridCell}">
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style x:Key="LogsCellTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Level}" Value="Warning" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Level}" Value="Error" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Level}" Value="Fatal" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogsMessageTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource LogsCellTextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Count -->

        <Style x:Key="LogsCountTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Details -->

        <Style x:Key="LogsDetailsTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="120" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleTextBlock}"
                   Text="Logs" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageDescriptionTextBlock}"
                   Text="Recent log entries of this app." />

        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MaxWidth="240" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource SampleNarrowComboBox}"
                                  ItemsSource="{Binding Levels}"
                                  SelectedItem="{Binding Level}"
                                  AutomationProperties.Name="Level" />
                        <TextBox Grid.Column="2"
                                 behaviors:TextBoxOption.PlaceholderText="Search"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource LogsLabelTextBlock}"
                                   Text="Auto scroll" />
                        <controls:ToggleSwitch Grid.Column="2"
                                               Style="{StaticResource LogsToggleSwitch}"
                                               IsChecked="{Binding AutoScroll}"
                                               AutomationProperties.Name="Auto scroll" />
                        <Button Grid.Column="4"
                                Command="{Binding CopyCommand}"
                                Content="Copy" />
                        <Button Grid.Column="6"
                                Command="{Binding ClearCommand}"
                                Content="Clear" />
                        <controls:SplitButton Grid.Column="8"
                                              Command="{Binding WriteEntryCommand}"
                                              CommandParameter="{x:Static logging:LogLevel.Information}"
                                              Content="Write entry"
                                              AutomationProperties.Name="Write entry">
                            <controls:SplitButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding WriteEntryCommand}"
                                              CommandParameter="{x:Static logging:LogLevel.Information}"
                                              Header="Information" />
                                    <MenuItem Command="{Binding WriteEntryCommand}"
                                              CommandParameter="{x:Static logging:LogLevel.Warning}"
                                              Header="Warning" />
                                    <MenuItem Command="{Binding WriteEntryCommand}"
                                              CommandParameter="{x:Static logging:LogLevel.Error}"
                                              Header="Error" />
                                </ContextMenu>
                            </controls:SplitButton.ContextMenu>
                        </controls:SplitButton>
                    </Grid>
                </Grid>

                <!-- Entries -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedEntry}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False" AutomationProperties.Name="Log entries" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CellStyle="{StaticResource LogsCell}"
                          HeadersVisibility="Column" IsReadOnly="True">
                    <i:Interaction.Behaviors>
                        <behaviors:AutoScrollBehavior IsEnabled="{Binding AutoScroll}" />
                    </i:Interaction.Behaviors>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="110"
                                            Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                            Header="Time"
                                            ElementStyle="{StaticResource LogsCellTextBlock}" />
                        <DataGridTextColumn Width="110"
                                            Binding="{Binding Level}"
                                            Header="Level"
                                            ElementStyle="{StaticResource LogsCellTextBlock}" />
                        <DataGridTextColumn Width="200"
                                            Binding="{Binding Source}"
                                            Header="Source"
                                            ElementStyle="{StaticResource LogsCellTextBlock}" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Message}"
                                            Header="Message"
                                            ElementStyle="{StaticResource LogsMessageTextBlock}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Count -->
                <TextBlock Grid.Row="4"
                           Style="{StaticResource LogsCountTextBlock}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Showing {0} of {1}">
                            <Binding Path="ShownCount" />
                            <Binding Path="TotalCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- Details -->
                <TextBox Grid.Row="6"
                         Style="{StaticResource LogsDetailsTextBox}"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Details, Mode=OneWay}"
                         AutomationProperties.Name="Details" IsReadOnly="True" />

            </Grid>
        </Border>

    </Grid>

</UserControl>
