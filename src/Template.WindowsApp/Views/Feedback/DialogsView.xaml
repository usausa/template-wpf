<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Feedback"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Feedback.DialogsView"
             s:DataContextResolver.Type="{x:Type module:DialogsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:DialogsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="ResultTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Margin" Value="16,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RunButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Content" Value="Run" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Dialogs" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Show in-window, file and error dialogs." />

            <StackPanel Style="{StaticResource SectionPanel}">
                <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                           Text="In-window dialogs" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Confirm" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Ask yes or no." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding ConfirmResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding ConfirmCommand}"
                                AutomationProperties.Name="Run Confirm" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Notify" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Show a message." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding NotifyCommand}"
                                AutomationProperties.Name="Run Notify" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Input" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Enter a value." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding InputResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding InputCommand}"
                                AutomationProperties.Name="Run Input" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Progress" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Run a task and show its progress." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding ProgressResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding ProgressCommand}"
                                AutomationProperties.Name="Run Progress" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SectionPanel}">
                <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                           Text="Files" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Open file" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Pick a file to open." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding OpenFileResult}"
                                   ToolTip="{Binding OpenFileResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding OpenFileCommand}"
                                AutomationProperties.Name="Run Open file" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Save file" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Pick a file to save." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding SaveFileResult}"
                                   ToolTip="{Binding SaveFileResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding SaveFileCommand}"
                                AutomationProperties.Name="Run Save file" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Select folder" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Pick a folder." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ResultTextStyle}"
                                   Text="{Binding SelectFolderResult}"
                                   ToolTip="{Binding SelectFolderResult}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding SelectFolderCommand}"
                                AutomationProperties.Name="Run Select folder" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource SectionPanel}">
                <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                           Text="Errors" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                       Text="Unhandled exception" />
                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                       Text="Throw an exception to show the error window." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding UnhandledExceptionCommand}"
                                AutomationProperties.Name="Run Unhandled exception" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
