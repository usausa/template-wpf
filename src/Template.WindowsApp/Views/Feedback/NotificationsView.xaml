<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Feedback"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Feedback.NotificationsView"
             s:DataContextResolver.Type="{x:Type module:NotificationsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:NotificationsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Notifications" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Information bars and notifications that close by themselves." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Severity" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Information bars for each severity." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:InfoBar IsOpen="{Binding IsInformationalOpen}"
                                              Title="Information"
                                              Message="A new version is available."
                                              Severity="Informational" />
                            <controls:InfoBar Margin="0,8,0,0"
                                              IsOpen="{Binding IsSuccessOpen}"
                                              Title="Success"
                                              Message="Your changes were saved."
                                              Severity="Success" />
                            <controls:InfoBar Margin="0,8,0,0"
                                              IsOpen="{Binding IsWarningOpen}"
                                              Title="Warning"
                                              Message="The connection is slow."
                                              Severity="Warning" />
                            <controls:InfoBar Margin="0,8,0,0"
                                              IsOpen="{Binding IsErrorOpen}"
                                              Title="Error"
                                              Message="The file could not be opened."
                                              Severity="Error" />
                            <Button Margin="0,8,0,0"
                                    Command="{Binding ReopenCommand}"
                                    Content="Reopen" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding OpenCount, StringFormat='Open: {0}'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Action" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="An information bar with a button." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <controls:InfoBar IsOpen="{Binding IsActionOpen}"
                                              Title="Update ready"
                                              Message="Restart to finish the update."
                                              Severity="Informational">
                                <controls:InfoBar.ActionButton>
                                    <Button Command="{Binding RestartCommand}"
                                            Content="Restart" />
                                </controls:InfoBar.ActionButton>
                            </controls:InfoBar>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding LastAction, StringFormat='Action: {0}', TargetNullValue='Action: -'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Notification" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Shows a notification at the bottom right of the window." />
                        <StackPanel Style="{StaticResource SampleStack}"
                                    Orientation="Horizontal">
                            <ComboBox Width="240"
                                      ItemsSource="{Binding Severities}"
                                      SelectedItem="{Binding Severity}"
                                      AutomationProperties.Name="Severity" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding ShowCommand}"
                                    Content="Show" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding ShownCount, StringFormat='Shown: {0}'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
