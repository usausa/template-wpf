<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Feedback"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Feedback.ProgressView"
             s:DataContextResolver.Type="{x:Type module:ProgressViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ProgressViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Common -->

        <Style x:Key="ProgressSampleProgressBar"
               TargetType="{x:Type ProgressBar}"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- ProgressBar -->

        <Style x:Key="ProgressSampleSlider"
               TargetType="{x:Type Slider}"
               BasedOn="{StaticResource SampleSlider}">
            <Setter Property="Width" Value="320" />
        </Style>

        <!-- Long-running task -->

        <Style x:Key="ProgressTaskStateTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Text" Value="{Binding TaskState}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TaskState}"
                             Value="{x:Static module:TaskState.Running}">
                    <Setter Property="Text" Value="{Binding TaskProgress, StringFormat='Running: {0}%'}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Progress" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Progress bars, busy indicators and cancelable tasks." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ProgressBar -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="ProgressBar" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Shows how much of a task is done." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0"
                                         Style="{StaticResource ProgressSampleProgressBar}"
                                         Value="{Binding Value}"
                                         Maximum="100" />
                            <Slider Grid.Row="2"
                                    Style="{StaticResource ProgressSampleSlider}"
                                    Value="{Binding Value}"
                                    Minimum="0" Maximum="100"
                                    AutomationProperties.Name="Value" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding Value, StringFormat='Value: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Indeterminate -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Indeterminate" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Shows that work is in progress without a known end." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0"
                                         Style="{StaticResource ProgressSampleProgressBar}"
                                         IsIndeterminate="{Binding IsRunning}" />
                            <ToggleButton Grid.Row="2"
                                          IsChecked="{Binding IsRunning}"
                                          Content="Run" />
                        </Grid>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding IsRunning, Converter={s:BoolToText True=Running, False=Stopped}, StringFormat='State: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Busy indicator -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Busy indicator" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Shows the busy bar of the window and blocks other commands for 3 seconds." />
                        <StackPanel Style="{StaticResource SampleStack}">
                            <Button Command="{Binding BusyCommand}"
                                    Content="Run"
                                    AutomationProperties.Name="Run busy" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SampleResultTextBlock}"
                                   Text="{Binding BusyState.IsBusy, Converter={s:BoolToText True=Yes, False=No}, StringFormat='Busy: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- Long-running task -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextBlock}"
                                   Text="Long-running task" />
                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                   Text="Reports progress and can be canceled." />
                        <Grid Style="{StaticResource SampleGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0"
                                         Style="{StaticResource ProgressSampleProgressBar}"
                                         Value="{Binding TaskProgress, Mode=OneWay}"
                                         Maximum="100" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding StartCommand}"
                                        Content="Start" />
                                <Button Grid.Column="2"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel" />
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource ProgressTaskStateTextBlock}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
