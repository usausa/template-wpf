<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:shell="clr-namespace:Template.WindowsApp.Shell"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:components="clr-namespace:Template.WindowsApp.Components"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Home"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Home.HomeView"
             s:DataContextResolver.Type="{x:Type module:HomeViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:HomeViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="PageButtonPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource PageTitleTextStyle}"
                           Text="Home" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource PageDescriptionTextStyle}"
                           Text="{Binding Message}" />

                <Grid Grid.Row="2"
                      Style="{StaticResource SectionPanelStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0"
                                  Margin="0,0,-8,0"
                                  ItemsSource="{Binding Summaries}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type module:Summary}">
                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:EmojiIcon VerticalAlignment="Center"
                                                                Glyph="{Binding Emoji}"
                                                                FontSize="16" />
                                            <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{DynamicResource TitleTextBlockStyle}"
                                                   Text="{Binding Value}" />
                                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Detail}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Grid.Row="1"
                                 Rows="1"
                                 Margin="0,0,-8,0">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}"
                                           Text="Memory, last 60 seconds" />
                                <controls:LineChart Grid.Row="1"
                                                    MinHeight="80"
                                                    Margin="0,16,0,0"
                                                    Fill="{StaticResource ChartBlueSuperLightBrush}"
                                                    Stroke="{StaticResource ChartBlueBrush}"
                                                    Capacity="{x:Static components:ProcessMonitor.Capacity}"
                                                    GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Labels="{Binding MemoryLabels}"
                                                    Values="{Binding MemoryValues}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}"
                                           Text="Log entries by level" />
                                <controls:BarChart Grid.Row="1"
                                                   MinHeight="80"
                                                   Margin="0,16,0,0"
                                                   Fill="{StaticResource ChartBlueBrush}"
                                                   LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Labels="{Binding LevelLabels}"
                                                   Values="{Binding LevelValues}" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>

                <UniformGrid Grid.Row="3"
                             Rows="1"
                             Margin="0,0,-8,8">
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       Text="Favorites" />
                            <ItemsControl Margin="0,8,-8,-8"
                                          ItemsSource="{Binding Favorites}"
                                          Focusable="False"
                                          ItemsPanel="{StaticResource PageButtonPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                        <Button Margin="0,0,8,8" Padding="12,6"
                                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:EmojiIcon VerticalAlignment="Center"
                                                                    Glyph="{Binding Emoji}"
                                                                    FontSize="16" />
                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Title}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Add pages with the star in the title bar."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Favorites.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       Text="Recent pages" />
                            <ItemsControl Margin="0,8,-8,-8"
                                          ItemsSource="{Binding RecentPages}"
                                          Focusable="False"
                                          ItemsPanel="{StaticResource PageButtonPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                        <Button Margin="0,0,8,8" Padding="12,6"
                                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:EmojiIcon VerticalAlignment="Center"
                                                                    Glyph="{Binding Emoji}"
                                                                    FontSize="16" />
                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Title}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Pages you open appear here."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentPages.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Row="4"
                            Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Samples" />
                    <ItemsControl Margin="0,0,-8,0"
                                  ItemsSource="{Binding Samples}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type module:SampleEntry}">
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Margin="0,0,8,8"
                                        Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:EmojiIcon Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Glyph="{Binding Emoji}"
                                                            FontSize="24" />
                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}"
                                                       Text="{Binding Title}" />
                                            <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Description}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
