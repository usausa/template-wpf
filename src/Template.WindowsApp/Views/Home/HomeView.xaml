<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:shell="clr-namespace:Template.WindowsApp.Shell"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:components="clr-namespace:Template.WindowsApp.Components"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Home"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Home.HomeView"
             s:DataContextResolver.Type="{x:Type module:HomeViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:HomeViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Common -->

        <Style x:Key="HomeTileItemsControl"
               TargetType="{x:Type ItemsControl}"
               BasedOn="{StaticResource {x:Type ItemsControl}}">
            <Setter Property="Margin" Value="0,0,-8,0" />
        </Style>

        <Style x:Key="HomeTileBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="HomeEmojiIcon"
               TargetType="{x:Type controls:EmojiIcon}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- Summaries -->

        <Style x:Key="HomeSummaryTitleTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CardCaptionTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Charts -->

        <Style x:Key="HomeChartUniformGrid"
               TargetType="{x:Type UniformGrid}">
            <Setter Property="Margin" Value="0,0,-8,0" />
        </Style>

        <Style x:Key="HomeLineChart"
               TargetType="{x:Type controls:LineChart}">
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Fill" Value="{StaticResource ChartBlueSuperLightBrush}" />
            <Setter Property="Stroke" Value="{StaticResource ChartBlueBrush}" />
            <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HomeBarChart"
               TargetType="{x:Type controls:BarChart}">
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Fill" Value="{StaticResource ChartBlueBrush}" />
            <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Pages -->

        <ItemsPanelTemplate x:Key="PageButtonPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="HomePagesUniformGrid"
               TargetType="{x:Type UniformGrid}">
            <Setter Property="Margin" Value="0,0,-8,8" />
        </Style>

        <Style x:Key="HomePagesBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="HomePageItemsControl"
               TargetType="{x:Type ItemsControl}"
               BasedOn="{StaticResource {x:Type ItemsControl}}">
            <Setter Property="Margin" Value="0,8,-8,-8" />
        </Style>

        <Style x:Key="HomePageButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="HomePageTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeEmptyTextBlockBase"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="HomeFavoritesEmptyTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource HomeEmptyTextBlockBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorites.Count}"
                             Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeRecentEmptyTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource HomeEmptyTextBlockBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RecentPages.Count}"
                             Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Samples -->

        <Style x:Key="HomeSampleButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CardButton}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="HomeSampleEmojiIcon"
               TargetType="{x:Type controls:EmojiIcon}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="24" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Style="{StaticResource PageTitleTextBlock}"
                           Text="Home" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource PageDescriptionTextBlock}"
                           Text="{Binding Message}" />

                <Grid Grid.Row="2"
                      Style="{StaticResource SectionPanel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summaries -->
                    <ItemsControl Grid.Row="0"
                                  Style="{StaticResource HomeTileItemsControl}"
                                  ItemsSource="{Binding Summaries}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type module:Summary}">
                                <Border Style="{StaticResource HomeTileBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:EmojiIcon Grid.Column="0"
                                                                Style="{StaticResource HomeEmojiIcon}"
                                                                Glyph="{Binding Emoji}" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource HomeSummaryTitleTextBlock}"
                                                       Text="{Binding Title}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource MetricValueTextBlock}"
                                                   Text="{Binding Value}" />
                                        <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                                   Text="{Binding Detail}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Charts -->
                    <UniformGrid Grid.Row="1"
                                 Style="{StaticResource HomeChartUniformGrid}"
                                 Rows="1">
                        <Border Style="{StaticResource HomeTileBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource CardStrongTextBlock}"
                                           Text="Memory, last 60 seconds" />
                                <controls:LineChart Grid.Row="1"
                                                    Style="{StaticResource HomeLineChart}"
                                                    Capacity="{x:Static components:ProcessMonitor.Capacity}"
                                                    Labels="{Binding MemoryLabels}"
                                                    Values="{Binding MemoryValues}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HomeTileBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource CardStrongTextBlock}"
                                           Text="Log entries by level" />
                                <controls:BarChart Grid.Row="1"
                                                   Style="{StaticResource HomeBarChart}"
                                                   Labels="{Binding LevelLabels}"
                                                   Values="{Binding LevelValues}" />
                            </Grid>
                        </Border>
                    </UniformGrid>

                </Grid>

                <!-- Pages -->
                <UniformGrid Grid.Row="3"
                             Style="{StaticResource HomePagesUniformGrid}"
                             Rows="1">

                    <!-- Favorites -->
                    <Border Style="{StaticResource HomePagesBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardStrongTextBlock}"
                                       Text="Favorites" />
                            <ItemsControl Style="{StaticResource HomePageItemsControl}"
                                          ItemsSource="{Binding Favorites}"
                                          Focusable="False"
                                          ItemsPanel="{StaticResource PageButtonPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                        <Button Style="{StaticResource HomePageButton}"
                                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:EmojiIcon Grid.Column="0"
                                                                    Style="{StaticResource HomeEmojiIcon}"
                                                                    Glyph="{Binding Emoji}" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource HomePageTextBlock}"
                                                           Text="{Binding Title}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource HomeFavoritesEmptyTextBlock}"
                                       Text="Add pages with the star in the title bar." />
                        </StackPanel>
                    </Border>

                    <!-- Recent pages -->
                    <Border Style="{StaticResource HomePagesBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardStrongTextBlock}"
                                       Text="Recent pages" />
                            <ItemsControl Style="{StaticResource HomePageItemsControl}"
                                          ItemsSource="{Binding RecentPages}"
                                          Focusable="False"
                                          ItemsPanel="{StaticResource PageButtonPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                        <Button Style="{StaticResource HomePageButton}"
                                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:EmojiIcon Grid.Column="0"
                                                                    Style="{StaticResource HomeEmojiIcon}"
                                                                    Glyph="{Binding Emoji}" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource HomePageTextBlock}"
                                                           Text="{Binding Title}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource HomeRecentEmptyTextBlock}"
                                       Text="Pages you open appear here." />
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Samples -->
                <StackPanel Grid.Row="4"
                            Style="{StaticResource SectionPanel}">
                    <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                               Text="Samples" />
                    <ItemsControl Style="{StaticResource HomeTileItemsControl}"
                                  ItemsSource="{Binding Samples}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type module:SampleEntry}">
                                <Button Style="{StaticResource HomeSampleButton}"
                                        Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:EmojiIcon Grid.Column="0"
                                                            Style="{StaticResource HomeSampleEmojiIcon}"
                                                            Glyph="{Binding Emoji}" />
                                        <StackPanel Grid.Column="2"
                                                    Style="{StaticResource CardRowTitleStack}">
                                            <TextBlock Style="{StaticResource CardStrongTextBlock}"
                                                       Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource CardCaptionTextBlock}"
                                                       Text="{Binding Description}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
