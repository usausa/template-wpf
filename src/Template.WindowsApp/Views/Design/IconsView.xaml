<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Design"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Design.IconsView"
             s:DataContextResolver.Type="{x:Type module:IconsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:IconsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Search -->

        <Style x:Key="IconsHintTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- List -->

        <Style x:Key="IconsListBoxItem"
               TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource {x:Type ListBoxItem}}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:IconEntry}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>

        <Style x:Key="IconsItemGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="72" />
        </Style>

        <Style x:Key="IconsItemGlyphTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="24" />
        </Style>

        <Style x:Key="IconsItemNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Details -->

        <Style x:Key="IconsPreviewBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="IconsPreviewGlyphTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="48" />
        </Style>

        <Style x:Key="IconsCodeTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        </Style>

        <Style x:Key="IconsCopiedTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F"
                    Command="{Binding FindCommand}"
                    Modifiers="Control" />
    </UserControl.InputBindings>

    <!-- Content -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleTextBlock}"
                   Text="Icons" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageDescriptionTextBlock}"
                   Text="Segoe Fluent Icons glyphs with their names and codes." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Icons -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Row="0"
                             Style="{StaticResource SampleWideTextBox}"
                             behaviors:TextBoxOption.PlaceholderText="Search icons (Ctrl+F)"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             AutomationProperties.Name="Search icons">
                        <i:Interaction.Triggers>
                            <s:EventRequestTrigger Request="{Binding FindRequest}">
                                <s:SetFocusAction />
                                <s:SelectAllTextAction />
                            </s:EventRequestTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource IconsHintTextBlock}"
                               Text="Separate words with spaces to match all of them, or with | to match any. Codes such as E70 also match." />

                    <!-- List -->
                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedIcon}"
                             AutomationProperties.Name="Icons"
                             ItemContainerStyle="{StaticResource IconsListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding CopyNameCommand}"
                                          Header="Copy name" />
                                <MenuItem Command="{Binding CopyCodeCommand}"
                                          Header="Copy code" />
                                <MenuItem Command="{Binding CopyXamlCommand}"
                                          Header="Copy XAML" />
                                <MenuItem Command="{Binding CopyCSharpCommand}"
                                          Header="Copy C#" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type sample:IconEntry}">
                                <Grid Style="{StaticResource IconsItemGrid}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Style="{StaticResource IconsItemGlyphTextBlock}"
                                               Text="{Binding Glyph}" />
                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource IconsItemNameTextBlock}"
                                               Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pager -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource PagerRangeTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}–{1} of {2}">
                                    <Binding Path="RangeStart" />
                                    <Binding Path="RangeEnd" />
                                    <Binding Path="TotalCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding PreviousCommand}"
                                Content="&#xE76B;"
                                ToolTip="Previous page"
                                AutomationProperties.Name="Previous page" />
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Command="{Binding NextCommand}"
                                Content="&#xE76C;"
                                ToolTip="Next page"
                                AutomationProperties.Name="Next page" />
                    </Grid>

                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <ContentControl Focusable="False"
                                    Content="{Binding SelectedIcon}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type sample:IconEntry}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Style="{StaticResource IconsPreviewBorder}">
                                        <TextBlock Style="{StaticResource IconsPreviewGlyphTextBlock}"
                                                   Text="{Binding Glyph}" />
                                    </Border>
                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource CardStrongTextBlock}"
                                               Text="{Binding Name}" />
                                    <StackPanel Grid.Row="4">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                                   Text="Code" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource IconsCodeTextBlock}"
                                                       Text="{Binding Code}" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Code}"
                                                    Content="&#xE8C8;"
                                                    ToolTip="Copy"
                                                    AutomationProperties.Name="Copy code" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                                   Text="XAML" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource IconsCodeTextBlock}"
                                                       Text="{Binding Xaml}" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Xaml}"
                                                    Content="&#xE8C8;"
                                                    ToolTip="Copy"
                                                    AutomationProperties.Name="Copy XAML" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="8">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                                   Text="C#" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource IconsCodeTextBlock}"
                                                       Text="{Binding CSharp}" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding CSharp}"
                                                    Content="&#xE8C8;"
                                                    ToolTip="Copy"
                                                    AutomationProperties.Name="Copy C#" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    <TextBlock Style="{StaticResource IconsCopiedTextBlock}"
                               Text="{Binding Copied, StringFormat='Copied: {0}', TargetNullValue='Copied: -'}" />
                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>
