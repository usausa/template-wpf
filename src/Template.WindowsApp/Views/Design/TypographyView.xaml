<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Design"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Design.TypographyView"
             s:DataContextResolver.Type="{x:Type module:TypographyViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:TypographyViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Copied -->

        <Style x:Key="TypographyCopiedTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Styles -->

        <Style x:Key="TypographyHeaderTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="TypographyValueTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PageTextBlockBase}">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
        </Style>

        <Style x:Key="TypographyKeyTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TypographyValueTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Typography" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Text styles of the Fluent theme." />

            <!-- Copied -->
            <TextBlock Style="{StaticResource TypographyCopiedTextBlock}"
                       Text="{Binding Copied, StringFormat='Copied: {0}', TargetNullValue='Copied: -'}" />

            <!-- Styles -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource TypographyHeaderTextBlock}"
                               Text="Example" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource TypographyHeaderTextBlock}"
                               Text="Size" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource TypographyHeaderTextBlock}"
                               Text="Weight" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                               Style="{StaticResource TypographyHeaderTextBlock}"
                               Text="Style" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Caption" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="12" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="Regular" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="CaptionTextBlockStyle" />
                    <Button Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="CaptionTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy CaptionTextBlockStyle" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{DynamicResource BodyTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Body" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="14" />
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="Regular" />
                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="BodyTextBlockStyle" />
                    <Button Grid.Row="2" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="BodyTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy BodyTextBlockStyle" />
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{DynamicResource BodyStrongTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Body strong" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="14" />
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="BodyStrongTextBlockStyle" />
                    <Button Grid.Row="3" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="BodyStrongTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy BodyStrongTextBlockStyle" />
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Style="{DynamicResource SubtitleTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Subtitle" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="20" />
                    <TextBlock Grid.Row="4" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="SubtitleTextBlockStyle" />
                    <Button Grid.Row="4" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="SubtitleTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy SubtitleTextBlockStyle" />
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Style="{DynamicResource TitleTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Title" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="28" />
                    <TextBlock Grid.Row="5" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="SemiBold" />
                    <TextBlock Grid.Row="5" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="TitleTextBlockStyle" />
                    <Button Grid.Row="5" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="TitleTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy TitleTextBlockStyle" />
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Style="{DynamicResource TitleLargeTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Title large" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="40" />
                    <TextBlock Grid.Row="6" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="SemiBold" />
                    <TextBlock Grid.Row="6" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="TitleLargeTextBlockStyle" />
                    <Button Grid.Row="6" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="TitleLargeTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy TitleLargeTextBlockStyle" />
                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Style="{DynamicResource DisplayTextBlockStyle}"
                               Margin="0,8,16,8"
                               VerticalAlignment="Center"
                               Text="Display" />
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="68" />
                    <TextBlock Grid.Row="7" Grid.Column="2"
                               Style="{StaticResource TypographyValueTextBlock}"
                               Text="SemiBold" />
                    <TextBlock Grid.Row="7" Grid.Column="3"
                               Style="{StaticResource TypographyKeyTextBlock}"
                               Text="DisplayTextBlockStyle" />
                    <Button Grid.Row="7" Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="DisplayTextBlockStyle"
                            Content="&#xE8C8;"
                            ToolTip="Copy"
                            AutomationProperties.Name="Copy DisplayTextBlockStyle" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
