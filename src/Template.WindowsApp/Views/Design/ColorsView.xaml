<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Design"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Design.ColorsView"
             s:DataContextResolver.Type="{x:Type module:ColorsViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ColorsViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Category -->

        <Style x:Key="ColorsCategoryGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="ColorsCategoryComboBoxItem"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:ColorCategory}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <Style x:Key="ColorsCopiedTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource SampleResultTextBlock}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Groups -->

        <Style x:Key="ColorsEntryGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="ColorsBrushSwatch"
               TargetType="{x:Type controls:BrushSwatch}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ColorsNameTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CardTitleTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColorsKeyTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CardCaptionTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Colors" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Theme brushes and their resource names." />

            <!-- Category -->
            <Grid Style="{StaticResource ColorsCategoryGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Style="{StaticResource SampleComboBox}"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          AutomationProperties.Name="Category" DisplayMemberPath="Title"
                          ItemContainerStyle="{StaticResource ColorsCategoryComboBoxItem}" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource ColorsCopiedTextBlock}"
                           Text="{Binding Copied, StringFormat='Copied: {0}', TargetNullValue='Copied: -'}" />
            </Grid>

            <!-- Groups -->
            <ItemsControl ItemsSource="{Binding SelectedCategory.Groups}"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sample:ColorGroup}">
                        <StackPanel Style="{StaticResource SectionPanel}">
                            <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                                       Text="{Binding Title}" />
                            <Border Style="{StaticResource CardBorder}">
                                <ItemsControl ItemsSource="{Binding Entries}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sample:ColorEntry}">
                                            <Grid Style="{StaticResource ColorsEntryGrid}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:BrushSwatch Grid.Column="0"
                                                                      Style="{StaticResource ColorsBrushSwatch}"
                                                                      BrushKey="{Binding Key}" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource ColorsNameTextBlock}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="4"
                                                           Style="{StaticResource ColorsKeyTextBlock}"
                                                           Text="{Binding Key}" />
                                                <Button Grid.Column="6"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Key}"
                                                        Content="&#xE8C8;"
                                                        ToolTip="Copy"
                                                        AutomationProperties.Name="{Binding Key, StringFormat='Copy {0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
