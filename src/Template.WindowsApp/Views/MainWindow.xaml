<controls:AppWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="http://smart/windows"
                    xmlns:navigation="http://smart/navigation"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:shell="clr-namespace:Template.WindowsApp.Shell"
                    xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
                    xmlns:services="clr-namespace:Template.WindowsApp.Services"
                    xmlns:views="clr-namespace:Template.WindowsApp.Views"
                    mc:Ignorable="d"
                    x:Class="Template.WindowsApp.Views.MainWindow"
                    s:DataContextResolver.Type="{x:Type views:MainWindowViewModel}"
                    d:DataContext="{d:DesignInstance Type={x:Type views:MainWindowViewModel}}"
                    Width="1280" Height="960" MinWidth="1024" MinHeight="768"
                    Title="MainWindow"
                    Icon="../App.ico"
                    ShowIconOnTitleBar="False">

    <controls:AppWindow.Resources>
        <Style x:Key="SideBarButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid d:DataContext="{d:DesignInstance Type={x:Type shell:NavigationItem}}"
                              Background="{TemplateBinding Background}">
                            <Border Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Icon}"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="16" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Title}"
                                           FontSize="14" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideBarChildButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SideBarButtonStyle}">
            <Setter Property="Padding" Value="31,0,0,0" />
        </Style>

        <Style x:Key="SideBarGroupButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandBoxStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0.15" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        Opacity="0.7">
                                <TextBlock VerticalAlignment="Center"
                                           Text="&#xE721;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="12" />
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Selection"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Indicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:AppWindow.Resources>

    <controls:AppWindow.InputBindings>
        <KeyBinding Command="{Binding OpenPaletteCommand}"
                    Gesture="Ctrl+Shift+P" />
    </controls:AppWindow.InputBindings>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <s:CancelEventAction Cancel="{Binding BusyState.IsBusy}" />
            <i:CallMethodAction IsEnabled="{Binding BusyState.IsBusy, Converter={StaticResource ReverseConverter}}"
                                MethodName="Save"
                                TargetObject="{Binding WindowManager}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <s:DataContextDisposeAction />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <controls:AppWindow.LeftHeader>
        <ToggleButton Style="{StaticResource TitleBarButtonStyle}"
                      Width="48"
                      IsChecked="{Binding WindowManager.IsPaneOpen}"
                      Content="&#xE700;"
                      FontFamily="{DynamicResource SymbolThemeFontFamily}"
                      FontSize="16"
                      AutomationProperties.Name="Navigation" />
    </controls:AppWindow.LeftHeader>

    <controls:AppWindow.TitleBarContent>
        <Button Style="{StaticResource CommandBoxStyle}"
                Width="400" Height="32"
                Command="{Binding OpenPaletteCommand}"
                Content="Search commands (Ctrl+Shift+P)"
                FontSize="12" />
    </controls:AppWindow.TitleBarContent>

    <controls:AppWindow.RightHeader>
        <Button Style="{StaticResource TitleBarButtonStyle}"
                Width="64"
                Command="{Binding ExecuteCommand}"
                Content="Execute" />
    </controls:AppWindow.RightHeader>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="48" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowManager.IsPaneOpen}"
                                     Value="True">
                            <Setter Property="Width" Value="200" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Resources>
                <DataTemplate DataType="{x:Type shell:NavigationItem}">
                    <Button Style="{StaticResource SideBarButtonStyle}"
                            Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="{Binding Title}"
                            AutomationProperties.Name="{Binding Title}"
                            ToolTipService.IsEnabled="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ReverseConverter}}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:NavigationGroup}">
                    <StackPanel>
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChildSelected}" Value="True" />
                                                    <Condition Binding="{Binding IsExpanded}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChildSelected}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Border Width="3" Height="16"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <Button Style="{StaticResource SideBarGroupButtonStyle}"
                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}"
                                    ToolTipService.IsEnabled="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ReverseConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Icon}"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="16" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="&#xE70D;"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="8"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}"
                                                                 Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}"
                                      Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="{x:Type ItemsControl}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding DataContext.WindowManager.IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                    <Button Style="{StaticResource SideBarChildButtonStyle}"
                                            Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding Id}"
                                            AutomationProperties.Name="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </Border.Resources>
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Menu.Items}"
                                  Focusable="False" />
                </ScrollViewer>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Menu.FooterItems}"
                              Focusable="False" />
            </Grid>
        </Border>

        <Canvas Grid.Column="1"
                navigation:NavigationContainer.Navigator="{Binding Navigator}"
                ClipToBounds="True" />

        <ProgressBar Grid.Column="0" Grid.ColumnSpan="2"
                     VerticalAlignment="Bottom"
                     IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="{x:Type ProgressBar}"
                       BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding BusyState.IsBusy}" Value="True" />
                                <Condition Binding="{Binding IsNavigating}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <ItemsControl Grid.Column="1"
                      Width="360"
                      Margin="24"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      ItemsSource="{Binding Notifications.Items}"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:Notification}">
                    <Border Margin="0,8,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <controls:InfoBar Title="{Binding Title}"
                                          CloseButtonCommand="{Binding DataContext.CloseNotificationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          CloseButtonCommandParameter="{Binding}"
                                          Message="{Binding Message}"
                                          Severity="{Binding Severity}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <FrameworkElement x:Name="PaletteAnchor"
                          Grid.Column="0" Grid.ColumnSpan="2"
                          Width="600"
                          HorizontalAlignment="Center" VerticalAlignment="Top" />

        <Popup Grid.Column="0"
               IsOpen="{Binding Palette.IsOpen}"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=PaletteAnchor}"
               StaysOpen="False" VerticalOffset="-40">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Opened">
                    <s:SetFocusAction TargetObject="{Binding ElementName=CommandText}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Border Width="600"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="CommandText"
                                 Height="32"
                                 Text="{Binding Palette.Text, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Command text">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Up"
                                            Command="{Binding MovePaletteCommand}"
                                            CommandParameter="{x:Static shell:CommandPaletteMove.Previous}" />
                                <KeyBinding Key="Down"
                                            Command="{Binding MovePaletteCommand}"
                                            CommandParameter="{x:Static shell:CommandPaletteMove.Next}" />
                                <KeyBinding Key="PageUp"
                                            Command="{Binding MovePaletteCommand}"
                                            CommandParameter="{x:Static shell:CommandPaletteMove.PreviousPage}" />
                                <KeyBinding Key="PageDown"
                                            Command="{Binding MovePaletteCommand}"
                                            CommandParameter="{x:Static shell:CommandPaletteMove.NextPage}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding ExecutePaletteCommand}" />
                                <KeyBinding Key="Escape"
                                            Command="{Binding ClosePaletteCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Type to search"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CommandText}"
                                                     Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox MaxHeight="360"
                             Padding="0"
                             ItemsSource="{Binding Palette.Candidates}"
                             Focusable="False"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CommandItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedIndex="{Binding Palette.SelectedIndex}">
                        <i:Interaction.Behaviors>
                            <behaviors:ScrollIntoSelectedItemBehavior />
                        </i:Interaction.Behaviors>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type shell:ShellCommand}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonUp">
                                            <i:InvokeCommandAction Command="{Binding DataContext.ExecutePaletteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Icon}"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="16" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Category}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="12,8,12,8"
                               Text="No matching commands"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Palette.Candidates.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>

</controls:AppWindow>
