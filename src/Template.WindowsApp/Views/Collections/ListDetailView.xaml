<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Collections"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Collections.ListDetailView"
             s:DataContextResolver.Type="{x:Type module:ListDetailViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:ListDetailViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <!-- Content -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleTextBlock}"
                   Text="List &amp; detail" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageDescriptionTextBlock}"
                   Text="Select a customer to view and edit the details." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AddCommand}"
                                Content="&#xE710;"
                                ToolTip="Add"
                                AutomationProperties.Name="Add" />
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding DeleteCommand}"
                                Content="&#xE74D;"
                                ToolTip="Delete"
                                AutomationProperties.Name="Delete" />
                    </Grid>
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              AutomationProperties.Name="Customers" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="140"
                                                Header="Name"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Width="140"
                                                Header="Company"
                                                DisplayMemberBinding="{Binding Company}" />
                                <GridViewColumn Width="110"
                                                Header="City"
                                                DisplayMemberBinding="{Binding City}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorder}">
                <Grid IsEnabled="{Binding SelectedCustomer, Converter={s:NullToBool Invert=True}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                   Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Name" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                   Text="Company" />
                        <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Company" />
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                   Text="Email" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Email" />
                    </StackPanel>
                    <StackPanel Grid.Row="6">
                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                   Text="Phone" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Phone" />
                    </StackPanel>
                    <StackPanel Grid.Row="8">
                        <TextBlock Style="{StaticResource FieldLabelTextBlock}"
                                   Text="City" />
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="City" />
                    </StackPanel>

                    <!-- Action -->
                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}"
                                Content="Save" />
                        <Button Grid.Column="2"
                                Command="{Binding CancelCommand}"
                                Content="Cancel" />
                    </Grid>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
