<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:converters="clr-namespace:Template.WindowsApp.Converters"
             xmlns:models="clr-namespace:Template.WindowsApp.Models"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Collections"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Collections.DataGridView"
             s:DataContextResolver.Type="{x:Type module:DataGridViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:DataGridViewModel}}"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- Converter -->

        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:ShortDateConverter x:Key="ShortDateConverter" />

        <!-- Toolbar -->

        <Style x:Key="ProductColumnMenuItem"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource {x:Type MenuItem}}"
               d:DataContext="{d:DesignInstance Type={x:Type models:DataGridColumnSetting}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsVisible}" />
            <Setter Property="IsEnabled" Value="{Binding CanHide}" />
            <Setter Property="StaysOpenOnClick" Value="True" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <ScrollViewer Style="{StaticResource RootScroll}"
                  Focusable="False">
        <StackPanel Style="{StaticResource PageStack}">

            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="Data grid" />
            <TextBlock Style="{StaticResource PageDescriptionTextBlock}"
                       Text="Sort, filter, edit and page through products, and choose, freeze and resize the columns." />

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource SampleTextBox}"
                                 behaviors:TextBoxOption.PlaceholderText="Search"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search" />
                        <controls:DropDownButton Grid.Column="2"
                                                 Content="Columns"
                                                 AutomationProperties.Name="Columns">
                            <controls:DropDownButton.ContextMenu>
                                <ContextMenu ItemsSource="{Binding Columns}"
                                             ItemContainerStyle="{StaticResource ProductColumnMenuItem}" />
                            </controls:DropDownButton.ContextMenu>
                        </controls:DropDownButton>
                        <CheckBox Grid.Column="4"
                                  IsChecked="{Binding IsFrozen}"
                                  Content="Freeze Code and Name" />
                        <Button Grid.Column="6"
                                Command="{Binding ResetColumnsCommand}"
                                Content="Reset columns" />
                    </Grid>

                    <!-- Products -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False" AutomationProperties.Name="Products" CanUserAddRows="False" CanUserDeleteRows="False"
                              CellStyle="{StaticResource DataGridCell}"
                              FrozenColumnCount="{Binding FrozenColumnCount}"
                              HeadersVisibility="Column">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridSortBehavior Sort="{Binding Sort}" />
                            <behaviors:CommitEditOnLostFocusBehavior />
                            <behaviors:DataGridRowCommitBehavior Command="{Binding UpdateCommand}" />
                            <behaviors:DataGridColumnLayoutBehavior Columns="{Binding Columns}" />
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding Code}"
                                                Header="Code"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Width="240"
                                                Binding="{Binding Name}"
                                                Header="Name"
                                                EditingElementStyle="{StaticResource DataGridEditingTextBox}" />
                            <DataGridComboBoxColumn Width="120"
                                                    ItemsSource="{x:Static module:DataGridViewModel.Categories}"
                                                    Header="Category"
                                                    EditingElementStyle="{StaticResource DataGridEditingComboBox}"
                                                    SelectedItemBinding="{Binding Category}"
                                                    SortMemberPath="Category" />
                            <DataGridTextColumn Width="140"
                                                Binding="{Binding Supplier}"
                                                Header="Supplier"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Width="110"
                                                Binding="{Binding Warehouse}"
                                                Header="Warehouse"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Width="100"
                                                Binding="{Binding Price, Converter={StaticResource CurrencyConverter}}"
                                                Header="Price"
                                                EditingElementStyle="{StaticResource DataGridNumberEditingTextBox}"
                                                ElementStyle="{StaticResource DataGridNumberTextBlock}" />
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding Stock, TargetNullValue=-}"
                                                Header="Stock"
                                                EditingElementStyle="{StaticResource DataGridNumberEditingTextBox}"
                                                ElementStyle="{StaticResource DataGridNumberTextBlock}" />
                            <DataGridTextColumn Width="110"
                                                Binding="{Binding Updated, Converter={StaticResource ShortDateConverter}}"
                                                Header="Updated"
                                                IsReadOnly="True" SortMemberPath="Updated" />
                            <DataGridCheckBoxColumn Width="72"
                                                    Binding="{Binding IsActive}"
                                                    Header="Active" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pager -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource PagerRangeTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}–{1} of {2}">
                                    <Binding Path="RangeStart" />
                                    <Binding Path="RangeEnd" />
                                    <Binding Path="TotalCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding PreviousCommand}"
                                Content="&#xE76B;"
                                ToolTip="Previous page"
                                AutomationProperties.Name="Previous page" />
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Command="{Binding NextCommand}"
                                Content="&#xE76C;"
                                ToolTip="Next page"
                                AutomationProperties.Name="Next page" />
                    </Grid>

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
