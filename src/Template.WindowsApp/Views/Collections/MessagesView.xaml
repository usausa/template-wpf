<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/windows"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
             xmlns:controls="clr-namespace:Template.WindowsApp.Controls"
             xmlns:sample="clr-namespace:Template.WindowsApp.Models.Sample"
             xmlns:module="clr-namespace:Template.WindowsApp.Views.Collections"
             mc:Ignorable="d"
             x:Class="Template.WindowsApp.Views.Collections.MessagesView"
             s:DataContextResolver.Type="{x:Type module:MessagesViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type module:MessagesViewModel}}"
             d:DesignWidth="1000" d:DesignHeight="800">

    <UserControl.Resources>

        <!-- Color -->

        <SolidColorBrush x:Key="AvatarPurpleBrush"
                         Color="#8F3BB8" />
        <SolidColorBrush x:Key="AvatarGreenBrush"
                         Color="#37872D" />
        <SolidColorBrush x:Key="AvatarOrangeBrush"
                         Color="#FA6400" />
        <SolidColorBrush x:Key="AvatarBlueBrush"
                         Color="#1F60C4" />

        <!-- Converter -->

        <s:CompareToBoolConverter x:Key="NarrowConverter"
                                  Expression="{x:Static s:CompareExpressions.LessThan}"
                                  TrueValue="True"
                                  FalseValue="False" />

        <!-- Layout -->

        <Style x:Key="MessagesCardBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="MessagesListPaneBorder"
               TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="MessagesConversationListBox"
               TargetType="{x:Type ListBox}"
               BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Padding" Value="0,4,0,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="MessagesMainPaneGrid"
               TargetType="{x:Type Grid}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsThreadOpen}" Value="True" />
                        <Condition Binding="{Binding ActualWidth, ElementName=Card, Converter={StaticResource NarrowConverter}, ConverterParameter=920}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,320,0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsThreadOpen}" Value="True" />
                        <Condition Binding="{Binding ActualWidth, ElementName=Card, Converter={StaticResource NarrowConverter}, ConverterParameter=920}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Hidden" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessagesHeaderPresenter"
               TargetType="{x:Type ContentPresenter}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MessagesMessageItemsControl"
               TargetType="{x:Type ItemsControl}">
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>

        <Style x:Key="MessagesThreadPaneBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Card, Converter={StaticResource NarrowConverter}, ConverterParameter=920}"
                             Value="True">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsThreadOpen}"
                             Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessagesThreadTitleStack"
               TargetType="{x:Type StackPanel}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MessagesThreadStack"
               TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0,16,0,12" />
        </Style>

        <Style x:Key="MessagesThreadRepliesGrid"
               TargetType="{x:Type Grid}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Message}}">
            <Setter Property="Margin" Value="16,8,16,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Replies.Count}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Avatar -->

        <Style x:Key="MessagesAvatarBorder"
               TargetType="{x:Type Border}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Person}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{StaticResource AvatarPurpleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Color}"
                             Value="Green">
                    <Setter Property="Background" Value="{StaticResource AvatarGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}"
                             Value="Orange">
                    <Setter Property="Background" Value="{StaticResource AvatarOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}"
                             Value="Blue">
                    <Setter Property="Background" Value="{StaticResource AvatarBlueBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessagesSmallAvatarBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource MessagesAvatarBorder}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style x:Key="MessagesReplierAvatarBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource MessagesSmallAvatarBorder}">
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="MessagesAvatarTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="MessagesSmallAvatarTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MessagesAvatarTextBlock}">
            <Setter Property="FontSize" Value="9" />
        </Style>
        <Style x:Key="MessagesPresenceBorder"
               TargetType="{x:Type Border}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Person}}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,-4,-4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}"
                             Value="Away">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessagesSmallPresenceBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource MessagesPresenceBorder}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,-3,-3" />
        </Style>
        <DataTemplate x:Key="AvatarTemplate"
                      DataType="{x:Type sample:Person}">
            <Grid>
                <Border Style="{StaticResource MessagesAvatarBorder}">
                    <TextBlock Style="{StaticResource MessagesAvatarTextBlock}"
                               Text="{Binding Initials}" />
                </Border>
                <Border Style="{StaticResource MessagesPresenceBorder}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ListAvatarTemplate"
                      DataType="{x:Type sample:Person}">
            <Grid>
                <Border Style="{StaticResource MessagesSmallAvatarBorder}">
                    <TextBlock Style="{StaticResource MessagesSmallAvatarTextBlock}"
                               Text="{Binding Initials}" />
                </Border>
                <Border Style="{StaticResource MessagesSmallPresenceBorder}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ReplierTemplate"
                      DataType="{x:Type sample:Person}">
            <Border Style="{StaticResource MessagesReplierAvatarBorder}">
                <TextBlock Style="{StaticResource MessagesSmallAvatarTextBlock}"
                           Text="{Binding Initials}" />
            </Border>
        </DataTemplate>

        <!-- Conversations -->

        <CollectionViewSource x:Key="ConversationSource"
                              Source="{Binding Conversations}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Kind" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="MessagesPaneHeaderTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="16,12,16,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="GroupHeaderTemplate"
                      DataType="{x:Type CollectionViewGroup}">
            <TextBlock x:Name="Header"
                       Style="{StaticResource MessagesPaneHeaderTextBlock}"
                       Text="Channels" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}"
                             Value="Direct">
                    <Setter TargetName="Header" Property="Margin" Value="16,20,16,6" />
                    <Setter TargetName="Header" Property="Text" Value="Direct messages" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="MessagesGroupItem"
               TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <ContentPresenter />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MessagesConversationListBoxItem"
               TargetType="{x:Type ListBoxItem}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Conversation}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Selection"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Indicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UnreadCount}"
                             Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessagesConversationGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="MessagesConversationNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="MessagesChannelNameTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MessagesConversationNameTextBlock}">
            <Setter Property="Margin" Value="16,0,8,0" />
        </Style>

        <Style x:Key="MessagesDirectGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,0,8,0" />
        </Style>

        <Style x:Key="MessagesDirectAvatarPresenter"
               TargetType="{x:Type ContentPresenter}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MessagesUnreadBadgeBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CountBadgeBorder}">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <DataTemplate x:Key="ConversationTemplate"
                      DataType="{x:Type sample:Conversation}">
            <Grid x:Name="Row"
                  Style="{StaticResource MessagesConversationGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChannelName"
                           Grid.Column="0"
                           Style="{StaticResource MessagesChannelNameTextBlock}"
                           Text="{Binding Name, StringFormat='# {0}'}" />
                <Grid x:Name="Direct"
                      Grid.Column="0"
                      Style="{StaticResource MessagesDirectGrid}"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Style="{StaticResource MessagesDirectAvatarPresenter}"
                                      Content="{Binding Person}"
                                      ContentTemplate="{StaticResource ListAvatarTemplate}" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource MessagesConversationNameTextBlock}"
                               Text="{Binding Name}" />
                </Grid>
                <Border x:Name="Badge"
                        Grid.Column="1"
                        Style="{StaticResource MessagesUnreadBadgeBorder}">
                    <TextBlock Style="{StaticResource CountBadgeTextBlock}"
                               Text="{Binding UnreadCount}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Direct">
                    <Setter TargetName="Row" Property="Height" Value="36" />
                    <Setter TargetName="ChannelName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Direct" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UnreadCount}"
                             Value="0">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Header -->

        <Style x:Key="MessagesHeaderBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="MessagesHeaderTitleTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MessagesHeaderCaptionTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MessagesPresenceMarkBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <DataTemplate x:Key="ConversationHeaderTemplate"
                      DataType="{x:Type sample:Conversation}">
            <Grid>
                <StackPanel x:Name="Channel">
                    <TextBlock Style="{StaticResource MessagesHeaderTitleTextBlock}"
                               Text="{Binding Name, StringFormat='# {0}'}" />
                    <TextBlock Style="{StaticResource MessagesHeaderCaptionTextBlock}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} members · {1}">
                                <Binding Path="Members" />
                                <Binding Path="Description" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <ContentControl Focusable="False"
                                Content="{Binding Person}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type sample:Person}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MessagesHeaderTitleTextBlock}"
                                           Text="{Binding Name}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PresenceMark"
                                            Grid.Column="0"
                                            Style="{StaticResource MessagesPresenceMarkBorder}" />
                                    <TextBlock x:Name="PresenceText"
                                               Grid.Column="2"
                                               Style="{StaticResource MessagesHeaderCaptionTextBlock}"
                                               Text="Active" />
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Presence}"
                                             Value="Away">
                                    <Setter TargetName="PresenceMark" Property="Background" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                                    <Setter TargetName="PresenceText" Property="Text" Value="Away" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Direct">
                    <Setter TargetName="Channel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ThreadCaptionTemplate"
                      DataType="{x:Type sample:Conversation}">
            <TextBlock x:Name="Caption"
                       Style="{StaticResource MessagesHeaderCaptionTextBlock}"
                       Text="{Binding Name, StringFormat='# {0}'}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Direct">
                    <Setter TargetName="Caption" Property="Text" Value="{Binding Name}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Action -->

        <Style x:Key="MessagesSubtleIconButton"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MessagesCloseThreadButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MessagesSubtleIconButton}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MessagesAddReactionDropDownButton"
               TargetType="{x:Type controls:DropDownButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Setter Property="ToolTip" Value="Add reaction" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:DropDownButton}">
                        <Button x:Name="PART_Button"
                                Style="{StaticResource MessagesSubtleIconButton}"
                                Focusable="False"
                                Content="&#xF353;"
                                AutomationProperties.Name="Add reaction" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MessagesMenuEmojiIcon"
               TargetType="{x:Type controls:EmojiIcon}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <ContextMenu x:Key="ReactionMenu"
                     DataContext="{Binding PlacementTarget.(FrameworkElement.Tag), RelativeSource={RelativeSource Self}}"
                     d:DataContext="{d:DesignInstance Type={x:Type module:MessagesViewModel}}"
                     x:Shared="False">
            <MenuItem Command="{Binding LikeCommand}"
                      CommandParameter="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                      Header="Like">
                <MenuItem.Icon>
                    <controls:EmojiIcon Style="{StaticResource MessagesMenuEmojiIcon}"
                                        Glyph="&#x1F44D;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding HeartCommand}"
                      CommandParameter="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                      Header="Heart">
                <MenuItem.Icon>
                    <controls:EmojiIcon Style="{StaticResource MessagesMenuEmojiIcon}"
                                        Glyph="&#x2764;&#xFE0F;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding AcceptCommand}"
                      CommandParameter="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                      Header="Accept">
                <MenuItem.Icon>
                    <controls:EmojiIcon Style="{StaticResource MessagesMenuEmojiIcon}"
                                        Glyph="&#x2705;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding LaughCommand}"
                      CommandParameter="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                      Header="Laugh">
                <MenuItem.Icon>
                    <controls:EmojiIcon Style="{StaticResource MessagesMenuEmojiIcon}"
                                        Glyph="&#x1F604;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="MessagesActionsBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,-16,24,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- Reaction -->

        <Style x:Key="MessagesReactionButton"
               TargetType="{x:Type Button}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Reaction}}">
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="ToolTip" Value="Like" />
            <Setter Property="AutomationProperties.Name" Value="Like" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Heart">
                    <Setter Property="ToolTip" Value="Heart" />
                    <Setter Property="AutomationProperties.Name" Value="Heart" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Accept">
                    <Setter Property="ToolTip" Value="Accept" />
                    <Setter Property="AutomationProperties.Name" Value="Accept" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Laugh">
                    <Setter Property="ToolTip" Value="Laugh" />
                    <Setter Property="AutomationProperties.Name" Value="Laugh" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMine}"
                             Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessagesReactionEmojiIcon"
               TargetType="{x:Type controls:EmojiIcon}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="MessagesReactionCountTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="ReactionTemplate"
                      DataType="{x:Type sample:Reaction}">
            <Button Style="{StaticResource MessagesReactionButton}"
                    Command="{Binding DataContext.ToggleReactionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:EmojiIcon x:Name="Glyph"
                                        Grid.Column="0"
                                        Style="{StaticResource MessagesReactionEmojiIcon}"
                                        Glyph="&#x1F44D;" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource MessagesReactionCountTextBlock}"
                               Text="{Binding Count}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Heart">
                    <Setter TargetName="Glyph" Property="Glyph" Value="&#x2764;&#xFE0F;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Accept">
                    <Setter TargetName="Glyph" Property="Glyph" Value="&#x2705;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Laugh">
                    <Setter TargetName="Glyph" Property="Glyph" Value="&#x1F604;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="MessagesReactionsItemsControl"
               TargetType="{x:Type ItemsControl}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource ReactionTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reply summary -->

        <Style x:Key="MessagesReplyCountTextBlock"
               TargetType="{x:Type TextBlock}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Message}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="{Binding Replies.Count, StringFormat='{}{0} replies'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Replies.Count}"
                             Value="1">
                    <Setter Property="Text" Value="1 reply" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessagesThreadReplyCountTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MessagesReplyCountTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MessagesReplySummaryButton"
               TargetType="{x:Type Button}"
               d:DataContext="{d:DesignInstance Type={x:Type sample:Message}}">
            <Setter Property="Margin" Value="-4,4,0,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Replies.Count, StringFormat='{}{0} replies'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Repliers}"
                                              ItemTemplate="{StaticResource ReplierTemplate}"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MessagesReplyCountTextBlock}"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding LastReplyTime, StringFormat='Last reply {0:HH:mm}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Replies.Count}"
                             Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Replies.Count}"
                             Value="1">
                    <Setter Property="AutomationProperties.Name" Value="1 reply" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Message -->

        <Style x:Key="MessagesLineBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="MessagesNewLineBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource MessagesLineBorder}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="MessagesDateLabelBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="MessagesNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MessagesTimeTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MessagesHoverTimeTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="MessagesMessageTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MessagesAttachmentBorder"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="12,8,16,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="MessagesAttachmentIconTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="MessagesAttachmentNameTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MessagesAttachmentSizeTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MessagesSeparatorGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,12,16,6" />
        </Style>

        <Style x:Key="MessagesDateTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MessagesNewTextBlock"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MessagesDateTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="MessagesRowGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="MessagesBodyGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,6,16,2" />
        </Style>

        <Style x:Key="MessagesAvatarPresenter"
               TargetType="{x:Type ContentPresenter}">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <DataTemplate DataType="{x:Type sample:Attachment}">
            <Border Style="{StaticResource MessagesAttachmentBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MessagesAttachmentIconTextBlock}"
                               Text="&#xEA90;" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MessagesAttachmentNameTextBlock}"
                                   Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource MessagesAttachmentSizeTextBlock}"
                                   Text="{Binding Kilobytes, StringFormat='PDF document · {0} KB'}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MessageContentTemplate"
                      DataType="{x:Type sample:Message}">
            <StackPanel>
                <TextBlock Style="{StaticResource MessagesMessageTextBlock}"
                           Text="{Binding Text}" />
                <ContentControl Focusable="False"
                                Content="{Binding Attachment}" />
                <ItemsControl Style="{StaticResource MessagesReactionsItemsControl}"
                              ItemsSource="{Binding Reactions}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MessageTemplate"
                      DataType="{x:Type sample:Message}">
            <StackPanel>
                <Grid x:Name="DateSeparator"
                      Style="{StaticResource MessagesSeparatorGrid}"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource MessagesLineBorder}" />
                    <Border Grid.Column="1"
                            Style="{StaticResource MessagesDateLabelBorder}">
                        <TextBlock x:Name="DateText"
                                   Style="{StaticResource MessagesDateTextBlock}"
                                   Text="Yesterday" />
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource MessagesLineBorder}" />
                </Grid>
                <Grid x:Name="NewSeparator"
                      Style="{StaticResource MessagesSeparatorGrid}"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource MessagesNewLineBorder}" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource MessagesNewTextBlock}"
                               Text="New" />
                </Grid>
                <Grid x:Name="Row"
                      Style="{StaticResource MessagesRowGrid}">
                    <Grid x:Name="Body"
                          Style="{StaticResource MessagesBodyGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Avatar"
                                          Grid.Column="0"
                                          Style="{StaticResource MessagesAvatarPresenter}"
                                          Content="{Binding Author}"
                                          ContentTemplate="{StaticResource AvatarTemplate}" />
                        <TextBlock x:Name="HoverTime"
                                   Grid.Column="0"
                                   Style="{StaticResource MessagesHoverTimeTextBlock}"
                                   Text="{Binding Time, StringFormat=HH:mm}" />
                        <StackPanel Grid.Column="2">
                            <StackPanel x:Name="Header"
                                        Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MessagesNameTextBlock}"
                                           Text="{Binding Author.Name}" />
                                <TextBlock Style="{StaticResource MessagesTimeTextBlock}"
                                           Text="{Binding Time, StringFormat=HH:mm}" />
                            </StackPanel>
                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource MessageContentTemplate}" />
                            <Button Style="{StaticResource MessagesReplySummaryButton}"
                                    Command="{Binding DataContext.OpenThreadCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="Actions"
                            Style="{StaticResource MessagesActionsBorder}">
                        <StackPanel Orientation="Horizontal">
                            <controls:DropDownButton x:Name="AddReaction"
                                                     Style="{StaticResource MessagesAddReactionDropDownButton}"
                                                     ContextMenu="{StaticResource ReactionMenu}" />
                            <Button Style="{StaticResource MessagesSubtleIconButton}"
                                    Command="{Binding DataContext.OpenThreadCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Content="&#xE97A;"
                                    ToolTip="Reply in thread"
                                    AutomationProperties.Name="Reply in thread" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StartsDay}"
                             Value="True">
                    <Setter TargetName="DateSeparator" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}"
                             Value="True">
                    <Setter TargetName="DateText" Property="Text" Value="Today" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFirstUnread}"
                             Value="True">
                    <Setter TargetName="NewSeparator" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsContinuation}" Value="True" />
                        <Condition Binding="{Binding IsFirstUnread}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Body" Property="Margin" Value="16,0,16,2" />
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True" SourceName="Row">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=AddReaction, FallbackValue=False}"
                             Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding Visibility, ElementName=Avatar}" Value="Collapsed" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HoverTime" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ThreadRootTemplate"
                      DataType="{x:Type sample:Message}">
            <Grid x:Name="Row"
                  Style="{StaticResource MessagesRowGrid}">
                <Grid Style="{StaticResource MessagesBodyGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Style="{StaticResource MessagesAvatarPresenter}"
                                      Content="{Binding Author}"
                                      ContentTemplate="{StaticResource AvatarTemplate}" />
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MessagesNameTextBlock}"
                                       Text="{Binding Author.Name}" />
                            <TextBlock Style="{StaticResource MessagesTimeTextBlock}"
                                       Text="{Binding Time, StringFormat=HH:mm}" />
                        </StackPanel>
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{StaticResource MessageContentTemplate}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="Actions"
                        Style="{StaticResource MessagesActionsBorder}">
                    <controls:DropDownButton x:Name="AddReaction"
                                             Style="{StaticResource MessagesAddReactionDropDownButton}"
                                             ContextMenu="{StaticResource ReactionMenu}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True" SourceName="Row">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=AddReaction, FallbackValue=False}"
                             Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ReplyTemplate"
                      DataType="{x:Type sample:Message}">
            <Grid x:Name="Row"
                  Style="{StaticResource MessagesRowGrid}">
                <Grid x:Name="Body"
                      Style="{StaticResource MessagesBodyGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Avatar"
                                      Grid.Column="0"
                                      Style="{StaticResource MessagesAvatarPresenter}"
                                      Content="{Binding Author}"
                                      ContentTemplate="{StaticResource AvatarTemplate}" />
                    <TextBlock x:Name="HoverTime"
                               Grid.Column="0"
                               Style="{StaticResource MessagesHoverTimeTextBlock}"
                               Text="{Binding Time, StringFormat=HH:mm}" />
                    <StackPanel Grid.Column="2">
                        <StackPanel x:Name="Header"
                                    Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MessagesNameTextBlock}"
                                       Text="{Binding Author.Name}" />
                            <TextBlock Style="{StaticResource MessagesTimeTextBlock}"
                                       Text="{Binding Time, StringFormat=HH:mm}" />
                        </StackPanel>
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{StaticResource MessageContentTemplate}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="Actions"
                        Style="{StaticResource MessagesActionsBorder}">
                    <controls:DropDownButton x:Name="AddReaction"
                                             Style="{StaticResource MessagesAddReactionDropDownButton}"
                                             ContextMenu="{StaticResource ReactionMenu}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsContinuation}"
                             Value="True">
                    <Setter TargetName="Body" Property="Margin" Value="16,0,16,2" />
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True" SourceName="Row">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=AddReaction, FallbackValue=False}"
                             Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding IsContinuation}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HoverTime" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Composer -->

        <Style x:Key="MessagesComposerTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MaxHeight" Value="120" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="MessagesMessageComposerTextBox"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource MessagesComposerTextBox}"
               d:DataContext="{d:DesignInstance Type={x:Type module:MessagesViewModel}}">
            <Setter Property="behaviors:TextBoxOption.PlaceholderText" Value="{Binding Selected.Name, StringFormat='Message #{0}', FallbackValue=''}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Kind, FallbackValue=Channel}"
                             Value="Direct">
                    <Setter Property="behaviors:TextBoxOption.PlaceholderText" Value="{Binding Selected.Name, StringFormat='Message {0}', FallbackValue=''}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessagesComposerGrid"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="16,8,16,16" />
        </Style>

        <Style x:Key="MessagesSendButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AccentButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

    </UserControl.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleTextBlock}"
                   Text="Messages" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageDescriptionTextBlock}"
                   Text="Channels, threads and reactions like a chat app." />

        <Border x:Name="Card"
                Grid.Row="2"
                Style="{StaticResource MessagesCardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Conversations -->
                <Border Grid.Column="0"
                        Style="{StaticResource MessagesListPaneBorder}">
                    <ListBox Style="{StaticResource MessagesConversationListBox}"
                             ItemsSource="{Binding Source={StaticResource ConversationSource}}"
                             ItemTemplate="{StaticResource ConversationTemplate}"
                             SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Conversations"
                             ItemContainerStyle="{StaticResource MessagesConversationListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource MessagesGroupItem}"
                                        HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                        </ListBox.GroupStyle>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1">

                    <!-- Messages -->
                    <Grid Style="{StaticResource MessagesMainPaneGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource MessagesHeaderBorder}">
                            <ContentPresenter Style="{StaticResource MessagesHeaderPresenter}"
                                              Content="{Binding Selected}"
                                              ContentTemplate="{StaticResource ConversationHeaderTemplate}" />
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource PaneScroll}"
                                      AutomationProperties.Name="Messages">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <i:CallMethodAction MethodName="ScrollToEnd" />
                                </i:EventTrigger>
                                <s:EventRequestTrigger Request="{Binding ScrollRequest}">
                                    <i:CallMethodAction MethodName="ScrollToEnd" />
                                </s:EventRequestTrigger>
                            </i:Interaction.Triggers>
                            <ItemsControl Style="{StaticResource MessagesMessageItemsControl}"
                                          ItemsSource="{Binding Selected.Messages, FallbackValue={x:Null}}"
                                          ItemTemplate="{StaticResource MessageTemplate}"
                                          Focusable="False" />
                        </ScrollViewer>
                        <Grid Grid.Row="2"
                              Style="{StaticResource MessagesComposerGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource MessagesMessageComposerTextBox}"
                                     Text="{Binding Selected.Draft, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                     AutomationProperties.Name="Message">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Style="{StaticResource MessagesSendButton}"
                                    Command="{Binding SendCommand}"
                                    Focusable="False"
                                    Content="&#xE724;"
                                    ToolTip="Send"
                                    AutomationProperties.Name="Send" />
                        </Grid>
                    </Grid>

                    <!-- Thread -->
                    <Border Style="{StaticResource MessagesThreadPaneBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Style="{StaticResource MessagesHeaderBorder}">
                                <Grid>
                                    <StackPanel Style="{StaticResource MessagesThreadTitleStack}">
                                        <TextBlock Style="{StaticResource MessagesHeaderTitleTextBlock}"
                                                   Text="Thread" />
                                        <ContentPresenter Content="{Binding Selected}"
                                                          ContentTemplate="{StaticResource ThreadCaptionTemplate}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource MessagesCloseThreadButton}"
                                            Command="{Binding CloseThreadCommand}"
                                            Content="&#xE711;"
                                            ToolTip="Close thread"
                                            AutomationProperties.Name="Close thread" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          Style="{StaticResource PaneScroll}"
                                          AutomationProperties.Name="Thread">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Loaded">
                                        <i:CallMethodAction MethodName="ScrollToEnd" />
                                    </i:EventTrigger>
                                    <s:EventRequestTrigger Request="{Binding ThreadScrollRequest}">
                                        <i:CallMethodAction MethodName="ScrollToEnd" />
                                    </s:EventRequestTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel Style="{StaticResource MessagesThreadStack}">
                                    <ContentPresenter Content="{Binding Thread}"
                                                      ContentTemplate="{StaticResource ThreadRootTemplate}" />
                                    <Grid DataContext="{Binding Thread}"
                                          Style="{StaticResource MessagesThreadRepliesGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource MessagesThreadReplyCountTextBlock}" />
                                        <Border Grid.Column="2"
                                                Style="{StaticResource MessagesLineBorder}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Thread.Replies, FallbackValue={x:Null}}"
                                                  ItemTemplate="{StaticResource ReplyTemplate}"
                                                  Focusable="False" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2"
                                  Style="{StaticResource MessagesComposerGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource MessagesComposerTextBox}"
                                         behaviors:TextBoxOption.PlaceholderText="Reply…"
                                         Text="{Binding ReplyDraft, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Reply">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ReplyCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Style="{StaticResource MessagesSendButton}"
                                        Command="{Binding ReplyCommand}"
                                        Focusable="False"
                                        Content="&#xE724;"
                                        ToolTip="Send reply"
                                        AutomationProperties.Name="Send reply" />
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>

    </Grid>

</UserControl>
