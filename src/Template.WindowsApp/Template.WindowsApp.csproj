<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Template.WindowsApp.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.10.0" />
    <PackageReference Include="BunnyTail.XamlProperty.Wpf" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Rester" Version="2.17.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="System.Reactive.Wpf" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.20.0" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.0.0-beta14" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.17.0" />
    <PackageReference Include="Usa.Smart.Navigation" Version="3.17.0" />
    <PackageReference Include="Usa.Smart.Navigation.Extensions.DependencyInjection" Version="3.17.0" />
    <PackageReference Include="Usa.Smart.Navigation.Windows" Version="3.17.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
    <PackageReference Include="Usa.Smart.Windows" Version="2.34.0" />
    <PackageReference Include="Usa.Smart.Windows.Extensions" Version="2.34.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="App.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Models\Sample\Icons.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
    <Content Include="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
