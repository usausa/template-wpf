<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Template.WindowsApp.Behaviors"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls">

    <!-- ================================================================================ -->
    <!-- Caption button -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:CaptionButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CaptionButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Overlay"
                                Background="{TemplateBinding Foreground}"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsNonClientMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                        </Trigger>
                        <Trigger Property="IsNonClientPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton"
           TargetType="{x:Type controls:CaptionButton}"
           BasedOn="{StaticResource {x:Type controls:CaptionButton}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CaptionButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E6C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================================ -->
    <!-- InfoBar -->
    <!-- ================================================================================ -->

    <Style x:Key="InfoBarCloseButton"
           TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center">
                                <TextBlock x:Name="IconBackground"
                                           Text="&#xF136;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="16"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                                <TextBlock x:Name="IconGlyph"
                                           Text="&#xF13F;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Margin="12,13,12,13"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="14">
                                <Run Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                     FontWeight="SemiBold" />
                                <Run Text=" " />
                                <Run Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" />
                            </TextBlock>
                            <ContentPresenter x:Name="ActionPresenter"
                                              Grid.Column="2"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding ActionButton}" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="3"
                                    Style="{StaticResource InfoBarCloseButton}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Content="&#xE711;"
                                    ToolTip="Close"
                                    AutomationProperties.Name="Close" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13E;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13C;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13D;" />
                        </Trigger>
                        <Trigger Property="ActionButton" Value="{x:Null}">
                            <Setter TargetName="ActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================================ -->
    <!-- Window -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:AppWindow}">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CornerRadius="0"
                              CaptionHeight="48" GlassFrameThickness="0,0,0,1" NonClientFrameEdges="None" ResizeBorderThickness="6"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppWindow}">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <controls:TitleBarPanel x:Name="TitleBar"
                                                    Grid.Row="0"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding LeftHeader}"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                    <Image x:Name="IconImage"
                                           Width="16" Height="16"
                                           Margin="16,0,0,0"
                                           Source="{TemplateBinding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </StackPanel>

                                <TextBlock x:Name="TitleText"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Title}"
                                           FontSize="12" />

                                <ContentPresenter x:Name="TitleBarContentPresenter"
                                                  Margin="16,0,16,0"
                                                  Content="{TemplateBinding TitleBarContent}"
                                                  WindowChrome.IsHitTestVisibleInChrome="True" />

                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding RightHeader}"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                    <StackPanel x:Name="PART_CaptionButtons"
                                                Orientation="Horizontal">
                                        <controls:CaptionButton x:Name="PART_MinimizeButton"
                                                                Content="&#xE921;"
                                                                ToolTip="Minimize"
                                                                AutomationProperties.Name="Minimize" />
                                        <controls:CaptionButton x:Name="PART_MaximizeButton"
                                                                Content="&#xE922;"
                                                                AutomationProperties.Name="Maximize" />
                                        <controls:CaptionButton x:Name="PART_CloseButton"
                                                                Style="{StaticResource CloseCaptionButton}"
                                                                Content="&#xE8BB;"
                                                                ToolTip="Close"
                                                                AutomationProperties.Name="Close" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:TitleBarPanel>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>

                            <ResizeGrip x:Name="WindowResizeGrip"
                                        Grid.Row="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="Collapsed"
                                        IsTabStop="False"
                                        WindowChrome.ResizeGripDirection="BottomRight" />

                            <Grid x:Name="OverlayRoot"
                                  Grid.Row="0" Grid.RowSpan="2"
                                  KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle x:Name="PART_OverlayTitleBar"
                                           Grid.Row="0"
                                           Fill="{DynamicResource ContentDialogSmokeFill}" />
                                <Rectangle Grid.Row="1"
                                           Fill="{DynamicResource ContentDialogSmokeFill}" />
                                <ContentPresenter Grid.Row="0" Grid.RowSpan="2"
                                                  Content="{TemplateBinding OverlayContent}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleBar" Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                            <Setter TargetName="TitleBar" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleText" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="ShowIconOnTitleBar" Value="False">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleText" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="LeftHeader" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Margin" Value="16,0,0,0" />
                        </Trigger>
                        <Trigger Property="TitleBarContent" Value="{x:Null}">
                            <Setter TargetName="TitleBarContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="OverlayContent" Value="{x:Null}">
                            <Setter TargetName="OverlayRoot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="RootBorder" Property="Padding" Value="8" />
                            <Setter TargetName="PART_MaximizeButton" Property="AutomationProperties.Name" Value="Restore" />
                            <Setter TargetName="PART_MaximizeButton" Property="Content" Value="&#xE923;" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Number box -->
    <!-- ================================================================================ -->

    <Style x:Key="NumberBoxSpinButton"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource TextControlButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextControlButtonBackgroundPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextControlButtonBackgroundPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:NumberBox}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NumberBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                                 Style="{DynamicResource DefaultTextBoxBaseStyle}"
                                 Padding="10,5,70,6"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                 InputMethod.IsInputMethodEnabled="False" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,1,1,2"
                                    HorizontalAlignment="Right">
                            <RepeatButton x:Name="PART_UpButton"
                                          Style="{StaticResource NumberBoxSpinButton}"
                                          Content="&#xE70E;"
                                          AutomationProperties.Name="Increase" />
                            <RepeatButton x:Name="PART_DownButton"
                                          Style="{StaticResource NumberBoxSpinButton}"
                                          Content="&#xE70D;"
                                          AutomationProperties.Name="Decrease" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Toggle switch -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForeground}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Off">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Curtain" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-44" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="38" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Curtain" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="OffContentPresenter"
                                          Grid.Column="0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Content="{TemplateBinding OffContent}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter x:Name="OnContentPresenter"
                                          Grid.Column="0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Visibility="Hidden"
                                          Content="{TemplateBinding OnContent}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Grid Grid.Column="2"
                              Width="50" Height="19"
                              VerticalAlignment="Center">
                            <Border x:Name="OuterBorder"
                                    BorderBrush="{DynamicResource ToggleSwitchStrokeOff}"
                                    BorderThickness="2">
                                <Border x:Name="InnerBorder"
                                        Margin="1"
                                        Background="{DynamicResource ToggleSwitchFillOff}"
                                        ClipToBounds="True">
                                    <Rectangle x:Name="Curtain"
                                               Width="44"
                                               HorizontalAlignment="Left"
                                               Fill="{DynamicResource ToggleSwitchFillOn}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="-44" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                            </Border>
                            <Grid x:Name="Knob"
                                  Width="12"
                                  HorizontalAlignment="Left">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Rectangle Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                <Rectangle x:Name="KnobFill"
                                           Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OffContentPresenter" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="OnContentPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
                            <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                            <Setter TargetName="Curtain" Property="Fill" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                            <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                            <Setter TargetName="Curtain" Property="Fill" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                            <Setter TargetName="KnobFill" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Drop-down button -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:DropDownButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DropDownButton}">
                    <Button x:Name="PART_Button"
                            AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="&#xE96E;"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="8" />
                        </StackPanel>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Split button -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:SplitButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SplitButton}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PART_PrimaryButton"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                Content="{TemplateBinding Content}"
                                AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <Button x:Name="PART_SecondaryButton"
                                Width="35" MinWidth="0"
                                Margin="-1,0,0,0" Padding="0"
                                VerticalAlignment="Stretch"
                                Content="&#xE96E;"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="8"
                                AutomationProperties.Name="More options" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Time picker -->
    <!-- ================================================================================ -->

    <Style x:Key="TimePickerToggleButton"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource TimePickerButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource TimePickerButtonBackgroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource TimePickerButtonBackgroundPressed}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TimePickerButtonBorderBrushPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource TimePickerButtonBackgroundDisabled}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TimePickerButtonBorderBrushDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TimePickerFlyoutButton"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TimePickerColumn}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimePickerColumn}">
                    <ItemsControl ItemsSource="{TemplateBinding Rows}"
                                  Focusable="False"
                                  Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type controls:TimePickerRow}">
                                <Border x:Name="Row"
                                        Height="40"
                                        Background="Transparent">
                                    <TextBlock x:Name="RowText"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Text}"
                                               FontSize="14" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                            <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TimePicker}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimePicker}">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Style="{StaticResource TimePickerToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_HourText"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="14" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="PART_MinuteText"
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="14" />
                            </Grid>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_ToggleButton}"
                               StaysOpen="False" VerticalOffset="4">
                            <Border Width="{Binding ActualWidth, ElementName=PART_ToggleButton}"
                                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                    BorderThickness="1"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="280" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                            Height="40"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <controls:TimePickerColumn x:Name="PART_HourColumn"
                                                               Grid.Row="0" Grid.Column="0" />
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <controls:TimePickerColumn x:Name="PART_MinuteColumn"
                                                               Grid.Row="0" Grid.Column="2" />
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Button x:Name="PART_AcceptButton"
                                            Grid.Row="2" Grid.Column="0"
                                            Style="{StaticResource TimePickerFlyoutButton}"
                                            Content="&#xE8FB;"
                                            ToolTip="Accept"
                                            AutomationProperties.Name="Accept" />
                                    <Button x:Name="PART_CancelButton"
                                            Grid.Row="2" Grid.Column="2"
                                            Style="{StaticResource TimePickerFlyoutButton}"
                                            Content="&#xE711;"
                                            ToolTip="Cancel"
                                            AutomationProperties.Name="Cancel" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedTime" Value="{x:Null}">
                            <Setter TargetName="PART_HourText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter TargetName="PART_MinuteText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_ToggleButton" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Content dialog -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:ContentDialog}">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="548" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ContentDialogBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ContentDialogForeground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ContentDialog}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Padding="16"
                                    Background="{DynamicResource ContentDialogTopOverlay}"
                                    BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               Text="{TemplateBinding Title}"
                                               FontSize="20" FontWeight="SemiBold" />
                                    <ContentPresenter />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1"
                                  Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition x:Name="SecondaryColumn"
                                                      Width="*" />
                                    <ColumnDefinition x:Name="SecondarySpacing"
                                                      Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PrimaryButton"
                                        Grid.Column="0"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Command="{TemplateBinding PrimaryButtonCommand}"
                                        Content="{TemplateBinding PrimaryButtonText}" />
                                <Button x:Name="SecondaryButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Command="{TemplateBinding SecondaryButtonCommand}"
                                        Content="{TemplateBinding SecondaryButtonText}" />
                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="4"
                                        HorizontalAlignment="Stretch"
                                        Command="{TemplateBinding CloseButtonCommand}"
                                        Content="{TemplateBinding CloseButtonText}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="PrimaryButtonText" Value="{x:Null}">
                            <Setter TargetName="PART_PrimaryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SecondaryButtonText" Value="{x:Null}">
                            <Setter TargetName="SecondaryButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SecondaryColumn" Property="Width" Value="0" />
                            <Setter TargetName="SecondarySpacing" Property="Width" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Settings card -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:SettingsCard}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsCard}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <DockPanel>
                            <ContentPresenter x:Name="ContentHost"
                                              DockPanel.Dock="Right"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center" />
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Left"
                                           Width="40"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{TemplateBinding HeaderIcon}"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="16" />
                                <StackPanel Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                                               behaviors:TextBlockOption.Runs="{TemplateBinding HeaderRuns}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DescriptionText"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               behaviors:TextBlockOption.Runs="{TemplateBinding DescriptionRuns}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ContentAlignment" Value="Vertical">
                            <Setter TargetName="ContentHost" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="ContentHost" Property="Margin" Value="48,12,0,0" />
                            <Setter TargetName="ContentHost" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMatch" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================================ -->
    <!-- Removable tag -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:RemovableTag}">
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RemovableTag}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{TemplateBinding Text}" />
                            <Button Style="{StaticResource InfoBarCloseButton}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    Command="{TemplateBinding RemoveCommand}"
                                    CommandParameter="{TemplateBinding RemoveCommandParameter}"
                                    Content="&#xE711;"
                                    FontSize="10"
                                    ToolTip="Remove"
                                    AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Remove {0}'}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Tab view -->
    <!-- ================================================================================ -->

    <Style x:Key="TabViewButton"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TabView}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabView}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="0,0,0,-1"
                              HorizontalAlignment="Left"
                              Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <controls:TabStripPanel x:Name="TabStrip"
                                                        AvailableWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ReservedWidth="40"
                                                        IsItemsHost="True" />
                            </ScrollViewer>
                            <Button x:Name="PART_AddButton"
                                    Grid.Column="1"
                                    Style="{StaticResource TabViewButton}"
                                    Width="36" Height="36"
                                    Margin="4,0,0,0"
                                    Command="{TemplateBinding AddTabButtonCommand}"
                                    Content="&#xE710;"
                                    ToolTip="New tab"
                                    AutomationProperties.Name="New tab" />
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabWidthMode" Value="Equal">
                            <Setter TargetName="TabStrip" Property="IsEqualWidth" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TabViewItem}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabViewItem}">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1,1,1,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlyphText"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Glyph}"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="14" />
                            <ContentPresenter x:Name="HeaderPresenter"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Style="{StaticResource TabViewButton}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    Focusable="False"
                                    Content="&#xE711;"
                                    FontSize="10"
                                    ToolTip="Close tab"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Close {0}'}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding CloseButtonOverlayMode, RelativeSource={RelativeSource AncestorType={x:Type controls:TabView}}}"
                                     Value="OnPointerOver">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TabWidthMode, RelativeSource={RelativeSource AncestorType={x:Type controls:TabView}}}" Value="Compact" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Padding" Value="12,0,12,0" />
                            <Setter TargetName="GlyphText" Property="Margin" Value="0" />
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Auto-suggest box -->
    <!-- ================================================================================ -->

    <Style x:Key="AutoSuggestBoxQueryButton"
           TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource TextControlButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextControlButtonBackgroundPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextControlButtonBackgroundPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextControlButtonForegroundPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AutoSuggestBoxItem"
           TargetType="{x:Type ListBoxItem}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Selection"
                                Visibility="Collapsed"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="Indicator"
                                Width="3" Height="16"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AutoSuggestBox}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AutoSuggestBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                                 Style="{DynamicResource DefaultTextBoxBaseStyle}"
                                 behaviors:TextBoxOption.PlaceholderText="{TemplateBinding PlaceholderText}"
                                 Padding="10,5,38,6"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <Button x:Name="PART_QueryButton"
                                Style="{StaticResource AutoSuggestBoxQueryButton}"
                                Margin="0,1,1,2"
                                HorizontalAlignment="Right"
                                Content="{TemplateBinding QueryIcon}"
                                AutomationProperties.Name="Search" />
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsSuggestionListOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               AllowsTransparency="True" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_TextBox}">
                            <Border Width="{Binding ActualWidth, ElementName=PART_TextBox}"
                                    Background="{DynamicResource FlyoutBackground}"
                                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="PART_SuggestionsList"
                                             MaxHeight="320"
                                             Padding="0"
                                             ItemsSource="{TemplateBinding ItemsSource}"
                                             ItemTemplate="{TemplateBinding ItemTemplate}"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource AutoSuggestBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <TextBlock x:Name="NoResults"
                                               Margin="12,8,12,8"
                                               Visibility="Collapsed"
                                               Text="{TemplateBinding NoResultsText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="QueryIcon" Value="{x:Null}">
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="10,5,6,6" />
                            <Setter TargetName="PART_QueryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False" SourceName="PART_SuggestionsList">
                            <Setter TargetName="PART_SuggestionsList" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NoResults" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
