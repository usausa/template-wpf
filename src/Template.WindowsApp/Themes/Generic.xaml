<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Template.WindowsApp.Controls">

    <!-- ================================================================================ -->
    <!-- Caption button -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:CaptionButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CaptionButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Overlay"
                                Background="{TemplateBinding Foreground}"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsNonClientMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                        </Trigger>
                        <Trigger Property="IsNonClientPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.375" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle"
           TargetType="{x:Type controls:CaptionButton}"
           BasedOn="{StaticResource {x:Type controls:CaptionButton}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CaptionButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E6C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================================ -->
    <!-- Window -->
    <!-- ================================================================================ -->

    <Style TargetType="{x:Type controls:AppWindow}">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CornerRadius="0"
                              CaptionHeight="48" GlassFrameThickness="0,0,0,1" NonClientFrameEdges="None" ResizeBorderThickness="6"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppWindow}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="TitleBar"
                                  Grid.Row="0"
                                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                                  TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="4,0,0,0"
                                                      Content="{TemplateBinding LeftHeader}"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                    <Image x:Name="IconImage"
                                           Grid.Column="1"
                                           Width="16" Height="16"
                                           Margin="12,0,0,0"
                                           Source="{TemplateBinding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Grid.Column="2"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{TemplateBinding Title}"
                                               FontSize="12" />
                                    <ContentPresenter Grid.Column="3"
                                                      Content="{TemplateBinding TitleBarContent}"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                    <ContentPresenter Grid.Column="5"
                                                      Content="{TemplateBinding RightHeader}"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <controls:CaptionButton x:Name="PART_MinimizeButton"
                                                            Content="&#xE921;"
                                                            ToolTip="Minimize"
                                                            AutomationProperties.Name="Minimize" />
                                    <controls:CaptionButton x:Name="PART_MaximizeButton"
                                                            Content="&#xE922;"
                                                            AutomationProperties.Name="Maximize" />
                                    <controls:CaptionButton x:Name="PART_CloseButton"
                                                            Style="{StaticResource CloseCaptionButtonStyle}"
                                                            Content="&#xE8BB;"
                                                            ToolTip="Close"
                                                            AutomationProperties.Name="Close" />
                                </StackPanel>
                            </Grid>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>

                            <ResizeGrip x:Name="WindowResizeGrip"
                                        Grid.Row="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="Collapsed"
                                        IsTabStop="False"
                                        WindowChrome.IsHitTestVisibleInChrome="True" WindowChrome.ResizeGripDirection="BottomRight" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleBar" Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                            <Setter TargetName="TitleBar" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeButton" Property="AutomationProperties.Name" Value="Restore" />
                            <Setter TargetName="PART_MaximizeButton" Property="Content" Value="&#xE923;" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
